<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>AssetSuite.Web</RootNamespace>
    <AssemblyName>AssetSuite.Web</AssemblyName>
    <InternalsVisibleTo>AssetSuite.IntegrationTests</InternalsVisibleTo>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AssetSuite.Infrastructure\AssetSuite.Infrastructure.csproj" />
    <ProjectReference Include="..\AssetSuite.Application\AssetSuite.Application.csproj" />
    <ProjectReference Include="..\AssetSuite.Domain\AssetSuite.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\src\AssetManagement.Web\Content\**\*" Link="wwwroot\legacy-content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
