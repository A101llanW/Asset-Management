@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    var tenantToken = ViewBag.TenantToken as string;
    var loginAction = string.IsNullOrWhiteSpace(tenantToken)
        ? Url.Action("Login", "Account")
        : "/" + tenantToken + "/Account/Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Asset Management Module</h1>
        @if (ViewBag.IsTenantPortal == true && ViewBag.OrganizationName != null)
        {
            <p class="text-muted">Sign in to <strong>@ViewBag.OrganizationName</strong></p>
        }
        <form action="@loginAction" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>
            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
        <p class="mt-3 small text-muted">
            Tenant URL example: <code>/nanosoft/Account/Login</code>
        </p>
    </div>
</div>
