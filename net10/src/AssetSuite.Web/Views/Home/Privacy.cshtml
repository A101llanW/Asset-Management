@{
    ViewData["Title"] = "Privacy";
}
<div class="py-3">
    <h1>Privacy Policy</h1>
    <p class="text-muted">@ViewBag.CompanyName — @ViewBag.PrivacyVersionLabel</p>
    <p>Last updated: @ViewBag.LastUpdated</p>
    <p>
        This read-only page is ported to ASP.NET Core (.NET 10) as the first end-to-end screen after login.
        Full legal copy remains served from the legacy MVC site until content is synchronized.
    </p>
    <p>Contact: <a href="mailto:@ViewBag.ContactEmail">@ViewBag.ContactEmail</a></p>
    <p>@ViewBag.ContactAddress</p>
</div>
