{
  "ConnectionStrings": {
    "AssetManagementConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AssetManagement;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AssetSuite": {
    "CookieName": ".ASPXAUTH",
    "LoginPath": "/Account/Login",
    "RequireSecureCookies": false,
    "MfaAllowAnyCode": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
