<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to smtp.secrets.config (gitignored) and fill in Gmail app password. -->
<appSettings>
  <add key="SmtpHost" value="smtp.gmail.com" />
  <add key="SmtpPort" value="587" />
  <add key="SmtpUser" value="you@example.com" />
  <add key="SmtpPassword" value="REPLACE_WITH_GMAIL_APP_PASSWORD" />
  <add key="SmtpEnableSsl" value="true" />
  <add key="FromEmail" value="you@example.com" />
  <add key="FromName" value="Asset Management Module" />
  <add key="ExternalBaseUrl" value="http://localhost:51901" />
</appSettings>
