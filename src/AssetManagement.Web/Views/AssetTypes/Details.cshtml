@model AssetManagement.Web.ViewModels.AssetTypeVm
@using System.Collections.Generic
@using AssetManagement.Application.ViewModels
@using AssetManagement.Web.Helpers
@{
    ViewBag.Title = "Asset Type Details";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var subTypes = ViewBag.SubTypes as IList<AssetSubTypeListItemVm> ?? new List<AssetSubTypeListItemVm>();
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = Model.Name,
    Subtitle = "Asset type setup and category dependency.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    PrimaryActionUrl = Url.Action("Edit", new { id = Model.Id, returnUrl = Request.RawUrl }),
    PrimaryActionLabel = "Edit Asset Type",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Asset Types", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = Model.Name }
    }
})
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card card-kpi h-100">
            <div class="card-header">Overview</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Category</dt>
                    <dd class="col-sm-7">@ViewBag.CategoryName</dd>
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7"><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(Model.IsActive) badge-status">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
                    <dt class="col-sm-5">Assets</dt>
                    <dd class="col-sm-7">@ViewBag.AssetCount</dd>
                    <dt class="col-sm-5">Useful life</dt>
                    <dd class="col-sm-7">
                        @if (Model.UseCustomUsefulLife && Model.UsefulLifeMonths.HasValue)
                        {
                            @:@(Model.UsefulLifeMonths) months (custom override)
                        }
                        else if (ViewBag.CategoryDefaultUsefulLifeMonths != null)
                        {
                            @:@ViewBag.CategoryDefaultUsefulLifeMonths months (from category)
                        }
                        else
                        {
                            @:Not set
                        }
                    </dd>
                    <dt class="col-sm-5">Depreciation life</dt>
                    <dd class="col-sm-7">
                        @if (Model.UseCustomDepreciationLife && Model.DepreciationLifeMonths.HasValue)
                        {
                            @:@(Model.DepreciationLifeMonths) months (type override)
                        }
                        else if (ViewBag.CategoryDefaultDepreciationLifeMonths != null)
                        {
                            @:@ViewBag.CategoryDefaultDepreciationLifeMonths months (from category)
                        }
                        else
                        {
                            @:Inherits useful life
                        }
                    </dd>
                    <dt class="col-sm-5">Depreciation rate</dt>
                    <dd class="col-sm-7">
                        @if (Model.UseCustomDepreciationRate && Model.DepreciationRatePercent.HasValue)
                        {
                            @:@(Model.DepreciationRatePercent)% per year (type override)
                        }
                        else if (ViewBag.CategoryDefaultDepreciationRatePercent != null)
                        {
                            @:@ViewBag.CategoryDefaultDepreciationRatePercent% per year (from category)
                        }
                        else
                        {
                            @:Derived from life
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card card-kpi mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Asset sub-types</span>
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Create", "AssetSubTypes", new { assetTypeId = Model.Id, returnUrl = Request.RawUrl })">Add sub-type</a>
            </div>
            <div class="card-body p-0">
                @if (subTypes.Count == 0)
                {
                    <p class="text-muted mb-0 p-3">No sub-types yet. Add one to group exact brand/model variants and drive stock counts.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="bg-light text-secondary small">
                                    <th class="ps-3">Name</th>
                                    <th>Brand</th>
                                    <th>Model</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subType in subTypes)
                                {
                                    <tr>
                                        <td class="ps-3 fw-medium">@subType.Name</td>
                                        <td>@subType.Brand</td>
                                        <td>@subType.Model</td>
                                        <td>@subType.StockCount</td>
                                        <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(subType.IsActive) badge-status">@(subType.IsActive ? "Active" : "Inactive")</span></td>
                                        <td class="text-end pe-3">
                                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", "AssetSubTypes", new { id = subType.Id, returnUrl = Request.RawUrl })">Edit</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="card card-kpi">
            <div class="card-header">Description</div>
            <div class="card-body">
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "No type description has been added yet." : Model.Description)</p>
            </div>
        </div>
    </div>
</div>
