@{
    ViewBag.Title = "Security file unavailable";
    ViewBag.ShowLoginBackground = true;
    ViewBag.AuthPortalTitle = "Asset Management Module";
    ViewBag.AuthPortalSubtitle = "This administrator security file cannot be opened.";
}

<div class="am-auth-container">
    <div class="am-auth-shell">
        <div class="am-portal-panel am-auth-panel">
            @Html.Partial("_AuthPortalBrand")

            <div class="alert alert-warning am-portal-alert mb-3" role="alert">
                This security file can no longer be decrypted. It was probably created before the
                system encryption key was rotated, or the link has been altered.
            </div>

            <p class="text-muted mb-4">
                Nothing was downloaded and the link has not been used up. Ask your platform administrator
                to issue a new administrator credential package.
            </p>

            <div class="d-grid gap-2">
                <a class="btn btn-primary" href="@Url.Action("Login", "Account")">Go to sign in</a>
            </div>
        </div>
    </div>
</div>