@model AssetManagement.Web.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
    ViewBag.ShowLoginBackground = true;
    var tenantToken = ViewBag.TenantToken as string;

    ViewBag.AuthPortalBadge = "Password recovery";
    ViewBag.AuthPortalTitle = "Reset password";
    ViewBag.AuthPortalSubtitle = "Choose a new password for your account.";
}

<div class="am-auth-container">
    <div class="am-auth-shell">
        <div class="am-portal-panel am-auth-panel">
            @Html.Partial("_AuthPortalBrand")

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger alert alert-danger am-portal-alert py-2 mb-3" })
                @Html.HiddenFor(m => m.Code)

                <div data-password-policy-root>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", autocomplete = "username", placeholder = "name@example.com", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFieldFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", data_password_policy_input = "true" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                        @Html.PasswordFieldFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", data_password_confirm_for = "true" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>

                    @Html.Partial("_PasswordPolicyRequirements")

                    <div class="am-password-policy am-password-policy--match mt-2" aria-live="polite">
                        <ul class="am-password-policy__list list-unstyled mb-0">
                            <li class="am-password-policy__item am-password-policy__item--pending" data-password-match-indicator>
                                <span class="am-password-policy__icon" aria-hidden="true"></span>
                                <span class="am-password-policy__label">Passwords match</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mt-3">Reset password</button>
            }

            <div class="am-auth-links mt-3 text-center">
                <a href="@(string.IsNullOrWhiteSpace(tenantToken) ? Url.RouteUrl("Default", new { controller = "Account", action = "Login" }) : Url.RouteUrl("Tenant", new { tenant = tenantToken, controller = "Account", action = "Login" }))" class="am-auth-link">Back to login</a>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/app/password-policy-indicator.js")"></script>
}
