@using AssetManagement.Domain.Enums
@using AssetManagement.Web.Helpers
@{
    var departments = ViewBag.Departments as System.Web.Mvc.SelectList;
    var searchUrl = ViewBag.CatalogAssetsSearchUrl as string ?? TenantUrlHelper.TenantRouteUrl(Url, "SearchCatalogAssets", "Suppliers");
}

@functions
{
    private static string FormatAssetStatusLabel(AssetStatus status)
    {
        return status.ToString()
            .Replace("AwaitingApproval", "Pending Approval")
            .Replace("InStore", "In Store");
    }
}

<div class="modal fade" id="catalogAssetPickerModal" tabindex="-1" aria-labelledby="catalogAssetPickerModalLabel" aria-hidden="true"
     data-am-catalog-asset-search-url="@searchUrl">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="catalogAssetPickerModalLabel">Select asset from register</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Pick an existing asset to pre-fill catalog item name, category, type, SKU, and unit price.</p>
                <form id="catalog-asset-picker-filters" class="card card-kpi border-0 shadow-sm mb-3">
                    <div class="card-body p-3">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-4">
                                <input type="text" class="form-control" id="catalog-asset-picker-search" name="search" placeholder="Search tag, name, serial..." />
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" id="catalog-asset-picker-department" name="departmentId">
                                    <option value="">All departments</option>
                                    @if (departments != null)
                                    {
                                        foreach (var item in departments)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select" id="catalog-asset-picker-status" name="assetStatus">
                                    <option value="">All statuses</option>
                                    @foreach (AssetStatus assetStatus in Enum.GetValues(typeof(AssetStatus)))
                                    {
                                        <option value="@((int)assetStatus)">@FormatAssetStatusLabel(assetStatus)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select" id="catalog-asset-picker-page-size" name="pageSize">
                                    <option value="10">10 per page</option>
                                    <option value="25">25 per page</option>
                                    <option value="50">50 per page</option>
                                </select>
                            </div>
                            <div class="col-md-1 d-grid">
                                <button type="submit" class="btn btn-primary">Apply</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div id="catalog-asset-picker-loading" class="text-center text-muted py-4" style="display:none;">Loading assets...</div>
                <div id="catalog-asset-picker-error" class="alert alert-warning" style="display:none;"></div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="catalog-asset-picker-table">
                        <thead>
                            <tr class="bg-light text-secondary" style="font-size: 0.82rem; letter-spacing: 0.04em;">
                                <th class="ps-3"><button type="button" class="btn btn-link btn-sm p-0 text-secondary text-decoration-none am-catalog-asset-sort" data-sort="tag">Asset Tag</button></th>
                                <th><button type="button" class="btn btn-link btn-sm p-0 text-secondary text-decoration-none am-catalog-asset-sort" data-sort="name">Name</button></th>
                                <th><button type="button" class="btn btn-link btn-sm p-0 text-secondary text-decoration-none am-catalog-asset-sort" data-sort="category">Category</button></th>
                                <th>Sub-type</th>
                                <th>Serial</th>
                                <th><button type="button" class="btn btn-link btn-sm p-0 text-secondary text-decoration-none am-catalog-asset-sort" data-sort="acquisition">Unit cost</button></th>
                                <th class="text-end pe-3"></th>
                            </tr>
                        </thead>
                        <tbody id="catalog-asset-picker-body"></tbody>
                    </table>
                </div>

                <div id="catalog-asset-picker-empty" class="text-center text-muted py-4" style="display:none;">
                    <h6 class="fw-bold text-dark mb-2">No assets match these filters</h6>
                    <p class="mb-0 small">Try adjusting the search or department filter.</p>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3" id="catalog-asset-picker-pagination" style="display:none;">
                    <div class="small text-muted" id="catalog-asset-picker-range"></div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="catalog-asset-picker-prev">Previous</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="catalog-asset-picker-next">Next</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
