@model AssetManagement.Web.ViewModels.AssetScanLookupPageVm

@{
    var lookup = Model.Lookup;
}

@if (lookup != null && lookup.Found && Model.Card != null)
{
    var card = Model.Card;
    @* rel1027: viewer-filtered card (AssetScanCardBuilder). Signed-out viewers never get e-mails, cost, supplier or insurance data. *@
    <div class="am-scan-result am-scan-card card card-kpi mt-4 am-fade-in border-0" data-am-scan-card="1">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
        {
            <div class="am-scan-card-photo">
                <img src="@Model.PhotoUrl" alt="Photo of @card.AssetName" loading="lazy" />
            </div>
        }
        <div class="am-scan-result-header">
            <div class="am-scan-result-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="am-scan-result-title-wrap">
                <h5 class="am-scan-result-name mb-0">@card.AssetName</h5>
                <span class="am-tag-pill am-tag-pill--sm mt-1">@card.AssetTag</span>
            </div>
            <span class="badge bg-@Model.StatusBadgeClass badge-status ms-auto">@card.StatusText</span>
        </div>

        <div class="am-scan-result-body">
            <dl class="am-scan-details-grid am-scan-card-grid">
                @foreach (var row in card.Rows)
                {
                    <div class="am-scan-detail-row" data-am-scan-row="@row.Key">
                        <dt>@row.Label</dt>
                        <dd>@row.Value</dd>
                    </div>
                }
            </dl>

            @if (card.RestrictedRows.Count > 0)
            {
                <div class="am-scan-card-restricted mt-3">
                    <div class="small text-muted mb-1">Visible to you because you are signed in with permission</div>
                    <dl class="am-scan-details-grid am-scan-card-grid mb-0">
                        @foreach (var row in card.RestrictedRows)
                        {
                            <div class="am-scan-detail-row" data-am-scan-row="@row.Key">
                                <dt>@row.Label</dt>
                                <dd>@row.Value</dd>
                            </div>
                        }
                    </dl>
                </div>
            }

            @if (Model.CanOpenQuickActions || Model.CanViewAssetDetails)
            {
                <div class="am-scan-result-actions mt-4">
                    @if (Model.CanViewAssetDetails)
                    {
                        <a class="btn btn-primary btn-lg w-100" href="@Model.DetailsUrl" data-am-scan-details-link="1">View full details</a>
                    }
                    @if (Model.CanOpenQuickActions)
                    {
                        <a class="btn @(Model.CanViewAssetDetails ? "btn-outline-secondary w-100 mt-2" : "btn-primary btn-lg w-100")" href="@Model.QuickActionsUrl">Quick actions</a>
                    }
                </div>
            }
            else if (Model.OutsideYourDepartments)
            {
                <p class="am-scan-card-signin small text-muted mt-3 mb-0" data-am-scan-outside-scope="1">This asset is outside your departments, so only the public details are shown.</p>
            }
            else if (!Request.IsAuthenticated)
            {
                <p class="am-scan-card-signin small text-muted mt-3 mb-0">Staff: sign in to see full details and actions for this asset.</p>
            }
        </div>
    </div>
}
else if (lookup != null && !string.IsNullOrWhiteSpace(lookup.Message) && !string.IsNullOrWhiteSpace(Model.InitialCode))
{
    <div class="am-scan-no-result mt-4 am-fade-in">
        <div class="am-scan-no-result-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </div>
        <p class="am-scan-no-result-text">@lookup.Message</p>
        <p class="am-scan-no-result-hint">Try a different tag, serial number, custodian name, or department keyword.</p>
    </div>
}
