@model AssetManagement.Application.ViewModels.GlobalSearchResultVm
@using AssetManagement.Web.Helpers

@if (Model != null && Model.Assets != null && Model.Assets.Any())
{
    var canBatchPrint = ViewBag.CanBatchPrintLabels as bool? ?? false;
    <div class="card card-kpi border-0 shadow-sm mt-4 am-fade-in am-scan-search-results">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="text-muted small">
                @Model.TotalCount result(s) for <strong class="text-dark">"@Model.Query"</strong>
            </span>
            @if (canBatchPrint)
            {
                <span class="text-muted small">Select rows to add them to the print queue below.</span>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="bg-light" style="font-size:0.82rem;letter-spacing:0.04em;">
                            @if (canBatchPrint)
                            {
                                <th class="ps-3" style="width:2.5rem;"><span class="visually-hidden">Select</span></th>
                            }
                            <th class="@(canBatchPrint ? "" : "ps-3")">Tag</th>
                            <th>Name</th>
                            <th>Serial</th>
                            <th>Department</th>
                            <th>Custodian</th>
                            <th>Status</th>
                            <th>Matched on</th>
                            <th class="pe-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var hit in Model.Assets)
                    {
                        var zplUrl = canBatchPrint
                            ? Url.Action("LabelZpl", "Assets", new { id = hit.AssetId })
                            : null;
                        <tr class="border-bottom border-light">
                            @if (canBatchPrint)
                            {
                                <td class="ps-3">
                                    <input type="checkbox" class="form-check-input"
                                           value="@hit.AssetId"
                                           data-am-scan-search-id="@hit.AssetId"
                                           data-am-scan-search-tag="@hit.AssetTag"
                                           data-am-scan-search-name="@hit.AssetName"
                                           data-am-scan-search-zpl="@zplUrl"
                                           aria-label="Queue @hit.AssetTag for printing" />
                                </td>
                            }
                            <td class="@(canBatchPrint ? "" : "ps-3")"><span class="am-tag-pill am-tag-pill--sm">@hit.AssetTag</span></td>
                            <td class="fw-semibold text-dark">@hit.AssetName</td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(hit.SerialNumber) ? DisplayText.Empty : hit.SerialNumber)</td>
                            <td class="text-muted small">@hit.DepartmentName</td>
                            <td class="text-muted small">@hit.CustodianName</td>
                            <td><span class="badge rounded-pill bg-light border text-secondary">@hit.Status</span></td>
                            <td class="small text-muted">
                                <span style="background:hsla(200,85%,52%,.10);color:var(--am-primary-strong);padding:.15rem .5rem;border-radius:999px;font-size:.78rem;font-weight:600;">@hit.MatchReason</span>
                            </td>
                            <td class="text-end pe-3">
                                @if (canBatchPrint)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            data-am-scan-search-add="@hit.AssetId"
                                            data-am-scan-search-tag="@hit.AssetTag"
                                            data-am-scan-search-name="@hit.AssetName"
                                            data-am-scan-search-zpl="@zplUrl">Queue</button>
                                }
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", "Assets", new { id = hit.AssetId })">Open</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
