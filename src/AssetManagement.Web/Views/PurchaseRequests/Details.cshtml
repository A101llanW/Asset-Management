@model AssetManagement.Application.ViewModels.PurchaseRequestDetailVm
@using AssetManagement.Web.Helpers
@{
    ViewBag.Title = "Requisition " + Model.RequestNumber;
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var approvalSummary = ViewBag.PurchaseApprovalSummary as string;
    var canApprove = Model.CanCurrentUserApprove && Html.HasPermission("Purchases.Approve");
    // rel1009i: several POs per requisition, capped by the requisition quantity (summed over its POs).
    var orderSummary = ViewBag.OrderSummary as AssetManagement.Application.ViewModels.RequisitionOrderSummaryVm;
    var outstandingToOrder = orderSummary == null ? (Model.HasPurchaseRecord ? 0 : 1) : orderSummary.OutstandingToOrder;
    var canCreatePo = Model.IsApproved && outstandingToOrder > 0 && Html.HasPermission("Purchases.Create") && Model.CanCurrentUserRaisePurchaseOrder;
    var poBlockedForMe = Model.IsApproved && outstandingToOrder > 0 && !Model.CanCurrentUserRaisePurchaseOrder;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = Model.RequestNumber,
    Subtitle = "Requisition and approval status.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Purchases", Url = Url.Action("Index", "Purchases") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Requisitions", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = Model.RequestNumber }
    }
})

@if (!string.IsNullOrWhiteSpace(approvalSummary))
{
    <div class="alert alert-light border mb-3"><strong>Configured approval path:</strong> @approvalSummary</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card card-kpi h-100">
            <div class="card-header">Request</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">@Model.ApprovalStatus</span></dd>
                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.DepartmentName) ? DisplayText.Empty : Model.DepartmentName)</dd>
                    <dt class="col-sm-4">Submitted by</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.RequestedByName) ? Model.RequestedById : Model.RequestedByName)</dd>
                    @if (Model.LineItems != null && Model.LineItems.Count > 1)
                    {
                        <dt class="col-sm-4">Items</dt>
                        <dd class="col-sm-8">
                            <ul class="mb-0 ps-3">
                                @foreach (var line in Model.LineItems)
                                {
                                    <li>@line.Description <span class="text-muted">(qty @line.Quantity)</span></li>
                                }
                            </ul>
                        </dd>
                    }
                    else
                    {
                        <dt class="col-sm-4">Item</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ItemDescription) ? DisplayText.Empty : Model.ItemDescription)</dd>
                    }
                    @if (Model.TargetAssetId.HasValue)
                    {
                        <dt class="col-sm-4">Tagged asset</dt>
                        <dd class="col-sm-8">
                            <a href="@Url.Action("Details", "Assets", new { id = Model.TargetAssetId })">
                                @(string.IsNullOrWhiteSpace(Model.TargetAssetTag)
                                    ? (string.IsNullOrWhiteSpace(Model.TargetAssetName) ? "View asset" : Model.TargetAssetName)
                                    : Model.TargetAssetTag + (string.IsNullOrWhiteSpace(Model.TargetAssetName) ? "" : " - " + Model.TargetAssetName))</a>
                        </dd>
                    }
                    @if (Model.TargetAssetId.HasValue)
                    {
                        <dt class="col-sm-4">Qty in stock</dt>
                        <dd class="col-sm-8">@(Model.QuantityInStock.HasValue ? Model.QuantityInStock.Value.ToString() : DisplayText.Empty)</dd>
                    }
                    <dt class="col-sm-4">Qty to order</dt>
                    <dd class="col-sm-8">@Model.Quantity</dd>
                    @if (Model.RequiredDate.HasValue)
                    {
                        <dt class="col-sm-4">Required by</dt>
                        <dd class="col-sm-8">@Model.RequiredDate.Value.ToString("yyyy-MM-dd")</dd>
                    }
                    <dt class="col-sm-4">Submitted</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                    @if (Model.ApprovedAt.HasValue)
                    {
                        <dt class="col-sm-4">Approved</dt>
                        <dd class="col-sm-8">@Model.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                    }
                </dl>
                <div class="mt-3">
                    <div class="text-muted small">Justification</div>
                    <p class="mb-0">@Model.Justification</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-2">
                        <div class="text-muted small">Notes</div>
                        <p class="mb-0">@Model.Notes</p>
                    </div>
                }
                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button type="button"
                            class="btn btn-sm btn-primary"
                            id="amDownloadRequisitionPdf"
                            data-url="@Url.Action("DocumentFragment", new { id = Model.Id })">
                        Download requisition (PDF)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-kpi h-100">
            <div class="card-header">Actions</div>
            <div class="card-body">
                @if (Model.IsPending)
                {
                    <p class="mb-2"><strong>Current stage:</strong> Stage @Model.CurrentApprovalStage - @(string.IsNullOrWhiteSpace(Model.CurrentStageRoleName) ? DisplayText.Empty : Model.CurrentStageRoleName)</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PurchaseOrderRaiserLabel))
                {
                    <p class="mb-2" id="po-raiser-info"><strong>Purchase order raised by:</strong> @Model.PurchaseOrderRaiserLabel</p>
                }
                @if (canCreatePo)
                {
                    <a class="btn btn-primary mb-3" id="record-purchase-order-btn" href="@Url.Action("Create", "Purchases", new { purchaseRequestId = Model.Id, returnUrl = Request.RawUrl })">Record purchase order</a>
                }
                else if (poBlockedForMe)
                {
                    <p class="text-muted mb-3" id="po-raiser-blocked">Ready for purchase order. Only @Model.PurchaseOrderRaiserLabel can record it.</p>
                }
                @if (orderSummary != null && (orderSummary.Orders.Count > 0 || Model.IsApproved))
                {
                    <div id="requisition-purchase-orders" class="mb-3">
                        <p class="mb-1"><strong>Purchase orders:</strong> @orderSummary.Orders.Count
                            &middot; ordered @orderSummary.OrderedQuantity of @orderSummary.RequisitionQuantity
                            &middot; received @orderSummary.ReceivedQuantity
                            &middot; <span class="badge bg-light text-dark border" id="requisition-fulfilment-status">@orderSummary.FulfilmentStatus</span></p>
                        @if (orderSummary.IsOverOrdered)
                        {
                            <div class="alert alert-warning py-2 small mb-2" id="requisition-over-ordered">
                                <strong>Over-ordered:</strong> @orderSummary.OrderedQuantity on order against @orderSummary.RequisitionQuantity requested (@orderSummary.OverOrderedBy more than requested).
                            </div>
                        }
                        @if (orderSummary.Orders.Any(x => x.Received < x.Quantity) && Html.HasPermission("Assets.Receive"))
                        {
                            <a class="btn btn-sm btn-primary mb-2" id="requisition-receive-goods" href="@Url.Action("ReceiveForRequisition", "Purchases", new { purchaseRequestId = Model.Id, returnUrl = Request.RawUrl })">Receive goods</a>
                        }
                        @if (orderSummary.Orders.Count > 0)
                        {
                            <table class="table table-sm mb-0">
                                <thead><tr><th>PO</th><th>Supplier</th><th class="text-end">Qty</th><th class="text-end">Received</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var order in orderSummary.Orders)
                                {
                                    <tr>
                                        <td><a href="@Url.Action("Details", "Purchases", new { id = order.PurchaseRecordId, returnUrl = Request.RawUrl })">@(string.IsNullOrWhiteSpace(order.PurchaseOrderNumber) ? ("#" + order.PurchaseRecordId) : order.PurchaseOrderNumber)</a></td>
                                        <td>@(string.IsNullOrWhiteSpace(order.SupplierName) ? DisplayText.Empty : order.SupplierName)</td>
                                        <td class="text-end">@order.Quantity</td>
                                        <td class="text-end">@order.Received</td>
                                        <td>@order.Status</td>
                                        <td>
                                            @if (order.Received < order.Quantity && Html.HasPermission("Assets.Receive"))
                                            {
                                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Receive", "Purchases", new { id = order.PurchaseRecordId, returnUrl = Request.RawUrl })">Receive</a>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                    </div>
                }

                @if (Model.IsPending)
                {
                    ViewData["CanApprove"] = canApprove;
                    ViewData["ApproveAction"] = "Approve";
                    ViewData["RejectAction"] = "Reject";
                    ViewData["ApprovalController"] = "PurchaseRequests";
                    ViewData["ApprovalEntityId"] = Model.Id;
                    ViewData["ReturnUrl"] = Request.RawUrl;
                    @Html.Partial("_ApprovalActions")
                    if (!canApprove)
                    {
                        <p class="text-muted mb-0">You are not the current stage approver, or you submitted this request.</p>
                    }
                }
            </div>
        </div>
    </div>
</div>

@Html.Partial("_ApprovalHistory", Model.ApprovalHistory)

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/app/document-pdf.js")"></script>
    <script src="@Url.Content("~/Scripts/app/purchase-request-details.js")"></script>
}
