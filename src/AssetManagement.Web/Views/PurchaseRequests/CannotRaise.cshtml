@using AssetManagement.Web.Helpers
@{
    ViewBag.Title = "New requisition";
    var message = ViewBag.RequisitionRaiseBlockedMessage as string;
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "New requisition",
    Subtitle = "Requisitions are raised for your department and the rooms under it.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Purchases", Url = Url.Action("Index", "Purchases") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Requisitions", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "New requisition" }
    }
})

@* Allan 2026-11-02 (answer 1): no department and no Purchases.CreateForAnyDepartment = cannot raise; a clear message
   instead of a form the server would refuse. *@
<div class="card card-kpi">
    <div class="card-body">
        <div class="alert alert-warning mb-3" role="alert" data-am-req-raise-blocked="true">@message</div>
        <a class="btn btn-outline-secondary" href="@returnUrl">Back</a>
    </div>
</div>
