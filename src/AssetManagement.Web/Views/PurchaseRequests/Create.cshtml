@model AssetManagement.Application.ViewModels.PurchaseRequestCreateVm
@{
    ViewBag.Title = "New requisition";
    var departments = ViewBag.Departments as SelectList;
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var approvalSummary = ViewBag.PurchaseApprovalSummary as string;
    var lockDepartment = ViewBag.LockDepartment == true;
    var departmentName = ViewBag.DepartmentName as string;
    var selectedTargetAssetLabel = ViewBag.SelectedTargetAssetLabel as string ?? string.Empty;
    var requestingAs = ViewBag.RequestingAsDisplayName as string ?? "Current user";
    var previewApprovalUrl = ViewBag.PreviewApprovalPathUrl as string ?? string.Empty;
    var lineModels = Model.Lines ?? new List<AssetManagement.Application.ViewModels.PurchaseRequestLineCreateVm>();
    var lineCount = lineModels.Count > 0 ? lineModels.Count : 1;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "New requisition",
    Subtitle = "Describe what you need, why it is required, and where goods should be delivered. Approvers are configured under Settings &rarr; Approval Matrix.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Purchases", Url = Url.Action("Index", "Purchases") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Requisitions", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "New requisition" }
    }
})

<div class="alert alert-secondary py-2 mb-3" role="status">
    <span class="text-muted">Requesting as</span> <strong>@requestingAs</strong>
</div>

<div class="alert alert-light border mb-3" id="purchase-approval-path-banner" role="status"
     data-am-preview-approval-url="@previewApprovalUrl">
    <strong>Approval path:</strong> <span id="purchase-approval-path-summary">@approvalSummary</span>
</div>

@using (Html.BeginForm("Create", "PurchaseRequests", FormMethod.Post, new
{
    enctype = "multipart/form-data",
    id = "purchase-request-form",
    data_am_purchase_request_form = "true",
    data_am_lock_department = lockDepartment ? "true" : "false"
}))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Currency)
    @Html.HiddenFor(m => m.RequestForSelf)
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Requisition target <span class="text-danger">*</span></label>
            @if (lockDepartment)
            {
                @Html.HiddenFor(m => m.DepartmentId)
                <input type="text" class="form-control" id="department-display" readonly="readonly" value="@(string.IsNullOrWhiteSpace(departmentName) ? "Your department" : departmentName)" />
            }
            else
            {
                @Html.DropDownListFor(m => m.DepartmentId, departments, "-- Select target department --", new { @class = "form-select", required = "required", id = "DepartmentId" })
                @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger" })
            }
            <div class="form-text">Room, class, or admin unit that will receive these goods.</div>
        </div>
        @if (ViewBag.CanCreateForAnyDepartment == true)
        {
            var orderByUsers = ViewBag.OrderByUsers as System.Web.Mvc.SelectList;
            <div class="col-md-4">
                <label class="form-label">Order by (optional)</label>
                @Html.DropDownListFor(m => m.OrderByUserId, orderByUsers, "-- Teacher / class contact (optional) --", new { @class = "form-select" })
                <div class="form-text">Class contact or teacher in the selected department. This person is not the approver.</div>
            </div>
        }
        <div class="col-12">
            <label class="form-label">Tag existing asset (optional)</label>
            @Html.HiddenFor(m => m.TargetAssetId)
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       id="target-asset-display"
                       readonly="readonly"
                       placeholder="No asset selected"
                       value="@selectedTargetAssetLabel"
                       role="button"
                       style="cursor: pointer;" />
                <button type="button"
                        class="btn btn-outline-primary"
                        id="open-target-asset-picker">Browse assets</button>
                <button type="button" class="btn btn-outline-secondary" id="clear-target-asset" title="Clear selection">&times;</button>
            </div>
            <div id="target-asset-hint" class="form-text">Optional: tag an asset to pre-fill the first line and show qty in stock when available.</div>
        </div>

        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">Items to order <span class="text-danger">*</span></label>
                <button type="button" class="btn btn-sm btn-outline-primary" id="add-purchase-line-item">Add another item</button>
            </div>
            <div id="purchase-line-items" class="vstack gap-2">
                @for (var i = 0; i < lineCount; i++)
                {
                    var line = i < lineModels.Count ? lineModels[i] : null;
                    <div class="purchase-line-item row g-2 align-items-end border rounded p-2" data-line-index="@i">
                        <div class="col-md-8">
                            <label class="form-label small mb-1">Description / what you need</label>
                            <input type="text"
                                   name="Lines[@i].Description"
                                   id="Lines_@(i)__Description"
                                   class="form-control am-line-description"
                                   value="@(line == null ? "" : line.Description)"
                                   required="required"
                                   maxlength="2000" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-1">Qty to order</label>
                            <input type="number"
                                   name="Lines[@i].Quantity"
                                   id="Lines_@(i)__Quantity"
                                   class="form-control am-line-quantity"
                                   value="@(line == null || line.Quantity <= 0 ? 1 : line.Quantity)"
                                   min="1"
                                   required="required" />
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm am-remove-line-item" @(i == 0 ? "disabled=\"disabled\"" : "") title="Remove line">Remove</button>
                        </div>
                    </div>
                }
            </div>
            @Html.ValidationMessage("Lines", new { @class = "text-danger" })
        </div>

        <div class="col-md-4 d-none" id="qty-in-stock-group">
            <label class="form-label">Qty in stock</label>
            @Html.TextBoxFor(m => m.QuantityInStock, new { @class = "form-control", type = "number", min = "0", @readonly = "readonly" })
        </div>
        <div class="col-md-4">
            <label class="form-label">Date required</label>
            @Html.TextBoxFor(m => m.RequiredDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            <div class="form-text">Optional — leave blank if not urgent.</div>
        </div>

        <div class="col-12">
            <label class="form-label">Justification / why <span class="text-danger">*</span></label>
            @Html.TextAreaFor(m => m.Justification, new { @class = "form-control", rows = 3, required = "required", placeholder = "Explain why this purchase is needed." })
            @Html.ValidationMessageFor(m => m.Justification, "", new { @class = "text-danger" })
            <div class="mt-2">
                <button class="btn btn-link btn-sm px-0" type="button" data-bs-toggle="collapse" data-bs-target="#purchase-more-detail" aria-expanded="false" aria-controls="purchase-more-detail">
                    More detail (optional)
                </button>
            </div>
            <div class="collapse" id="purchase-more-detail">
                @Html.TextAreaFor(m => m.Notes, new { @class = "form-control mt-1", rows = 2, placeholder = "Extra context for approvers (optional)." })
            </div>
        </div>

        <div class="col-12">
            <label class="form-label">Quote, photo, or item list (optional)</label>
            <input type="file" name="attachment" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.jpg,.jpeg,.png" />
            <div class="form-text">Upload supporting files (max 10 MB).</div>
        </div>
    </div>
    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = "Submit requisition",
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}

@section modals {
    @Html.Partial("_TargetAssetPickerModal")
}

@section scripts {
    <script src="@Url.Content("~/Scripts/app/purchase-request-create.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/purchase-request-create.js")).Ticks"></script>
}
