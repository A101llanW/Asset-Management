@model AssetManagement.Web.ViewModels.ListPageViewModel<AssetManagement.Application.ViewModels.AssetListVm>
@using System
@using System.Linq
@using AssetManagement.Application.Helpers
@using AssetManagement.Application.ViewModels
@using AssetManagement.Domain.Enums
@using AssetManagement.Web.Helpers
@{
    ViewBag.Title = "Assets";
    var canCreateAsset = Html.HasPermission("Assets.Create");
    var canEditAsset = Html.HasPermission("Assets.Edit");
    var canBulkEdit = ViewBag.CanBulkEdit as bool? ?? false;
    var canRelocateAsset = ViewBag.CanRelocateAsset as bool? ?? false;
    var classDepartments = ViewBag.ClassDepartments as System.Web.Mvc.SelectList;
    var roomDepartmentGroups = ViewBag.RoomDepartmentGroups as System.Collections.Generic.IList<AssetManagement.Web.ViewModels.DepartmentSelectGroupVm>;
    var canRelocateToRoom = canRelocateAsset && roomDepartmentGroups != null && roomDepartmentGroups.Any(g => g.Items != null && g.Items.Count > 0);
    // Asset move rules: Move to room only for assets in a room, sub-department or class (or company custody).
    var moveToRoomSourceIds = ViewBag.MoveToRoomSourceDepartmentIds as System.Collections.Generic.HashSet<int> ?? new System.Collections.Generic.HashSet<int>();
    var departments = ViewBag.Departments as System.Web.Mvc.SelectList;
    var statuses = ViewBag.Statuses as System.Web.Mvc.SelectList;
    var currentSort = ViewBag.Sort as string;
    var currentDirection = ViewBag.Direction as string;
    var listViewMode = ViewBag.ListViewMode as string ?? "grouped";
    var groupedPage = ViewBag.GroupedPage as AssetGroupListPageVm;
    var isGrouped = string.Equals(listViewMode, "grouped", StringComparison.OrdinalIgnoreCase);
    var groupBy = AssetListGroupBy.Normalize(groupedPage != null && !string.IsNullOrWhiteSpace(groupedPage.GroupBy)
        ? groupedPage.GroupBy
        : ViewBag.GroupBy as string);
    var isSimpleGroupBy = AssetListGroupBy.IsSimpleDimension(groupBy);
    var groupColumnLabel = AssetListGroupBy.GetColumnLabel(groupBy);
    var listFilter = ViewBag.Filter as AssetFilterVm ?? new AssetFilterVm();
    var canAssignAssets = Html.HasPermission("Assets.Assign");
    var showBatchAssignEntry = canAssignAssets
        && listFilter.UnassignedOnly
        && (!listFilter.Status.HasValue || listFilter.Status.Value == AssetStatus.InStore);
    var hasResults = isGrouped
        ? groupedPage != null && groupedPage.Items.Any()
        : Model.Items.Any();
    var roomGroupPage = ViewBag.RoomGroupPage as AssetRoomGroupPageVm;
    var isRoomView = AssetRoomGroupView.IsRoomView(listViewMode);
    if (isRoomView)
    {
        hasResults = roomGroupPage != null && roomGroupPage.TotalCount > 0;
    }
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Asset Register",
    Subtitle = "Search, review, and act on every tracked asset from one place.",
    PrimaryActionUrl = canCreateAsset ? Url.Action("Create") : null,
    PrimaryActionLabel = canCreateAsset ? "Create Asset" : null,
    SecondaryActionUrl = (canCreateAsset && FeatureFlags.AssetExcelImportUiEnabled) ? Url.Action("Import") : null,
    SecondaryActionLabel = (canCreateAsset && FeatureFlags.AssetExcelImportUiEnabled) ? "Import from Excel" : null
})

<div class="card card-kpi border-0 shadow-sm mb-4 am-fade-content">
    <div class="card-body p-3">
        @* d-block: stack the filter row above the checkbox row. As a flex .am-list-toolbar the two rows sat side by side, so the
           filter row only had half the card and its selects were squeezed at 1366px. *@
        <form class="am-list-toolbar d-block mb-0" method="get" id="amAssetListFilterForm">
            <div class="row g-2 align-items-center">
                @* Selects size to their longest option (col-lg-auto) so "Group by room" / "All statuses" are never clipped; search fills the rest. *@
                <div class="col-12 col-lg" style="min-width: 12rem;">
                    <!-- server Search matches serial; omit data-am-table-filter so client filter cannot hide those rows -->
                    <input type="text" class="form-control" name="Search" placeholder="Search tag, name, serial, custodian..." value="@Model.Search" />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    @Html.DropDownList("DepartmentId", departments, "All departments", new { @class = "form-select" })
                </div>
                @{ var sectionOptions = ViewBag.Sections as System.Web.Mvc.SelectList; }
                @if (sectionOptions != null)
                {
                    <div class="col-6 col-sm-3 col-lg-auto">
                        @Html.DropDownList("Section", sectionOptions, "All sections", new { @class = "form-select", aria_label = "Section", id = "amAssetFilterSection" })
                    </div>
                }
                <div class="col-6 col-sm-3 col-lg-auto">
                    @Html.DropDownList("Status", statuses, "All statuses", new { @class = "form-select", aria_label = "Status" })
                </div>
                @{ var purchaseOptions = ViewBag.PurchaseOptions as System.Collections.Generic.IList<SelectListItem>; }
                @if (purchaseOptions != null && purchaseOptions.Count > 1)
                {
                    <div class="col-6 col-sm-3 col-lg-auto">
                        <select class="form-select" name="PurchaseRecordId" id="amAssetFilterPurchase" aria-label="Purchase order">
                            @foreach (var option in purchaseOptions)
                            {
                                <option value="@option.Value" @(option.Selected ? "selected" : null)>@option.Text</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-6 col-sm-3 col-lg-auto">
                    <select class="form-select" name="view" id="amAssetFilterView" aria-label="View">
                        <option value="flat" @(isGrouped || isRoomView ? null : "selected")>Flat list</option>
                        <option value="grouped" @(isGrouped ? "selected" : null)>Grouped</option>
                        <option value="room" @(isRoomView ? "selected" : null)>Group by room</option>
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-lg-auto">
                    <select class="form-select" name="pageSize" aria-label="Page size">
                        @foreach (var size in new[] { 10, 25, 50 })
                        {
                            <option value="@size" @(Model.PageSize == size ? "selected" : null)>@size per page</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-lg-auto d-grid">
                    <button type="submit" class="btn btn-primary am-click-spark">Apply</button>
                </div>
            </div>
            <div class="row g-2 align-items-center mt-2">
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="UnassignedOnly" value="true" id="UnassignedOnly" @(listFilter.UnassignedOnly ? "checked" : null) />
                        <label class="form-check-label" for="UnassignedOnly">Unassigned only (no custodian)</label>
                    </div>
                </div>
                @if (canAssignAssets)
                {
                    <div class="col-md-8 text-md-end">
                        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("BatchCreate", "Assignments", new { fromFilter = true, Status = AssetStatus.InStore, UnassignedOnly = true, DepartmentId = listFilter.DepartmentId, Section = listFilter.Section, Search = listFilter.Search, returnUrl = Request.RawUrl })">Open in-store unassigned assign grid</a>
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@if (showBatchAssignEntry && hasResults)
{
    <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4" role="alert">
        <span>These assets have no custodian. Assign each row to a person in one step.</span>
        <a class="btn btn-primary btn-sm am-click-spark" href="@Url.Action("BatchCreate", "Assignments", new { fromFilter = true, Status = listFilter.Status ?? AssetStatus.InStore, UnassignedOnly = true, DepartmentId = listFilter.DepartmentId, Section = listFilter.Section, Search = listFilter.Search, returnUrl = Request.RawUrl })">Assign these units</a>
    </div>
}

@{
    // rel1022a: units / whole groups can be ticked for bulk actions (Assets.Edit) or "Send to printing" (Assets.View).
    var canSendToPrint = (isGrouped || isRoomView) && Html.HasPermission("Assets.View");
    var canSelectGroups = (isGrouped || isRoomView) && (canBulkEdit || canSendToPrint);
}
@if (canBulkEdit || isGrouped || canSendToPrint)
{
    @Html.Partial("_ListBulkToolbar")
}

@if (!hasResults)
{
    <div class="card card-kpi border-0 shadow-sm">
        <div class="card-body am-empty-state py-5">
            <div class="text-muted mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-info"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            </div>
            <h5 class="fw-bold text-dark am-split-text" data-am-split-text="@(string.IsNullOrWhiteSpace(Model.Search) ? "No assets yet" : "No assets match these filters")">@(string.IsNullOrWhiteSpace(Model.Search) ? "No assets yet" : "No assets match these filters")</h5>
            <p class="text-muted mb-4 am-text-type" data-am-text-type="@(string.IsNullOrWhiteSpace(Model.Search) ? "Start by creating your first asset record, then use the asset profile to assign it, transfer it, or track maintenance." : "Try adjusting the search, department, or status filters to widen the results.")">@(string.IsNullOrWhiteSpace(Model.Search) ? "Start by creating your first asset record, then use the asset profile to assign it, transfer it, or track maintenance." : "Try adjusting the search, department, or status filters to widen the results.")</p>
            @if (canCreateAsset)
            {
                <a class="btn btn-primary am-click-spark am-glare-hover" href="@Url.Action("Create")">Create Asset</a>
            }
        </div>
    </div>
}
else if (isRoomView && roomGroupPage != null)
{
    @Html.Partial("_AssetRoomGroups", roomGroupPage)
}
else if (isGrouped && groupedPage != null)
{
    <div class="card card-kpi border-0 shadow-sm am-fade-content mb-4">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom am-group-expand-toolbar">
                @if (canSelectGroups)
                {
                    <span class="text-muted small">Tick a group to select all of its units, or expand it to pick single units.</span>
                }
                else
                {
                    <span></span>
                }
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-group-expand-all>Expand all</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-group-collapse-all>Collapse all</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="bg-light text-secondary">
                            @if (isSimpleGroupBy)
                            {
                                <th class="ps-3">@groupColumnLabel</th>
                                <th>Units</th>
                                <th>Total cost</th>
                                <th class="text-end pe-3"></th>
                            }
                            else
                            {
                                <th class="ps-3">Name</th>
                                <th>Category</th>
                                <th>Department</th>
                                <th>Sub-type</th>
                                <th>Status</th>
                                <th>Units</th>
                                <th>Total cost</th>
                                <th class="text-end pe-3"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @{
                        var groupIndex = 0;
                    }
                    @foreach (var group in groupedPage.Items)
                    {
                        var groupCollapseId = "asset-group-" + groupIndex;
                        groupIndex++;
                        var summaryColspan = isSimpleGroupBy ? 4 : 8;
                        var groupLabel = isSimpleGroupBy
                            ? (string.IsNullOrWhiteSpace(group.GroupLabel) ? group.AssetName : group.GroupLabel)
                            : group.AssetName;
                        <tr class="am-group-summary-row">
                            @if (isSimpleGroupBy)
                            {
                                <td class="ps-3 fw-bold">
                                    @if (canSelectGroups)
                                    {
                                        <input type="checkbox" class="form-check-input me-2 align-middle" data-am-group-select="@groupCollapseId" data-am-group-count="@group.Count" data-am-group-label="@groupLabel" aria-label="Select all @group.Count units in @groupLabel" />
                                    }
                                    @if (string.Equals(groupBy, AssetListGroupBy.Status, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(group.CurrentStatus) badge-status">@groupLabel</span>
                                    }
                                    else
                                    {
                                        @groupLabel
                                    }
                                </td>
                                <td>@group.Count</td>
                                <td>@Html.FormatCurrency(group.TotalAcquisitionCost)</td>
                            }
                            else
                            {
                                <td class="ps-3 fw-bold">
                                    @if (canSelectGroups)
                                    {
                                        <input type="checkbox" class="form-check-input me-2 align-middle" data-am-group-select="@groupCollapseId" data-am-group-count="@group.Count" data-am-group-label="@(group.AssetName + (string.IsNullOrWhiteSpace(group.DepartmentName) ? "" : " - " + group.DepartmentName))" aria-label="Select all @group.Count units in @group.AssetName" />
                                    }
                                    @group.AssetName
                                </td>
                                <td>@group.CategoryName</td>
                                <td>@(string.IsNullOrWhiteSpace(group.DepartmentName) ? "Company custody" : group.DepartmentName)</td>
                                <td>@(string.IsNullOrWhiteSpace(group.AssetSubTypeName) ? DisplayText.Empty : group.AssetSubTypeName)</td>
                                <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(group.CurrentStatus) badge-status">@group.CurrentStatus</span></td>
                                <td>@group.Count</td>
                                <td>@Html.FormatCurrency(group.TotalAcquisitionCost)</td>
                            }
                            <td class="text-end pe-3 text-nowrap">
                                @if (!isSimpleGroupBy && canRelocateAsset && classDepartments != null && classDepartments.Any())
                                {
                                    var groupStatusRelocatable = group.CurrentStatus == AssetStatus.InStore
                                        || group.CurrentStatus == AssetStatus.Received
                                        || group.CurrentStatus == AssetStatus.Returned;
                                    var relocatableCount = groupStatusRelocatable ? group.Count : 0;
                                    if (relocatableCount > 0)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary me-1"
                                                data-am-relocate-group-open
                                                data-asset-name="@group.AssetName"
                                                data-asset-sub-type-id="@(group.AssetSubTypeId.HasValue ? group.AssetSubTypeId.Value.ToString() : string.Empty)"
                                                data-group-department-id="@(group.DepartmentId.HasValue ? group.DepartmentId.Value.ToString() : string.Empty)"
                                                data-group-status="@((int)group.CurrentStatus)"
                                                data-group-label="@group.AssetName (@relocatableCount)">Move group</button>
                                    }
                                }
                                @if (!isSimpleGroupBy && canRelocateToRoom
                                    && (!group.DepartmentId.HasValue || moveToRoomSourceIds.Contains(group.DepartmentId.Value))
                                    && (group.CurrentStatus == AssetStatus.InStore
                                        || group.CurrentStatus == AssetStatus.Received
                                        || group.CurrentStatus == AssetStatus.Returned))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary me-1"
                                            data-am-relocate-room-group-open
                                            data-asset-name="@group.AssetName"
                                            data-asset-sub-type-id="@(group.AssetSubTypeId.HasValue ? group.AssetSubTypeId.Value.ToString() : string.Empty)"
                                            data-group-department-id="@(group.DepartmentId.HasValue ? group.DepartmentId.Value.ToString() : string.Empty)"
                                            data-group-status="@((int)group.CurrentStatus)"
                                            data-group-label="@group.AssetName (@group.Count)">Move group to room</button>
                                }
                                <button class="btn btn-sm btn-outline-secondary"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@groupCollapseId"
                                        aria-expanded="false"
                                        aria-controls="@groupCollapseId"
                                        data-am-group-toggle>Expand</button>
                            </td>
                        </tr>
                        <tr class="am-group-detail-row" hidden="hidden" data-am-group-detail-row>
                            <td colspan="@summaryColspan" class="bg-light p-0 border-0">
                                <div class="collapse"
                                     id="@groupCollapseId"
                                     data-am-group-panel
                                     data-am-group-by="@groupBy"
                                     data-am-group-key="@group.GroupKey"
                                     data-am-group-asset-name="@(isSimpleGroupBy ? string.Empty : group.AssetName)"
                                     data-am-group-category-id="@(group.CategoryId.HasValue ? group.CategoryId.Value.ToString() : string.Empty)"
                                     data-am-group-asset-type-id="@(group.AssetTypeId.HasValue ? group.AssetTypeId.Value.ToString() : string.Empty)"
                                     data-am-group-sub-type-id="@(group.AssetSubTypeId.HasValue ? group.AssetSubTypeId.Value.ToString() : string.Empty)"
                                     data-am-group-department-id="@(group.DepartmentId.HasValue ? group.DepartmentId.Value.ToString() : string.Empty)"
                                     data-am-group-status="@((int)group.CurrentStatus)"
                                     data-am-group-count="@group.Count">
                                    <div class="py-2 px-3">
                                        <table class="table table-sm table-borderless mb-0 am-group-members-table">
                                            <thead class="text-muted small" data-am-group-member-head>
                                                <tr></tr>
                                            </thead>
                                            <tbody data-am-group-members data-am-group-key="@group.GroupKey"></tbody>
                                        </table>
                                        <div class="text-muted small py-2 d-none" data-am-group-loading>Loading members...</div>
                                        <div class="text-danger small py-2 d-none" data-am-group-error></div>
                                        <button type="button" class="btn btn-sm btn-link px-0 am-group-view-more d-none" data-am-view-more>View more</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @Html.Partial("_Pagination", new AssetManagement.Web.ViewModels.PaginationViewModel
    {
        Page = groupedPage.Page,
        TotalPages = Math.Max(1, (int)Math.Ceiling((double)groupedPage.TotalCount / groupedPage.PageSize)),
        TotalCount = groupedPage.TotalCount,
        StartItem = groupedPage.TotalCount == 0 ? 0 : ((groupedPage.Page - 1) * groupedPage.PageSize) + 1,
        EndItem = Math.Min(groupedPage.Page * groupedPage.PageSize, groupedPage.TotalCount)
    })
    if (canRelocateAsset && classDepartments != null && classDepartments.Any())
    {
        <div class="modal fade" id="amRelocateClassModal" tabindex="-1" aria-labelledby="amRelocateClassModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    @using (Html.BeginForm("RelocateToClass", "Assets", FormMethod.Post, new { id = "amRelocateClassForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("assetId", "", new { id = "amRelocateAssetId" })
                        @Html.Hidden("Search", listFilter.Search ?? Model.Search)
                        @Html.Hidden("DepartmentId", listFilter.DepartmentId)
                        @Html.Hidden("Section", listFilter.Section)
                        @Html.Hidden("Status", listFilter.Status)
                        @Html.Hidden("sort", currentSort)
                        @Html.Hidden("direction", currentDirection)
                        @Html.Hidden("page", Model.Page)
                        @Html.Hidden("pageSize", Model.PageSize)
                        @Html.Hidden("view", "grouped")
                        @Html.Hidden("groupBy", groupBy)
                        <div class="modal-header">
                            <h5 class="modal-title" id="amRelocateClassModalLabel">Move asset to class</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-3">Move <strong id="amRelocateAssetTag"></strong> to another class.</p>
                            <label class="form-label" for="targetDepartmentId">Target class</label>
                            @Html.DropDownList("targetDepartmentId", classDepartments, "-- Select class --", new { @class = "form-select", id = "targetDepartmentId", required = "required" })
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Move asset</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="modal fade" id="amRelocateGroupModal" tabindex="-1" aria-labelledby="amRelocateGroupModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    @using (Html.BeginForm("RelocateGroupToClass", "Assets", FormMethod.Post, new { id = "amRelocateGroupForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("assetName", "", new { id = "amRelocateGroupAssetName" })
                        @Html.Hidden("assetSubTypeId", "", new { id = "amRelocateGroupAssetSubTypeId" })
                        @Html.Hidden("groupDepartmentId", "", new { id = "amRelocateGroupDepartmentId" })
                        @Html.Hidden("groupStatus", "", new { id = "amRelocateGroupStatus" })
                        @Html.Hidden("Search", listFilter.Search ?? Model.Search)
                        @Html.Hidden("DepartmentId", listFilter.DepartmentId)
                        @Html.Hidden("Section", listFilter.Section)
                        @Html.Hidden("Status", listFilter.Status)
                        @Html.Hidden("sort", currentSort)
                        @Html.Hidden("direction", currentDirection)
                        @Html.Hidden("page", Model.Page)
                        @Html.Hidden("pageSize", Model.PageSize)
                        @Html.Hidden("view", "grouped")
                        @Html.Hidden("groupBy", groupBy)
                        <div class="modal-header">
                            <h5 class="modal-title" id="amRelocateGroupModalLabel">Move group to class</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-3">Move all eligible in-store units in <strong id="amRelocateGroupLabel"></strong> to another class. Assigned or non-eligible units are skipped.</p>
                            <label class="form-label" for="amRelocateGroupTargetDepartmentId">Target class</label>
                            @Html.DropDownList("targetDepartmentId", classDepartments, "-- Select class --", new { @class = "form-select", id = "amRelocateGroupTargetDepartmentId", required = "required" })
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Move group</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card card-kpi border-0 shadow-sm am-fade-content mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 am-filterable-table" data-am-filterable>
                    <thead>
                        <tr class="bg-light text-secondary" style="font-size: 0.82rem; letter-spacing: 0.04em;">
                            @if (canBulkEdit)
                            {
                                <th class="am-bulk-col ps-3"><input type="checkbox" data-am-bulk-master aria-label="Select all on page" class="form-check-input" /></th>
                            }
                            <th class="@(canBulkEdit ? "" : "ps-3")">@Html.SortLink("Asset Tag", "tag", currentSort, currentDirection)</th>
                            <th>@Html.SortLink("Name", "name", currentSort, currentDirection)</th>
                            <th>@Html.SortLink("Category", "category", currentSort, currentDirection)</th>
                            <th>@Html.SortLink("Department", "department", currentSort, currentDirection)</th>
                            <th>Custodian</th>
                            <th>@Html.SortLink("Status", "status", currentSort, currentDirection)</th>
                            <th>@Html.SortLink("Acquisition Cost", "acquisition", currentSort, currentDirection)</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="am-animated-list">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="border-bottom border-light">
                            @if (canBulkEdit)
                            {
                                <td class="ps-3"><input type="checkbox" data-am-bulk-id value="@item.Id" aria-label="Select @item.AssetTag" class="form-check-input" /></td>
                            }
                            <td class="@(canBulkEdit ? "" : "ps-3")"><span class="am-tag-pill">@item.AssetTag</span></td>
                            <td class="fw-bold text-dark">@item.AssetName</td>
                            <td>@item.CategoryName</td>
                            <td><span class="text-secondary small fw-medium">@(string.IsNullOrWhiteSpace(item.DepartmentName) ? "Company custody" : item.DepartmentName)</span></td>
                            <td class="text-muted" style="font-size: 0.85rem;">
                                <span class="@(string.IsNullOrWhiteSpace(item.CurrentCustodianName) ? "am-empty-custodian" : null)" title="@(string.IsNullOrWhiteSpace(item.CurrentCustodianName) && item.CurrentStatus == AssetStatus.Assigned ? "Held in department pool (no person custodian)" : null)">
                                    @DisplayText.FormatCustodian(item.CurrentCustodianName, item.CurrentStatus)
                                </span>
                            </td>
                            <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(item.CurrentStatus) badge-status px-2 py-1.5 rounded-pill text-capitalize">@item.CurrentStatus.ToString().Replace("AwaitingApproval", "Pending Approval").Replace("InStore", "In Store")</span></td>
                            <td class="fw-bold @(item.AcquisitionCost.HasValue ? "text-primary" : "text-muted fst-italic")">@AssetPriceRules.Format(item.AcquisitionCost)</td>
                            <td class="text-end pe-3">
                                <a class="btn btn-sm btn-outline-primary py-1 px-3 me-1" href="@Url.Action("Details", new { id = item.Id, returnUrl = Request.RawUrl })">Details</a>
                                @if (canEditAsset)
                                {
                                    <a class="btn btn-sm btn-outline-secondary py-1 px-3" href="@Url.Action("Edit", new { id = item.Id })">Edit</a>
                                }
                                @if (canRelocateToRoom
                                    && (!item.DepartmentId.HasValue || moveToRoomSourceIds.Contains(item.DepartmentId.Value))
                                    && string.IsNullOrWhiteSpace(item.CurrentCustodianId)
                                    && (item.CurrentStatus == AssetStatus.InStore
                                        || item.CurrentStatus == AssetStatus.Received
                                        || item.CurrentStatus == AssetStatus.Returned))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-3 ms-1" data-am-relocate-room-open data-asset-id="@item.Id" data-asset-tag="@item.AssetTag">Move to room</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @Html.Partial("_Pagination", new AssetManagement.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        StartItem = Model.StartItem,
        EndItem = Model.EndItem
    })
}

@if (canRelocateToRoom)
{
    <div class="modal fade" id="amRelocateRoomModal" tabindex="-1" aria-labelledby="amRelocateRoomModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                @using (Html.BeginForm("RelocateToRoom", "Assets", FormMethod.Post, new { id = "amRelocateRoomForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("assetId", "", new { id = "amRelocateRoomAssetId" })
                    @Html.Hidden("Search", listFilter.Search ?? Model.Search)
                    @Html.Hidden("DepartmentId", listFilter.DepartmentId)
                        @Html.Hidden("Section", listFilter.Section)
                    @Html.Hidden("Status", listFilter.Status)
                    @Html.Hidden("sort", currentSort)
                    @Html.Hidden("direction", currentDirection)
                    @Html.Hidden("page", Model.Page)
                    @Html.Hidden("pageSize", Model.PageSize)
                    @Html.Hidden("view", listViewMode)
                    @Html.Hidden("groupBy", groupBy)
                    <div class="modal-header">
                        <h5 class="modal-title" id="amRelocateRoomModalLabel">Move asset to room</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">Move <strong id="amRelocateRoomAssetTag"></strong> to a room.</p>
                        <label class="form-label" for="amRelocateRoomTargetDepartmentId">Target room</label>
                        @Html.GroupedDepartmentDropDown("targetDepartmentId", roomDepartmentGroups, "-- Select room --", new { @class = "form-select", id = "amRelocateRoomTargetDepartmentId", required = "required" })
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Move asset</button>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="modal fade" id="amRelocateRoomGroupModal" tabindex="-1" aria-labelledby="amRelocateRoomGroupModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                @using (Html.BeginForm("RelocateGroupToRoom", "Assets", FormMethod.Post, new { id = "amRelocateRoomGroupForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("assetName", "", new { id = "amRelocateRoomGroupAssetName" })
                    @Html.Hidden("assetSubTypeId", "", new { id = "amRelocateRoomGroupAssetSubTypeId" })
                    @Html.Hidden("groupDepartmentId", "", new { id = "amRelocateRoomGroupDepartmentId" })
                    @Html.Hidden("groupStatus", "", new { id = "amRelocateRoomGroupStatus" })
                    @Html.Hidden("Search", listFilter.Search ?? Model.Search)
                    @Html.Hidden("DepartmentId", listFilter.DepartmentId)
                        @Html.Hidden("Section", listFilter.Section)
                    @Html.Hidden("Status", listFilter.Status)
                    @Html.Hidden("sort", currentSort)
                    @Html.Hidden("direction", currentDirection)
                    @Html.Hidden("page", Model.Page)
                    @Html.Hidden("pageSize", Model.PageSize)
                    @Html.Hidden("view", listViewMode)
                    @Html.Hidden("groupBy", groupBy)
                    <div class="modal-header">
                        <h5 class="modal-title" id="amRelocateRoomGroupModalLabel">Move group to room</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">Move all eligible in-store units in <strong id="amRelocateRoomGroupLabel"></strong> to a room. Assigned or non-eligible units are skipped.</p>
                        <label class="form-label" for="amRelocateRoomGroupTargetDepartmentId">Target room</label>
                        @Html.GroupedDepartmentDropDown("targetDepartmentId", roomDepartmentGroups, "-- Select room --", new { @class = "form-select", id = "amRelocateRoomGroupTargetDepartmentId", required = "required" })
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Move group</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section scripts {
    @if (canRelocateToRoom)
    {
        <script>
            (function () {
                function setValue(id, value) { var el = document.getElementById(id); if (el) { el.value = value || ""; } }
                function setText(id, value) { var el = document.getElementById(id); if (el) { el.textContent = value || ""; } }
                function show(id) {
                    var modal = document.getElementById(id);
                    if (modal && window.bootstrap) { bootstrap.Modal.getOrCreateInstance(modal).show(); }
                }
                // Delegated so unit rows loaded later by assets-grouped.js work too.
                document.addEventListener("click", function (e) {
                    var unit = e.target.closest ? e.target.closest("[data-am-relocate-room-open]") : null;
                    if (unit) {
                        setValue("amRelocateRoomAssetId", unit.getAttribute("data-asset-id"));
                        setText("amRelocateRoomAssetTag", unit.getAttribute("data-asset-tag"));
                        setValue("amRelocateRoomTargetDepartmentId", "");
                        show("amRelocateRoomModal");
                        return;
                    }
                    var group = e.target.closest ? e.target.closest("[data-am-relocate-room-group-open]") : null;
                    if (group) {
                        setValue("amRelocateRoomGroupAssetName", group.getAttribute("data-asset-name"));
                        setValue("amRelocateRoomGroupAssetSubTypeId", group.getAttribute("data-asset-sub-type-id"));
                        setValue("amRelocateRoomGroupDepartmentId", group.getAttribute("data-group-department-id"));
                        setValue("amRelocateRoomGroupStatus", group.getAttribute("data-group-status"));
                        setText("amRelocateRoomGroupLabel", group.getAttribute("data-group-label"));
                        setValue("amRelocateRoomGroupTargetDepartmentId", "");
                        show("amRelocateRoomGroupModal");
                    }
                });
            })();
        </script>
    }
    @if (canBulkEdit)
    {
        <script src="@Url.Content("~/Scripts/app/list-bulk.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/list-bulk.js")).Ticks"></script>
    }
    @if (isRoomView && hasResults)
    {
        <script src="@Url.Content("~/Scripts/app/assets-by-room.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/assets-by-room.js")).Ticks"></script>
    }
    @if (isGrouped)
    {
        <script>
            document.querySelectorAll("[data-am-group-by-select]").forEach(function (select) {
                select.addEventListener("change", function () {
                    try {
                        sessionStorage.removeItem("am-assets-grouped-expanded");
                    } catch (e) {
                    }
                    var form = document.getElementById("amAssetListFilterForm");
                    if (form) {
                        form.submit();
                    }
                });
            });
        </script>
    }
    @if (isGrouped && groupedPage != null && groupedPage.Items.Any())
    {
        <script>
            window.AmGroupedAssetsConfig = {
                groupMembersUrl: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("GroupMembers", "Assets"))),
                groupBy: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(groupBy)),
                canBulkEdit: @(canBulkEdit ? "true" : "false"),
                canSelect: @(canSelectGroups ? "true" : "false"),
                canMoveToClass: @(canRelocateAsset && classDepartments != null && classDepartments.Any() ? "true" : "false"),
                canMoveToRoom: @(canRelocateToRoom ? "true" : "false"),
                unassignedLabel: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(DisplayText.Unassigned)),
                emptyLabel: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(DisplayText.Empty)),
                memberPageSize: 10,
                listFilter: {
                    search: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(listFilter.Search ?? "")),
                    departmentId: @(listFilter.DepartmentId.HasValue ? listFilter.DepartmentId.Value.ToString() : "null"),
                    section: @Html.Raw(listFilter.Section.HasValue ? Newtonsoft.Json.JsonConvert.SerializeObject(DepartmentSectionHelper.ToQueryValue(listFilter.Section.Value)) : "null"),
                    status: @(listFilter.Status.HasValue ? ((int)listFilter.Status.Value).ToString() : "null")
                }
            };
        </script>
        <script src="@Url.Content("~/Scripts/app/assets-grouped.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/assets-grouped.js")).Ticks"></script>
    }
    @if (canSelectGroups && hasResults)
    {
        <script src="@Url.Content("~/Scripts/app/asset-group-selection.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/asset-group-selection.js")).Ticks"></script>
    }
}
