@model AssetManagement.Web.ViewModels.AssetLabelPrintVm

@{

    ViewBag.Title = "Asset label - " + Model.AssetTag;

    Layout = "~/Views/Shared/_PrintLayout.cshtml";

}

<div class="am-asset-label-sheet" data-am-asset-label-config-url="@Url.Action("LabelPrintConfig", new { id = Model.AssetId })">

    @Html.Partial("_AssetLabelCodeTypeSelector", Model)

    @Html.Partial("_AssetLabelTemplateSelector", Model)

    @Html.Partial("_AssetLabelContent", Model)

    @Html.Partial("_AssetLabelPrinterStatus")

    <div class="am-asset-label-actions no-print">

        <button type="button" class="btn btn-success d-none" data-am-asset-label-zebra-print="true" data-asset-id="@Model.AssetId" data-config-url="@Url.Action("LabelPrintConfig", new { id = Model.AssetId })">Print to Zebra</button>
        <button type="button" class="btn btn-primary" data-am-asset-label-print="true">Print label</button>

        <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = Model.AssetId })">Back to asset</a>

    </div>

</div>



@section scripts {

    <script src="@Url.Content("~/Scripts/vendor/qrcode.min.js")"></script>
    <script src="@Url.Content("~/Scripts/vendor/jsbarcode.all.min.js")"></script>

    <script src="@Url.Content("~/Scripts/app/asset-label.js")"></script>
    <script>
        window.AssetLabelZebraScriptUrl = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Content("~/Scripts/app/asset-label-zebra.js") + "?v=" + System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/asset-label-zebra.js")).Ticks));
    </script>
    <script src="@Url.Content("~/Scripts/app/asset-label-zebra-loader.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/asset-label-zebra-loader.js")).Ticks" data-am-zebra-loader="true" data-zebra-src="@Url.Content("~/Scripts/app/asset-label-zebra.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/asset-label-zebra.js")).Ticks"></script>

    <script>

        (function () {

            var printButton = document.querySelector("[data-am-asset-label-print]");

            if (printButton && window.AssetLabel) {

                printButton.addEventListener("click", function () {
                    var run = function () { if (window.AssetLabel) { AssetLabel.print(); } };
                    if (window.AssetLabelZebraEnsure) {
                        window.AssetLabelZebraEnsure().then(function (zebra) {
                            if (zebra && zebra.initRoot) { zebra.initRoot(document); }
                            run();
                        }).catch(function () { run(); });
                    } else { run(); }
                });

            }

        })();

    </script>

}
