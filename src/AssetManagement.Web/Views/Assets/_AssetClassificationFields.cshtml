@using System.Linq
@model AssetManagement.Application.ViewModels.AssetCreateVm
@using AssetManagement.Domain.Entities
@{
    var categories = ViewBag.Categories as SelectList;
    var assetTypeOptions = ViewBag.AssetTypeOptions as IEnumerable<AssetType> ?? Enumerable.Empty<AssetType>();
    var categoryItems = categories != null
        ? categories.Cast<SelectListItem>().Where(i => !string.IsNullOrEmpty(i.Value)).ToList()
        : new List<SelectListItem>();
    var typesByCategory = assetTypeOptions
        .Where(t => t != null)
        .GroupBy(t => t.AssetCategoryId)
        .ToDictionary(g => g.Key, g => g.OrderBy(t => t.Name).ToList());
}

<p class="text-muted small mb-3" id="classification-sync-hint">
    Category and asset type stay linked. Choose a category to narrow types, or pick a type to set the category automatically.
</p>
<div class="row g-3">
    <div class="col-md-3">
        @Html.LabelFor(m => m.CategoryId, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.CategoryId, categories, "-- All categories --", new { @class = "form-select", id = "CategoryId" })
        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-3">
        @Html.LabelFor(m => m.AssetTypeId, new { @class = "form-label" })
        <select class="form-select" id="AssetTypeId" name="AssetTypeId">
            <option value="">-- Select asset type --</option>
            @foreach (var categoryItem in categoryItems)
            {
                int categoryId;
                if (!int.TryParse(categoryItem.Value, out categoryId))
                {
                    continue;
                }

                List<AssetType> typesForCategory;
                if (!typesByCategory.TryGetValue(categoryId, out typesForCategory) || typesForCategory.Count == 0)
                {
                    continue;
                }

                <optgroup label="@categoryItem.Text" data-category-id="@categoryId">
                    @foreach (var assetType in typesForCategory)
                    {
                        <option value="@assetType.Id"
                                data-category-id="@categoryId"
                                @(Model != null && Model.AssetTypeId == assetType.Id ? "selected" : null)>
                            @assetType.Name
                        </option>
                    }
                </optgroup>
            }
        </select>
        @Html.ValidationMessageFor(m => m.AssetTypeId, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-6">
        @Html.HiddenFor(m => m.AssetSubTypeId)
        <label class="form-label">Asset sub-type</label>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div id="asset-subtype-display" class="form-control-plaintext @(string.IsNullOrWhiteSpace(Model.AssetSubTypeName) ? "text-muted" : "fw-medium")">
                @(string.IsNullOrWhiteSpace(Model.AssetSubTypeName) ? "Not assigned" : Model.AssetSubTypeName)
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="asset-subtype-change">Change</button>
        </div>
        <p class="form-text mb-0">Create a new sub-type under a category and asset type, or select an existing one. New sub-types are saved for reuse on other assets.</p>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="DepartmentId">Department <span class="text-muted fw-normal">(optional)</span></label>
        @{
            var departments = ViewBag.Departments as SelectList;
        }
        @Html.DropDownListFor(m => m.DepartmentId, departments, "-- No department (organization custody) --", new { @class = "form-select" })
        <p class="form-text mb-0">Leave blank to register the asset under organization custody until a department is assigned.</p>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="SupplierId">Supplier <span class="text-muted fw-normal">(optional)</span></label>
        @{
            var suppliers = ViewBag.Suppliers as SelectList;
        }
        @Html.DropDownListFor(m => m.SupplierId, suppliers, "-- Select supplier --", new { @class = "form-select" })
    </div>
</div>
