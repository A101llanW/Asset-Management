@model AssetManagement.Web.ViewModels.AssetLabelPrintVm
<div class="am-asset-label-shell"
     data-am-asset-label-shell="true"
     data-asset-tag="@Model.AssetTag"
     data-asset-name="@Model.AssetName"
     data-department-name="@Model.DepartmentName"
     data-serial-number="@Model.SerialNumber"
     data-scan-url="@Model.ScanUrl"
     data-barcode-payload="@Model.BarcodePayload">
    <div class="am-asset-label am-asset-label--layout" data-am-asset-label-root="true"></div>
</div>
