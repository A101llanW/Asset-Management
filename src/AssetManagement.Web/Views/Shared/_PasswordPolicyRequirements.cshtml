@using AssetManagement.Application.Security
@{
    var rules = PasswordPolicy.GetRuleDefinitions();
}

<div class="am-password-policy" data-password-policy-indicator aria-live="polite">
    <p class="am-password-policy__title mb-2">Password requirements</p>
    <ul class="am-password-policy__list list-unstyled mb-0">
        @foreach (var rule in rules)
        {
            <li class="am-password-policy__item am-password-policy__item--pending" data-rule-id="@rule.Id">
                <span class="am-password-policy__icon" aria-hidden="true"></span>
                <span class="am-password-policy__label">@rule.Label</span>
            </li>
        }
    </ul>
</div>
