@using AssetManagement.Application.Helpers
@using AssetManagement.Web.Helpers
@{
    var canBulkEdit = ViewBag.CanBulkEdit as bool? ?? false;
    var departments = ViewBag.Departments as System.Web.Mvc.SelectList;
    var isGrouped = string.Equals(ViewBag.ListViewMode as string, "grouped", System.StringComparison.OrdinalIgnoreCase);
    var groupBy = AssetListGroupBy.Normalize(ViewBag.GroupBy as string);
    // rel1022a: whole-group selection + "Send to printing" in the grouped and by-room views.
    var isRoom = string.Equals(ViewBag.ListViewMode as string, "room", System.StringComparison.OrdinalIgnoreCase);
    var canSendToPrint = (isGrouped || isRoom) && Html.HasPermission("Assets.View");
    var groupByOption = AssetListGroupBy.Options.FirstOrDefault(o => string.Equals(o.Value, groupBy, System.StringComparison.OrdinalIgnoreCase));
    var registerViewLabel = isRoom ? "Asset register, grouped by room"
        : isGrouped ? "Asset register, grouped " + (groupByOption != null ? groupByOption.Label.ToLowerInvariant() : groupBy)
        : "Asset register";
}
@if (canBulkEdit || isGrouped || canSendToPrint)
{
    <div class="card card-kpi mb-3 am-bulk-toolbar" data-am-bulk-toolbar data-am-register-view-label="@registerViewLabel">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                @if (isGrouped)
                {
                    <div class="col-md-3" data-am-group-by-control>
                        <label class="form-label small mb-0" for="amAssetGroupBy">Group by</label>
                        <select class="form-select form-select-sm" name="groupBy" id="amAssetGroupBy" form="amAssetListFilterForm" data-am-group-by-select>
                            @foreach (var option in AssetListGroupBy.Options)
                            {
                                <option value="@option.Value" @(string.Equals(groupBy, option.Value, System.StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@option.Label</option>
                            }
                        </select>
                    </div>
                }
                @if (canBulkEdit)
                {
                <div class="col-md-3">
                    <label class="form-label small mb-0">Bulk action</label>
                    <select class="form-select form-select-sm" name="Action" form="amBulkForm" data-am-bulk-action>
                        <option value="">Select</option>
                        <option value="department">Move to department</option>
                        <option value="status">Update status</option>
                        <option value="maintenance">Mark under maintenance</option>
                    </select>
                </div>
                <div class="col-md-3" data-am-bulk-dept>
                    <label class="form-label small mb-0">Department</label>
                    @if (ViewBag.MoveDepartmentGroups is System.Collections.Generic.IList<AssetManagement.Web.ViewModels.DepartmentSelectGroupVm>)
                {
                    @Html.GroupedDepartmentDropDown("TargetDepartmentId", (System.Collections.Generic.IList<AssetManagement.Web.ViewModels.DepartmentSelectGroupVm>)ViewBag.MoveDepartmentGroups, " ", new { @class = "form-select form-select-sm", form = "amBulkForm" })
                }
                else
                {
                    @Html.DropDownList("TargetDepartmentId", departments, string.Empty, new { @class = "form-select form-select-sm", form = "amBulkForm" })
                }
                </div>
                <div class="col-md-3 d-none" data-am-bulk-status>
                    <label class="form-label small mb-0">Status</label>
                    <select class="form-select form-select-sm" name="TargetStatus" form="amBulkForm">
                        @foreach (AssetManagement.Domain.Enums.AssetStatus status in System.Enum.GetValues(typeof(AssetManagement.Domain.Enums.AssetStatus)))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100" form="amBulkForm" data-am-bulk-submit disabled>Apply to selected</button>
                </div>
                }
            </div>
            @if (canSendToPrint)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2" data-am-group-selection-bar>
                    <span class="small text-muted">Tick a whole @(isRoom ? "room" : "group") or single units@(canBulkEdit ? ", then apply a bulk action (Move to department keeps the usual move rules)," : "") or send them to label printing.</span>
                    <span class="small fw-medium" data-am-selection-count></span>
                    <span class="small" data-am-selection-status role="status" aria-live="polite"></span>
                    <button type="button" class="btn btn-sm btn-outline-success ms-auto" data-am-send-to-print disabled
                            title="Creates one print batch and opens Bulk Label Print with these assets queued. Nothing prints until you print there.">Send to printing</button>
                </div>
            }
        </div>
    </div>
    if (canBulkEdit)
    {
        using (Html.BeginForm("Bulk", "Assets", FormMethod.Post, new { id = "amBulkForm" }))
        {
            @Html.AntiForgeryToken()
            <div id="amBulkAssetIds"></div>
        }
    }
    if (canSendToPrint)
    {
        using (Html.BeginForm("QueueFromRegister", "AssetLabels", FormMethod.Post, new { id = "amSendToPrintForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupLabel" value="" />
            <input type="hidden" name="filterDescription" value="" />
            <input type="hidden" name="returnUrl" value="" />
            <div data-am-send-to-print-ids data-am-ids-name="assetIds"></div>
        }
    }
}
