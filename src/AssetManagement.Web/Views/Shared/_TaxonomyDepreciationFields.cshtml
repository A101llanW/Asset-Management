@{
    var canManage = ViewBag.CanManageDepreciation == true;
    var categoryDefaultLife = ViewBag.CategoryDefaultDepreciationLifeMonths as int?;
    var categoryDefaultRate = ViewBag.CategoryDefaultDepreciationRatePercent as decimal?;
    var isCategoryForm = ViewData["DepreciationFormMode"] as string == "category";
    var isTypeForm = ViewData["DepreciationFormMode"] as string == "type";
}

@if (canManage)
{
    <div class="card card-kpi border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h6 class="text-uppercase fw-bold text-muted mb-1" style="font-size:.78rem;letter-spacing:.08em;">Depreciation defaults</h6>
            <p class="text-muted small mb-3">
                Configure how assets depreciate over time. When depreciation life is not set here, the system uses operational useful life (asset, then type, then category).
                @if (isTypeForm)
                {
                    <span>Asset type values override the category defaults.</span>
                }
            </p>

            @if (isCategoryForm)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="DefaultDepreciationLifeMonths">Depreciation life (months)</label>
                        <input class="form-control" id="DefaultDepreciationLifeMonths" name="DefaultDepreciationLifeMonths" type="number" min="1" value="@(Model.DefaultDepreciationLifeMonths)" />
                        <div class="form-text">Leave blank to inherit useful life defaults.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="DefaultDepreciationRatePercent">Annual depreciation rate (%)</label>
                        <input class="form-control" id="DefaultDepreciationRatePercent" name="DefaultDepreciationRatePercent" type="number" min="0.01" max="100" step="0.01" value="@(Model.DefaultDepreciationRatePercent)" />
                        <div class="form-text">Leave blank to derive from life (100 ÷ years).</div>
                    </div>
                </div>
            }

            @if (isTypeForm)
            {
                if (categoryDefaultLife.HasValue || categoryDefaultRate.HasValue)
                {
                    <p class="small text-muted">
                        Category defaults:
                        <strong>@(categoryDefaultLife.HasValue ? categoryDefaultLife + " months" : "life not set")</strong>,
                        <strong>@(categoryDefaultRate.HasValue ? categoryDefaultRate + "%" : "rate not set")</strong>
                    </p>
                }
                else
                {
                    <p class="small text-muted">Category defaults: <strong>not set</strong> (useful life will apply when depreciation life is blank).</p>
                }

                <div class="form-check mb-3">
                    <input type="hidden" name="UseCustomDepreciationLife" value="false" />
                    <input class="form-check-input" id="UseCustomDepreciationLife" name="UseCustomDepreciationLife" type="checkbox" value="true" @(Model.UseCustomDepreciationLife ? "checked=\"checked\"" : null) />
                    <label class="form-check-label" for="UseCustomDepreciationLife">Override category depreciation life</label>
                </div>
                <div id="custom-depreciation-life-group" class="mb-3">
                    <label class="form-label" for="DepreciationLifeMonths">Depreciation life (months)</label>
                    <input class="form-control" id="DepreciationLifeMonths" name="DepreciationLifeMonths" type="number" min="1" value="@(Model.DepreciationLifeMonths)" />
                </div>

                <div class="form-check mb-3">
                    <input type="hidden" name="UseCustomDepreciationRate" value="false" />
                    <input class="form-check-input" id="UseCustomDepreciationRate" name="UseCustomDepreciationRate" type="checkbox" value="true" @(Model.UseCustomDepreciationRate ? "checked=\"checked\"" : null) />
                    <label class="form-check-label" for="UseCustomDepreciationRate">Override category depreciation rate</label>
                </div>
                <div id="custom-depreciation-rate-group">
                    <label class="form-label" for="DepreciationRatePercent">Annual depreciation rate (%)</label>
                    <input class="form-control" id="DepreciationRatePercent" name="DepreciationRatePercent" type="number" min="0.01" max="100" step="0.01" value="@(Model.DepreciationRatePercent)" />
                </div>

                <script>
                    (function () {
                        function syncGroup(checkboxId, groupId) {
                            var checkbox = document.getElementById(checkboxId);
                            var group = document.getElementById(groupId);
                            if (!checkbox || !group) { return; }
                            function sync() { group.style.display = checkbox.checked ? "" : "none"; }
                            checkbox.addEventListener("change", sync);
                            sync();
                        }
                        syncGroup("UseCustomDepreciationLife", "custom-depreciation-life-group");
                        syncGroup("UseCustomDepreciationRate", "custom-depreciation-rate-group");
                    })();
                </script>
            }
        </div>
    </div>
}
