@using System.Linq
@model AssetManagement.Application.ViewModels.DepartmentCreateVm
@using AssetManagement.Application.Services
@using AssetManagement.Domain.Enums
@{
    ViewBag.Title = "Create Department";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var setupModes = ViewBag.SetupModes as System.Web.Mvc.SelectList;
        var showSetupModePicker = ViewBag.ShowSetupModePicker as bool? ?? true;
    var lockedParentName = ViewBag.LockedParentName as string;
    var lockedParentId = ViewBag.LockedParentDepartmentId as int?;
    var createSetupMode = ViewBag.CreateSetupMode as string ?? Model.SetupMode ?? DepartmentService.SetupModeNormal;
    var lockedParentKind = ViewBag.LockedParentDepartmentKind as DepartmentKind?;
    var lockedParentIsAdmin = lockedParentKind == DepartmentKind.Administrative;
    var sectionOptions = ViewBag.SectionOptions as System.Web.Mvc.SelectList;
    var gradeOptions = ViewBag.GradeOptions as System.Collections.Generic.IList<AssetManagement.Application.ViewModels.DepartmentVm>
        ?? new System.Collections.Generic.List<AssetManagement.Application.ViewModels.DepartmentVm>();
    var isGradeSetup = createSetupMode == DepartmentService.SetupModeGrade;
    var isClassSetup = createSetupMode == DepartmentService.SetupModeClass;
    var pageTitle = createSetupMode == DepartmentService.SetupModeSubDepartment
        ? "Create Sub-department"
        : createSetupMode == DepartmentService.SetupModeRoom
            ? (lockedParentId.HasValue ? "Create Room" : "Create independent Room")
            : isGradeSetup
                ? "Create Year"
                : isClassSetup
                    ? "Create Classroom"
                    : "Create Department";
    var pageSubtitle = isGradeSetup
        ? "Add one year (for example Prep, G00). Pick its Section so Prep stays apart from Senior school."
        : isClassSetup
        ? "Add one classroom under an existing year. It takes the year's Section."
        : createSetupMode == DepartmentService.SetupModeSubDepartment
        ? "Add a sub-department under " + lockedParentName + "."
        : createSetupMode == DepartmentService.SetupModeRoom
            ? (lockedParentId.HasValue
                ? (lockedParentIsAdmin
                    ? "Add a room under administrative department " + lockedParentName + "."
                    : "Add a room under sub-department " + lockedParentName + ".")
                : "Add a standalone room with no parent department.")
            : showSetupModePicker
                ? "Add an administrative department, a year with classroom streams, or bulk years 1-6."
                : "Add a top-level administrative department for your organization.";
    var showSharedIdentity = createSetupMode == DepartmentService.SetupModeNormal
        || createSetupMode == DepartmentService.SetupModeSubDepartment
        || createSetupMode == DepartmentService.SetupModeRoom
        || isGradeSetup
        || isClassSetup
        || showSetupModePicker;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = pageTitle,
    Subtitle = pageSubtitle,
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Departments", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = pageTitle }
    }
})
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @* Post SetupMode as hidden when picker is fixed; dropdown posts it when picker is shown. *@
    if (!showSetupModePicker)
    {
        @Html.HiddenFor(m => m.SetupMode)
    }
    if (lockedParentId.HasValue)
    {
        @Html.HiddenFor(m => m.LockedParentDepartmentId)
        @Html.HiddenFor(m => m.ParentDepartmentId)
    }
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    if (showSetupModePicker)
    {
        <div class="mb-3">
            <label class="form-label">Setup type</label>
            @Html.DropDownListFor(m => m.SetupMode, setupModes, new { @class = "form-select", id = "department-setup-mode" })
        </div>
    }
    if (sectionOptions != null)
    {
        <div class="mb-3" id="setup-section-row">
            <label class="form-label" for="department-section-select">Section</label>
            @Html.DropDownListFor(m => m.Section, sectionOptions, new { @class = "form-select", id = "department-section-select" })
            <div class="form-text" id="section-help">Prep and Senior school are kept apart in the tree, the asset register and reports. Existing departments stay Senior school.</div>
        </div>
    }
    <div id="setup-shared-identity" style="@(showSharedIdentity ? null : "display:none;")">
        <div class="mb-3" id="shared-parent-row" style="display:none;">
            <label class="form-label" id="shared-parent-label">Parent</label>
            <input type="text" class="form-control" id="shared-parent-value" value="@lockedParentName" readonly="readonly" />
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Name, new { @class = "form-label", id = "shared-name-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", id = "department-name-input", autocomplete = "off" })
            <div class="form-text" id="shared-name-help" style="display:none;"></div>
        </div>
        <div class="mb-3" id="shared-code-row">
            @Html.LabelFor(m => m.Code, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "department-code-input" })
            <div class="form-text" id="shared-code-help"></div>
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3", id = "department-description-input" })
        </div>
        <div class="form-check mb-3" id="shared-req-target-row">
            @Html.CheckBoxFor(m => m.IsRequisitionTarget, new { @class = "form-check-input", id = "requisition-target-shared" })
            <label class="form-check-label" for="requisition-target-shared">Requisition target</label>
        </div>
        <div class="mb-3" id="shared-room-custodian-row" style="display:none;">
            <label class="form-label" for="RoomCustodianUserId">Room custodian (optional)</label>
            @Html.DropDownListFor(
                m => m.RoomCustodianUserId,
                ViewBag.RoomCustodianUsers as System.Web.Mvc.SelectList ?? new System.Web.Mvc.SelectList(Enumerable.Empty<System.Web.Mvc.SelectListItem>()),
                "-- None (department pool) --",
                new { @class = "form-select", id = "RoomCustodianUserId" })
            <div class="form-text">Optional. Never required to create a room.</div>
        </div>
    </div>
    <div id="setup-grade-single" style="display:none;">
        <div class="mb-3">
            <label class="form-label" for="department-sortorder-input">Sort number</label>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number", min = "0", max = "999", id = "department-sortorder-input" })
            <div class="form-text">Optional. Lower numbers list first inside the section. Blank = taken from the code (G03 = 3).</div>
        </div>
    </div>
    <div id="setup-class-single" style="display:none;">
        <div class="mb-3">
            <label class="form-label" for="class-grade-select">Year</label>
            <select name="ParentDepartmentId" id="class-grade-select" class="form-select">
                <option value="">-- Select year --</option>
                @foreach (var grade in gradeOptions)
                {
                    <option value="@grade.Id" data-section="@AssetManagement.Application.Helpers.DepartmentSectionHelper.ToQueryValue(AssetManagement.Application.Helpers.DepartmentSectionHelper.Normalize(grade.Section))" @(Model.ParentDepartmentId == grade.Id ? "selected" : null)>@AssetManagement.Application.Helpers.DepartmentLabelHelper.FormatCodeName(grade.Code, grade.Name) (@AssetManagement.Application.Helpers.DepartmentSectionHelper.Label(grade.Section))</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="ClassTeacherUserId">Classroom teacher (optional)</label>
            @Html.DropDownListFor(
                m => m.ClassTeacherUserId,
                ViewBag.ClassTeacherUsers as System.Web.Mvc.SelectList ?? new System.Web.Mvc.SelectList(Enumerable.Empty<System.Web.Mvc.SelectListItem>()),
                "-- None --",
                new { @class = "form-select", id = "ClassTeacherUserId" })
        </div>
    </div>
    <div id="setup-grade-streams" style="display:none;">
        <div class="mb-3">
            <label class="form-label">Year number</label>
            @Html.TextBoxFor(m => m.GradeNumber, new { @class = "form-control", type = "number", min = "1", max = "6" })
            <div class="form-text">Years are capped at 6 for school clients.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Streams</label>
            @Html.TextBoxFor(m => m.SelectedStreams, new { @class = "form-control", placeholder = "A,B,C" })
            <div class="form-text">Enter streams separated by commas (example: A,B,C).</div>
        </div>
    </div>
    <div id="setup-bulk-grades" style="display:none;">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">From year</label>
                @Html.TextBoxFor(m => m.BulkGradeFrom, new { @class = "form-control", type = "number", min = "1", max = "6" })
            </div>
            <div class="col-md-3">
                <label class="form-label">To year</label>
                @Html.TextBoxFor(m => m.BulkGradeTo, new { @class = "form-control", type = "number", min = "1", max = "6" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Streams per year</label>
                @Html.TextBoxFor(m => m.BulkStreams, new { @class = "form-control", placeholder = "A,B,C,D" })
            </div>
        </div>
        <div class="form-text mt-2">Optional manual path when classrooms are not yet in the import template. Maximum year is 6.</div>
    </div>
    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = pageTitle,
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}
<script>
    (function () {
        var modeSelect = document.getElementById('department-setup-mode');
        var setupModeHidden = document.querySelector('input[name="SetupMode"]');
        var fixedMode = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(createSetupMode));
        var lockedParentId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(lockedParentId));
        var lockedParentIsAdmin = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(lockedParentIsAdmin));
        var sections = {
            GradeWithStreams: document.getElementById('setup-grade-streams'),
            BulkGrades: document.getElementById('setup-bulk-grades'),
            GradeSingle: document.getElementById('setup-grade-single'),
            ClassSingle: document.getElementById('setup-class-single')
        };
        var sectionRow = document.getElementById('setup-section-row');
        var sectionSelect = document.getElementById('department-section-select');
        var classGradeSelect = document.getElementById('class-grade-select');
        var shared = document.getElementById('setup-shared-identity');
        var parentRow = document.getElementById('shared-parent-row');
        var parentLabel = document.getElementById('shared-parent-label');
        var codeRow = document.getElementById('shared-code-row');
        var codeHelp = document.getElementById('shared-code-help');
        var nameLabel = document.getElementById('shared-name-label');
        var nameHelp = document.getElementById('shared-name-help');
        var nameInput = document.getElementById('department-name-input');
        var reqRow = document.getElementById('shared-req-target-row');

        function setDisabled(root, disabled) {
            if (!root) { return; }
            var fields = root.querySelectorAll('input, select, textarea');
            for (var i = 0; i < fields.length; i++) {
                fields[i].disabled = !!disabled;
            }
        }

        function syncSections() {
            var mode = modeSelect ? modeSelect.value : fixedMode;
            if (setupModeHidden && modeSelect) {
                setupModeHidden.value = mode;
            }
            var isGrade = mode === 'GradeWithStreams';
            var isBulk = mode === 'BulkGrades';
            var isSub = mode === 'SubDepartment';
            var isRoom = mode === 'Room';
            var isGradeOne = mode === 'Grade';
            var isClassOne = mode === 'Class';
            var isNormal = mode === 'Normal' || (!isGrade && !isBulk && !isSub && !isRoom && !isGradeOne && !isClassOne);

            if (shared) {
                shared.style.display = (isGrade || isBulk) ? 'none' : '';
                setDisabled(shared, isGrade || isBulk);
            }
            Object.keys(sections).forEach(function (key) {
                if (sections[key]) {
                    var show = (key === 'GradeWithStreams' && isGrade) || (key === 'BulkGrades' && isBulk)
                        || (key === 'GradeSingle' && isGradeOne) || (key === 'ClassSingle' && isClassOne);
                    sections[key].style.display = show ? '' : 'none';
                    setDisabled(sections[key], !show);
                }
            });

            if (parentRow) {
                var showParent = !!lockedParentId && (isSub || isRoom);
                parentRow.style.display = showParent ? '' : 'none';
                if (parentLabel) {
                    parentLabel.textContent = isRoom
                        ? (lockedParentIsAdmin ? 'Administrative department' : 'Sub-department')
                        : 'Parent department';
                }
            }
            if (sectionRow) {
                // Sub-departments and rooms under a locked parent inherit its Section, so the select is hidden and not posted.
                var showSection = !(lockedParentId && (isSub || isRoom));
                sectionRow.style.display = showSection ? '' : 'none';
                setDisabled(sectionRow, !showSection);
            }
            if (codeRow) {
                var showCode = isNormal || (isRoom && !lockedParentId) || isGradeOne || isClassOne;
                codeRow.style.display = showCode ? '' : 'none';
                setDisabled(codeRow, !showCode);
                if (codeHelp) {
                    codeHelp.textContent = (isRoom && !lockedParentId) ? 'Independent rooms require a unique code.'
                        : isGradeOne ? 'Required and unique, up to 20 letters or digits (Prep = G00, Year 3 = G03).'
                        : isClassOne ? 'Optional. Blank = generated from the year code and the classroom name.'
                        : '';
                }
            }
            if (reqRow) {
                var showReq = isNormal || (isRoom && !lockedParentId);
                reqRow.style.display = showReq ? '' : 'none';
                setDisabled(reqRow, !showReq);
            }
            var custRow = document.getElementById('shared-room-custodian-row');
            if (custRow) {
                custRow.style.display = isRoom ? '' : 'none';
                setDisabled(custRow, !isRoom);
            }
            if (nameLabel) {
                nameLabel.textContent = isSub ? 'Sub-department name' : (isRoom ? 'Room name' : (isGradeOne ? 'Year name' : (isClassOne ? 'Classroom name' : 'Name')));
            }
            if (nameHelp) {
                if (isSub) {
                    nameHelp.style.display = '';
                    nameHelp.textContent = 'Creates a sub-department under the locked administrative parent.';
                } else {
                    nameHelp.style.display = 'none';
                    nameHelp.textContent = '';
                }
            }
            if (nameInput) {
                nameInput.placeholder = isSub ? 'Comp Lab - Senior' : (isRoom ? 'Conference Room A' : (isGradeOne ? 'Prep' : (isClassOne ? 'Prep Red' : '')));
            }
        }
        if (classGradeSelect && sectionSelect) {
            // A class takes its grade's Section: follow the grade picker (still editable afterwards).
            classGradeSelect.addEventListener('change', function () {
                var opt = classGradeSelect.options[classGradeSelect.selectedIndex];
                var value = opt ? opt.getAttribute('data-section') : '';
                if (value) {
                    sectionSelect.value = value;
                }
            });
        }
        if (modeSelect) {
            modeSelect.addEventListener('change', syncSections);
        }
        syncSections();
    })();
</script>
