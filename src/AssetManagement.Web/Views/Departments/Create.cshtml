@model AssetManagement.Application.ViewModels.DepartmentCreateVm
@using AssetManagement.Application.Helpers
@using AssetManagement.Application.Services
@{
    var createTitle = ViewBag.CreateTitle as string ?? "Add department";
    ViewBag.Title = createTitle;
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var domain = ViewBag.Domain as string ?? DepartmentHierarchyRules.DomainOrg;
    var setupModes = ViewBag.SetupModes as System.Web.Mvc.SelectList;
    var adminParents = ViewBag.AdminParentDepartments as System.Web.Mvc.SelectList;
    var orgParents = ViewBag.OrganizationalParentDepartments as System.Web.Mvc.SelectList;
    var setupModeLocked = ViewBag.SetupModeLocked as bool? ?? false;
    var mode = Model != null && !string.IsNullOrWhiteSpace(Model.SetupMode) ? Model.SetupMode : DepartmentService.SetupModeNormal;
    var indexLabel = domain == DepartmentHierarchyRules.DomainClasses ? "Grades & Streams" : "Departments";
    var subtitle = domain == DepartmentHierarchyRules.DomainClasses
        ? "Add a grade with streams (e.g. Grade 2 → 2A, 2B), or bulk-create a grade range."
        : "Add an administrative unit, sub-unit, or room (rooms may be independent).";
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = createTitle,
    Subtitle = subtitle,
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = indexLabel, Url = Url.Action("Index", new { domain = domain }) },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = createTitle }
    }
})
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <input type="hidden" name="domain" value="@domain" />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    if (setupModeLocked)
    {
        @Html.HiddenFor(m => m.SetupMode)
        <div class="mb-3">
            <label class="form-label">Setup type</label>
            <input type="text" class="form-control" readonly="readonly" value="@createTitle" />
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Setup type</label>
            @Html.DropDownListFor(m => m.SetupMode, setupModes, new { @class = "form-select", id = "department-setup-mode" })
        </div>
    }
    <div id="setup-normal" style="@(mode == DepartmentService.SetupModeNormal ? "" : "display:none;")">
        <div class="mb-3">
            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Code, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
        </div>
        <div class="form-check mb-3">
            @Html.CheckBoxFor(m => m.IsRequisitionTarget, new { @class = "form-check-input", id = "requisition-target-normal" })
            <label class="form-check-label" for="requisition-target-normal">Requisition target</label>
        </div>
    </div>
    <div id="setup-sub-department" style="@(mode == DepartmentService.SetupModeSubDepartment ? "" : "display:none;")">
        <div class="mb-3">
            <label class="form-label">Parent department</label>
            @Html.DropDownListFor(m => m.ParentDepartmentId, adminParents, "-- Select parent department --", new { @class = "form-select" })
            <div class="form-text">Sub-units sit under top-level admin departments (CODE — Name), not classes.</div>
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Name, "Sub-unit name", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Comp Lab - Senior" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
        </div>
    </div>
    <div id="setup-room" style="@(mode == DepartmentService.SetupModeRoom ? "" : "display:none;")">
        <div class="mb-3">
            <label class="form-label">Parent department or sub-unit (optional)</label>
            @Html.DropDownListFor(m => m.ParentDepartmentId, orgParents, "-- Independent room (no parent) --", new { @class = "form-select" })
            <div class="form-text">Rooms can stand alone or sit under a department or sub-unit. Each of Room / Sub-department / Department can define its own requisition flow; resolution is Room -> Sub-department -> Department -> org Approval Matrix.</div>
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Name, "Room name", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Dining Hall" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
        </div>
    </div>
    <div id="setup-grade-streams" style="@(mode == DepartmentService.SetupModeGradeStreams ? "" : "display:none;")">
        <div class="mb-3">
            <label class="form-label">Grade number</label>
            @Html.TextBoxFor(m => m.GradeNumber, new { @class = "form-control", type = "number", min = "1" })
            <div class="form-text">Enter any grade number your school uses (for example 1, 7, or 12).</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Streams</label>
            @Html.TextBoxFor(m => m.SelectedStreams, new { @class = "form-control", placeholder = "A,B,C or 2A,2B,2C" })
            <div class="form-text">Enter stream letters (A,B,C) or full codes (2A,2B). With grade 2 and A,B,C the system creates 2A, 2B, 2C.</div>
        </div>
    </div>
    <div id="setup-bulk-grades" style="@(mode == DepartmentService.SetupModeBulkGrades ? "" : "display:none;")">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">From grade</label>
                @Html.TextBoxFor(m => m.BulkGradeFrom, new { @class = "form-control", type = "number", min = "1" })
            </div>
            <div class="col-md-3">
                <label class="form-label">To grade</label>
                @Html.TextBoxFor(m => m.BulkGradeTo, new { @class = "form-control", type = "number", min = "1" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Streams per grade</label>
                @Html.TextBoxFor(m => m.BulkStreams, new { @class = "form-control", placeholder = "A,B,C" })
            </div>
        </div>
        <div class="form-text mt-2">Optional manual path when classes are not yet in the import template.</div>
    </div>
    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = createTitle,
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}
<script>
    (function () {
        var modeSelect = document.getElementById('department-setup-mode');
        var sections = {
            Normal: document.getElementById('setup-normal'),
            SubDepartment: document.getElementById('setup-sub-department'),
            Room: document.getElementById('setup-room'),
            GradeWithStreams: document.getElementById('setup-grade-streams'),
            BulkGrades: document.getElementById('setup-bulk-grades')
        };
        var titles = {
            Normal: 'Add department',
            SubDepartment: 'Add sub-unit',
            Room: 'Add room',
            GradeWithStreams: 'Add grade & streams',
            BulkGrades: 'Bulk create grades'
        };
        function syncSections() {
            var mode = modeSelect ? modeSelect.value : '@mode';
            Object.keys(sections).forEach(function (key) {
                if (sections[key]) {
                    sections[key].style.display = key === mode ? '' : 'none';
                }
            });
            var submit = document.querySelector('button[type="submit"], input[type="submit"]');
            if (submit && titles[mode]) {
                if (submit.tagName === 'INPUT') {
                    submit.value = titles[mode];
                } else {
                    submit.textContent = titles[mode];
                }
            }
        }
        if (modeSelect) {
            modeSelect.addEventListener('change', syncSections);
            syncSections();
        }
    })();
</script>
