@model AssetManagement.Web.ViewModels.DepartmentChildListViewModel
@using AssetManagement.Application.Helpers
@using AssetManagement.Web.Helpers
@{
    var canEditDepartment = Html.HasPermission("Departments.Edit");
    var returnUrl = Model.ReturnUrl;
    var listId = Model.ListDomId ?? "dept-child-list";
    var initialCount = Model.InitialVisibleCount > 0
        ? Model.InitialVisibleCount
        : DepartmentOrgHierarchyDisplay.DefaultVisibleChildCount;
    var rows = Model.Items ?? new List<AssetManagement.Application.ViewModels.DepartmentVm>();
    var visibleRows = rows.Take(initialCount).ToList();
    var hiddenRows = rows.Skip(initialCount).ToList();
}
@if (!rows.Any())
{
    <p class="text-muted mb-0">@Model.EmptyMessage</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="@listId">
                @foreach (var item in visibleRows)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@DepartmentOrgHierarchyDisplay.FormatDepartmentKind(item.DepartmentKind)</td>
                        <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(item.IsActive) badge-status">@(item.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = item.Id, returnUrl = returnUrl })">Details</a>
                            @if (canEditDepartment)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = item.Id, returnUrl = returnUrl })">Edit</a>
                            }
                        </td>
                    </tr>
                }
                @foreach (var item in hiddenRows)
                {
                    <tr class="d-none am-dept-child-extra" data-am-dept-child-extra="@listId">
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@DepartmentOrgHierarchyDisplay.FormatDepartmentKind(item.DepartmentKind)</td>
                        <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(item.IsActive) badge-status">@(item.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = item.Id, returnUrl = returnUrl })">Details</a>
                            @if (canEditDepartment)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = item.Id, returnUrl = returnUrl })">Edit</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    if (hiddenRows.Any())
    {
        <button type="button" class="btn btn-sm btn-link px-0 mt-2" data-am-dept-view-more="@listId">
            View more (@hiddenRows.Count more)
        </button>
    }
}
