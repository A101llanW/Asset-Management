@model IList<AssetManagement.Application.ViewModels.DepartmentVm>
@using AssetManagement.Application.Helpers
@using AssetManagement.Domain.Enums
@using AssetManagement.Web.Helpers
@{
    var domain = ViewBag.Domain as string ?? DepartmentHierarchyRules.DomainOrg;
    var isClasses = domain == DepartmentHierarchyRules.DomainClasses;
    ViewBag.Title = isClasses ? "Grades & Streams" : "Departments";
    var canCreateDepartment = Html.HasPermission("Departments.Create");
    var canEditDepartment = Html.HasPermission("Departments.Edit");
    var statusFilter = ViewBag.StatusFilter as string ?? "active";
    var viewMode = ViewBag.ViewMode as string ?? "tree";
    var search = ViewBag.Search as string;
    var treeSections = ViewBag.TreeSections as IList<AssetManagement.Application.ViewModels.DepartmentTreeSectionVm>
        ?? new List<AssetManagement.Application.ViewModels.DepartmentTreeSectionVm>();
    var selectedKinds = ViewBag.SelectedKinds as IList<string> ?? new List<string>();
    var availableKinds = ViewBag.AvailableKinds as DepartmentKind[]
        ?? (isClasses
            ? new[] { DepartmentKind.Grade, DepartmentKind.Class }
            : new[] { DepartmentKind.Administrative, DepartmentKind.SubDepartment, DepartmentKind.Room });
    var statusLabel = statusFilter == "all"
        ? (isClasses ? "grades and streams" : "departments")
        : statusFilter == "inactive"
            ? (isClasses ? "inactive grades and streams" : "inactive departments")
            : (isClasses ? "active grades and streams" : "active departments");
    var subtitle = isClasses
        ? "Maintain grades (e.g. Grade 2) and their streams (e.g. 2A, 2B). Showing " + statusLabel + "."
        : "Maintain business units, sub-units, and rooms. Showing " + statusLabel + ".";
    var primaryCreateMode = isClasses
        ? AssetManagement.Application.Services.DepartmentService.SetupModeGradeStreams
        : AssetManagement.Application.Services.DepartmentService.SetupModeNormal;
    var secondaryCreateMode = isClasses
        ? AssetManagement.Application.Services.DepartmentService.SetupModeBulkGrades
        : AssetManagement.Application.Services.DepartmentService.SetupModeSubDepartment;
    var primaryCreateLabel = isClasses ? "Add grade & streams" : "Add department";
    var secondaryCreateLabel = isClasses ? "Bulk create grades" : "Add sub-unit";
    var treeColCount = isClasses ? 6 : 7;
    var showTreeSectionHeaders = isClasses || treeSections.Count > 1;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = isClasses ? "Grades & Streams" : "Departments",
    Subtitle = subtitle,
    PrimaryActionUrl = canCreateDepartment ? Url.Action("Create", new { domain = domain, setupMode = primaryCreateMode }) : null,
    PrimaryActionLabel = canCreateDepartment ? primaryCreateLabel : null,
    SecondaryActionUrl = canCreateDepartment ? Url.Action("Create", new { domain = domain, setupMode = secondaryCreateMode }) : null,
    SecondaryActionLabel = canCreateDepartment ? secondaryCreateLabel : null,
    TertiaryActionUrl = (!isClasses && canCreateDepartment)
        ? Url.Action("Create", new { domain = domain, setupMode = AssetManagement.Application.Services.DepartmentService.SetupModeRoom })
        : null,
    TertiaryActionLabel = (!isClasses && canCreateDepartment) ? "Add room" : null
})
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(isClasses ? "" : "active")" href="@Url.Action("Index", new { domain = DepartmentHierarchyRules.DomainOrg, status = statusFilter, view = viewMode, search = search })">Departments</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(isClasses ? "active" : "")" href="@Url.Action("Index", new { domain = DepartmentHierarchyRules.DomainClasses, status = statusFilter, view = viewMode, search = search })">Grades &amp; Streams</a>
    </li>
</ul>
<form class="am-list-toolbar" method="get">
    <input type="hidden" name="domain" value="@domain" />
    <div class="row g-2 align-items-center">
        <div class="col-md-3">
            <input type="text" class="form-control" name="search" placeholder="Search by code, name, or description" value="@search" />
        </div>
        <div class="col-md-2">
            <select class="form-select" name="status">
                <option value="active" selected="@(statusFilter == "active")">Active only</option>
                <option value="inactive" selected="@(statusFilter == "inactive")">Inactive only</option>
                <option value="all" selected="@(statusFilter == "all")">All statuses</option>
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" name="view">
                <option value="tree" selected="@(viewMode == "tree")">Tree view</option>
                <option value="list" selected="@(viewMode == "list")">Flat list</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" name="kind" multiple="multiple" size="@Math.Max(2, availableKinds.Length)" title="Filter by kind">
                @foreach (var kindOption in availableKinds)
                {
                    var kindName = kindOption.ToString();
                    if (selectedKinds.Contains(kindName))
                    {
                        <option value="@kindName" selected="selected">@DepartmentHierarchyRules.DisplayLabel(kindOption)</option>
                    }
                    else
                    {
                        <option value="@kindName">@DepartmentHierarchyRules.DisplayLabel(kindOption)</option>
                    }
                }
            </select>
            <div class="form-text">Optional kind filter (Ctrl/Cmd+click for multiple).</div>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
        </div>
    </div>
</form>
@if (!Model.Any())
{
    <div class="card card-kpi am-list-panel">
        <div class="card-body am-empty-state">
            <h5>@(isClasses ? "No grades or streams yet" : "No departments yet")</h5>
            <p class="text-muted mb-3">
                @(isClasses
                    ? "Create a grade (e.g. Grade 2) and its streams (e.g. 2A, 2B, 2C) before assigning classroom assets."
                    : "Create departments before assigning assets so ownership and reporting stay accurate.")
            </p>
            @if (canCreateDepartment)
            {
                <a class="btn btn-primary me-2" href="@Url.Action("Create", new { domain = domain, setupMode = primaryCreateMode })">@primaryCreateLabel</a>
                <a class="btn btn-outline-primary me-2" href="@Url.Action("Create", new { domain = domain, setupMode = secondaryCreateMode })">@secondaryCreateLabel</a>
                if (!isClasses)
                {
                    <a class="btn btn-outline-secondary" href="@Url.Action("Create", new { domain = domain, setupMode = AssetManagement.Application.Services.DepartmentService.SetupModeRoom })">Add room</a>
                }
            }
        </div>
    </div>
}
else if (viewMode == "tree")
{
    <div class="card card-kpi am-list-panel">
        <div class="card-body p-0">
            <table class="table mb-0 am-dept-tree">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Kind</th>
                        @if (!isClasses)
                        {
                            <th>Flow</th>
                        }
                        <th>Requisition</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var treeSection in treeSections)
                {
                    if (showTreeSectionHeaders)
                    {
                        <tr class="am-dept-tree-section">
                            <th colspan="@treeColCount">@treeSection.Title</th>
                        </tr>
                    }
                    foreach (var parent in treeSection.Items)
                    {
                        <tr class="table-secondary">
                            <td>@parent.Code</td>
                            <td>@parent.Name</td>
                            <td>@Html.DepartmentKindBadge(parent.DepartmentKind)</td>
                            @if (!isClasses)
                            {
                                <td>@(parent.RequisitionFlowMode == RequisitionFlowMode.Custom ? "Custom" : "Inherit")</td>
                            }
                            <td>@(parent.IsRequisitionTarget ? "Yes" : "No")</td>
                            <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(parent.IsActive) badge-status">@(parent.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = parent.Id, returnUrl = Request.RawUrl })">Details</a>
                                @if (canEditDepartment)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = parent.Id, returnUrl = Request.RawUrl })">Edit</a>
                                }
                            </td>
                        </tr>
                        foreach (var child in parent.Children)
                        {
                            <tr>
                                <td class="ps-4">@child.Code</td>
                                <td class="ps-4">@child.Name</td>
                                <td>@Html.DepartmentKindBadge(child.DepartmentKind)</td>
                                @if (!isClasses)
                                {
                                    <td>@(child.RequisitionFlowMode == RequisitionFlowMode.Custom ? "Custom" : "Inherit")</td>
                                }
                                <td>@(child.IsRequisitionTarget ? "Yes" : "No")</td>
                                <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(child.IsActive) badge-status">@(child.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = child.Id, returnUrl = Request.RawUrl })">Details</a>
                                    @if (canEditDepartment)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = child.Id, returnUrl = Request.RawUrl })">Edit</a>
                                    }
                                </td>
                            </tr>
                            foreach (var grandchild in child.Children)
                            {
                                <tr>
                                    <td class="ps-5">@grandchild.Code</td>
                                    <td class="ps-5">@grandchild.Name</td>
                                    <td>@Html.DepartmentKindBadge(grandchild.DepartmentKind)</td>
                                    @if (!isClasses)
                                    {
                                        <td>@(grandchild.RequisitionFlowMode == RequisitionFlowMode.Custom ? "Custom" : "Inherit")</td>
                                    }
                                    <td>@(grandchild.IsRequisitionTarget ? "Yes" : "No")</td>
                                    <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(grandchild.IsActive) badge-status">@(grandchild.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = grandchild.Id, returnUrl = Request.RawUrl })">Details</a>
                                        @if (canEditDepartment)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = grandchild.Id, returnUrl = Request.RawUrl })">Edit</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card card-kpi am-list-panel">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead class="table-light"><tr><th>Code</th><th>Name</th><th>Kind</th>@if (!isClasses) { <th>Flow</th> }<th>Requisition</th><th>Description</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@Html.DepartmentKindBadge(item.DepartmentKind)</td>
                        @if (!isClasses)
                        {
                            <td>@(item.RequisitionFlowMode == RequisitionFlowMode.Custom ? "Custom" : "Inherit")</td>
                        }
                        <td>@(item.IsRequisitionTarget ? "Yes" : "No")</td>
                        <td>@item.Description</td>
                        <td><span class="badge bg-@StatusHtmlHelpers.ToBadgeClass(item.IsActive) badge-status">@(item.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = item.Id, returnUrl = Request.RawUrl })">Details</a>
                            @if (canEditDepartment)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = item.Id, returnUrl = Request.RawUrl })">Edit</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
