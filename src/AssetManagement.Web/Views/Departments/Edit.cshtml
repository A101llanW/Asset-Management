@model AssetManagement.Application.ViewModels.DepartmentVm
@using System.Linq
@using System.Web.Mvc
@using AssetManagement.Application.Contracts
@using AssetManagement.Application.Helpers
@using AssetManagement.Application.ViewModels
@using AssetManagement.Domain.Enums
@{
    var isRoom = Model.DepartmentKind == DepartmentKind.Room;
    var isSubDepartment = Model.DepartmentKind == DepartmentKind.SubDepartment;
    var isClass = Model.DepartmentKind == DepartmentKind.Class;
    var isFlowConfigurable = DepartmentHierarchyRules.CanConfigureRequisitionFlow(Model.DepartmentKind);
    var isTopLevelAdmin = Model.DepartmentKind == DepartmentKind.Administrative && !Model.ParentDepartmentId.HasValue;
    var editPageTitle = DepartmentLabelHelper.GetEditActionLabel(Model.DepartmentKind, isTopLevelAdmin);
    ViewBag.Title = editPageTitle;
    var editSubmitLabel = isRoom ? "Update room" : isSubDepartment ? "Update sub-department" : (isClass ? "Update class" : "Update Department");
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Details", new { id = Model.Id });

    var roomCandidates = ViewBag.RoomParentCandidates as IList<DepartmentVm>;
    var roomOtherGroups = ViewBag.RoomOtherParentGroups as IList<RoomOtherParentGroupVm>;
    var subParentSelectList = ViewBag.SubDepartmentParentSelectList as SelectList;
    var classGradeParentSelectList = ViewBag.ClassGradeParentSelectList as SelectList;
    var kindSelectList = ViewBag.DepartmentKindSelectList as SelectList;
    var roomOtherValue = ViewBag.RoomParentOtherValue as string ?? DepartmentLabelHelper.RoomParentOtherOptionValue;

    // Self-heal when controller ViewBag is incomplete (e.g. Grade/Admin edit needing Room parent after Kind change).
    if (roomCandidates == null || roomOtherGroups == null || subParentSelectList == null || classGradeParentSelectList == null || kindSelectList == null)
    {
        var deptService = DependencyResolver.Current.GetService<IDepartmentService>();
        var scopedDepartments = deptService == null
            ? new List<DepartmentVm>()
            : DepartmentListHelper.DeduplicateById(deptService.GetAll()).ToList();
        if (roomCandidates == null)
        {
            roomCandidates = DepartmentRoomParentCandidates.GetRoomParentCandidates(Model, scopedDepartments);
        }
        if (roomOtherGroups == null)
        {
            roomOtherGroups = DepartmentRoomParentCandidates.BuildOtherParentPickerGroups(scopedDepartments);
        }
        if (subParentSelectList == null)
        {
            var items = DepartmentRoomParentCandidates.GetTopLevelAdministrativeParents(scopedDepartments)
                .GroupBy(x => x.Id)
                .Select(g => g.First())
                .Select(x => new SelectListItem
                {
                    Value = x.Id.ToString(),
                    Text = DepartmentLabelHelper.FormatCodeName(x.Code, x.Name)
                })
                .ToList();
            subParentSelectList = new SelectList(items, "Value", "Text", Model.ParentDepartmentId);
        }
        if (classGradeParentSelectList == null)
        {
            var gradeItems = DepartmentRoomParentCandidates.GetGradeParentsForClass(Model, scopedDepartments)
                .GroupBy(x => x.Id)
                .Select(g => g.First())
                .Select(x => new SelectListItem
                {
                    Value = x.Id.ToString(),
                    Text = DepartmentLabelHelper.FormatCodeName(x.Code, x.Name)
                })
                .ToList();
            classGradeParentSelectList = new SelectList(gradeItems, "Value", "Text", Model.ParentDepartmentId);
        }

        if (kindSelectList == null)
        {
            var kindItems = DepartmentKindSelectListBuilder.BuildItems(Model.DepartmentKind)
                .Select(x => new SelectListItem
                {
                    Value = x.Value,
                    Text = x.Text,
                    Selected = x.Selected
                })
                .ToList();
            kindSelectList = new SelectList(kindItems, "Value", "Text", DepartmentKindSelectListBuilder.ToOptionValue(Model.DepartmentKind));
        }
    }

    roomCandidates = roomCandidates ?? new List<DepartmentVm>();
    roomOtherGroups = roomOtherGroups ?? new List<RoomOtherParentGroupVm>();
    classGradeParentSelectList = classGradeParentSelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var candidateIds = roomCandidates.Select(x => x.Id).ToList();
    string roomParentSelectValue = string.Empty;
    if (Model.ParentDepartmentId.HasValue && candidateIds.Contains(Model.ParentDepartmentId.Value))
    {
        roomParentSelectValue = Model.ParentDepartmentId.Value.ToString();
    }
    else if (Model.ParentDepartmentId.HasValue)
    {
        roomParentSelectValue = roomOtherValue;
    }
    var roomKindValue = DepartmentKindSelectListBuilder.ToOptionValue(DepartmentKind.Room);
    var subKindValue = DepartmentKindSelectListBuilder.ToOptionValue(DepartmentKind.SubDepartment);
    var classKindValue = DepartmentKindSelectListBuilder.ToOptionValue(DepartmentKind.Class);
    var adminKindValue = DepartmentKindSelectListBuilder.ToOptionValue(DepartmentKind.Administrative);
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = editPageTitle,
    Subtitle = isRoom
        ? "Update room details, parent department, and requisition approval used for this room."
        : (isFlowConfigurable
            ? "Update details and requisition approval (Inherit org/parent or Custom stages)."
            : "Update the department details used across users, assignments, and reporting."),
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Departments", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = Model.Name, Url = Url.Action("Details", new { id = Model.Id, returnUrl = Url.Action("Index") }) },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = editPageTitle }
    }
})
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="mb-3">
        @Html.LabelFor(m => m.Name, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Code, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
    </div>
    <div class="mb-3">
        <label class="form-label" for="department-kind-select">Department kind</label>
        @{
            // Manual <select>: DropDownListFor compares Convert.ToString(enum)="Room" to Value="4" and misses,
            // leaving Administrative (0) visually selected. Bind by int string to match option values / JS.
            var selectedKindValue = DepartmentKindSelectListBuilder.ToOptionValue(Model.DepartmentKind);
        }
        <select class="form-select" id="department-kind-select" name="DepartmentKind">
            @foreach (var kindItem in kindSelectList)
            {
                if (kindItem.Value == selectedKindValue)
                {
                    <option value="@kindItem.Value" selected="selected">@kindItem.Text</option>
                }
                else
                {
                    <option value="@kindItem.Value">@kindItem.Text</option>
                }
            }
        </select>
    </div>
    <div class="mb-3 js-edit-parent-room" id="edit-parent-room" style="@(isRoom ? null : "display:none;")">
        @Html.HiddenFor(m => m.ParentDepartmentId, new { id = "room-parent-id-hidden" })
        <label class="form-label" for="room-parent-select">Parent department</label>
        <select class="form-select" id="room-parent-select" name="roomParentSelector">
            <option value="" @(roomParentSelectValue == string.Empty ? "selected=\"selected\"" : null)>Independent room (no parent)</option>
            @foreach (var candidate in roomCandidates)
            {
                <option value="@candidate.Id" @(roomParentSelectValue == candidate.Id.ToString() ? "selected=\"selected\"" : null)>
                    @DepartmentLabelHelper.FormatCodeName(candidate.Code, candidate.Name)
                </option>
            }
            <option value="@roomOtherValue" @(roomParentSelectValue == roomOtherValue ? "selected=\"selected\"" : null)>Other administrative department or sub-department...</option>
        </select>
        <div class="form-text">Rooms may sit under a core administrative department, a sub-department, or remain independent. A room cannot be parented by another room, grade, or class.</div>
    </div>
    <div class="mb-3 js-edit-parent-sub" id="edit-parent-sub" style="@(isSubDepartment ? null : "display:none;")">
        <label class="form-label">Parent department</label>
        @Html.DropDownList(
            "ParentDepartmentId",
            subParentSelectList,
            "-- Select administrative parent --",
            new { @class = "form-select", id = "sub-parent-select" })
        <div class="form-text">Sub-departments must belong to a top-level administrative department.</div>
    </div>
    <div class="mb-3 js-edit-parent-class" id="edit-parent-class" style="@(isClass ? null : "display:none;")">
        <label class="form-label" for="class-parent-select">Parent grade</label>
        @Html.DropDownList(
            "ParentDepartmentId",
            classGradeParentSelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()),
            "-- Select grade parent --",
            new { @class = "form-select", id = "class-parent-select" })
        <div class="form-text">Classes must belong to a grade (grouping). Parent options are live grades from this organisation only.</div>
    </div>
    <div class="card border-warning mb-3 d-none" id="kind-change-children-panel"
         data-impact-url="@Url.Action("KindChangeImpact", new { id = Model.Id })"
         data-original-kind="@(ViewBag.OriginalDepartmentKind as string)"
         data-original-parent="@(ViewBag.OriginalParentDepartmentId as string)">
        <div class="card-header">Child units need a new parent</div>
        <div class="card-body">
            <p class="mb-2" id="kind-change-children-intro">This change would leave the active child units below in an invalid place (for example a room under a room). Pick a valid new parent for each one. The child moves and this change are saved together; nothing is saved if you go Back.</p>
            <div class="row g-2 align-items-end mb-2" id="kind-change-apply-all-row">
                <div class="col-sm-8">
                    <label class="form-label mb-0" for="kind-change-apply-all">Move all listed children to (optional)</label>
                    <select class="form-select form-select-sm" id="kind-change-apply-all"></select>
                </div>
                <div class="col-sm-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" id="kind-change-apply-all-btn">Apply to all</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Child unit</th><th>Kind</th><th>Why it must move</th><th style="min-width:16rem;">New parent</th></tr></thead>
                    <tbody id="kind-change-children-body"></tbody>
                </table>
            </div>
            <div class="text-danger small mt-2 d-none" id="kind-change-children-error"></div>
        </div>
    </div>
    <div class="mb-3 js-edit-class-teacher" id="edit-class-teacher" style="@(isClass ? null : "display:none;")">
        <label class="form-label" for="ClassTeacherUserId">Class teacher (optional)</label>
        @Html.DropDownListFor(
            m => m.ClassTeacherUserId,
            ViewBag.ClassTeacherUsers as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()),
            "-- None (department pool) --",
            new { @class = "form-select", id = "ClassTeacherUserId" })
        <div class="form-text">Optional. When set, Assign into this class can default To this person. Never required. Clearing does not reassign existing assets.</div>
    </div>
    <div class="mb-3 js-edit-room-custodian" id="edit-room-custodian" style="@(isRoom ? null : "display:none;")">
        <label class="form-label" for="RoomCustodianUserId">Room custodian (optional)</label>
        @Html.DropDownListFor(
            m => m.RoomCustodianUserId,
            ViewBag.RoomCustodianUsers as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()),
            "-- None (department pool) --",
            new { @class = "form-select", id = "RoomCustodianUserId" })
        <div class="form-text">Optional. When set, Assign into this room can default To this person. Never required. Clearing does not reassign existing assets.</div>
    </div>
    <div class="form-check mb-3">
        @Html.CheckBoxFor(m => m.IsRequisitionTarget, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.IsRequisitionTarget, new { @class = "form-check-label" })
    </div>
    <div class="form-check mb-3">
        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
    </div>
    <div id="edit-room-approval" style="@(isFlowConfigurable ? null : "display:none;")">
        @if (isFlowConfigurable)
        {
            @Html.Partial("_RoomRequisitionApproval", Model)
        }
    </div>
    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = editSubmitLabel,
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}
@section modals
{
    @Html.Partial("_RoomParentOtherModal", roomOtherGroups)
}
@section scripts
{
    <script src="@Url.Content("~/Scripts/app/room-custom-approval-stages.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/room-custom-approval-stages.js")).Ticks"></script>
    <script src="@Url.Content("~/Scripts/app/room-parent-other-modal.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/room-parent-other-modal.js")).Ticks"></script>
    <script>
        (function () {
            var roomKind = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(roomKindValue));
            var subKind = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(subKindValue));
            var classKind = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(classKindValue));
            var adminKind = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(adminKindValue));
            var kindSelect = document.getElementById('department-kind-select');
            var roomParent = document.getElementById('edit-parent-room');
            var subParent = document.getElementById('edit-parent-sub');
            var classParent = document.getElementById('edit-parent-class');
            var roomApproval = document.getElementById('edit-room-approval');
            var roomParentHidden = document.getElementById('room-parent-id-hidden');
            var subParentSelect = document.getElementById('sub-parent-select');
            var classParentSelect = document.getElementById('class-parent-select');
            var classTeacher = document.getElementById('edit-class-teacher');
            var roomCustodian = document.getElementById('edit-room-custodian');
            var classTeacherSelect = document.getElementById('ClassTeacherUserId');
            var roomCustodianSelect = document.getElementById('RoomCustodianUserId');

            function syncParentSections() {
                if (!kindSelect) { return; }
                var kind = kindSelect.value;
                var showRoom = kind === roomKind;
                var showSub = kind === subKind;
                var showClass = kind === classKind;
                var showApproval = kind === roomKind || kind === subKind || kind === classKind || kind === adminKind;
                if (roomParent) { roomParent.style.display = showRoom ? '' : 'none'; }
                if (subParent) { subParent.style.display = showSub ? '' : 'none'; }
                if (classParent) { classParent.style.display = showClass ? '' : 'none'; }
                if (roomApproval) { roomApproval.style.display = showApproval ? '' : 'none'; }
                if (classTeacher) { classTeacher.style.display = showClass ? '' : 'none'; }
                if (roomCustodian) { roomCustodian.style.display = showRoom ? '' : 'none'; }
                if (roomParentHidden) { roomParentHidden.disabled = showSub || showClass; } // Sub/Class use their own ParentDepartmentId selects
                if (subParentSelect) { subParentSelect.disabled = !showSub; }
                if (classParentSelect) { classParentSelect.disabled = !showClass; }
                if (classTeacherSelect) { classTeacherSelect.disabled = !showClass; }
                if (roomCustodianSelect) { roomCustodianSelect.disabled = !showRoom; }
            }

            if (kindSelect) {
                kindSelect.addEventListener('change', syncParentSections);
            }
            syncParentSections();

            // --- Kind-change guard: prompt for new parents of children the change would make invalid ---
            var childPanel = document.getElementById('kind-change-children-panel');
            var childBody = document.getElementById('kind-change-children-body');
            var childError = document.getElementById('kind-change-children-error');
            var applyAllSelect = document.getElementById('kind-change-apply-all');
            var applyAllBtn = document.getElementById('kind-change-apply-all-btn');
            var applyAllRow = document.getElementById('kind-change-apply-all-row');
            var impactSeq = 0;

            function postedParentValue() {
                var kind = kindSelect ? kindSelect.value : '';
                if (kind === subKind && subParentSelect) { return subParentSelect.value || ''; }
                if (kind === classKind && classParentSelect) { return classParentSelect.value || ''; }
                return roomParentHidden ? (roomParentHidden.value || '') : '';
            }

            function hierarchyChanged() {
                if (!childPanel || !kindSelect) { return false; }
                return kindSelect.value !== (childPanel.getAttribute('data-original-kind') || '')
                    || postedParentValue() !== (childPanel.getAttribute('data-original-parent') || '');
            }

            function clearChildPanel() {
                if (!childPanel) { return; }
                childBody.innerHTML = '';
                childPanel.classList.add('d-none');
            }

            function addOption(select, value, label) {
                var opt = document.createElement('option');
                opt.value = value;
                opt.textContent = label;
                select.appendChild(opt);
                return opt;
            }

            function renderChildPanel(data) {
                childBody.innerHTML = '';
                var items = (data && data.items) || [];
                if (!items.length) { clearChildPanel(); return; }
                var common = null;
                items.forEach(function (item, index) {
                    var tr = document.createElement('tr');
                    tr.setAttribute('data-am-kind-change-child', String(item.childId));
                    var nameTd = document.createElement('td');
                    nameTd.textContent = item.childName + (item.childCode ? ' (' + item.childCode + ')' : '');
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'ChildMoves[' + index + '].ChildDepartmentId';
                    hidden.value = String(item.childId);
                    nameTd.appendChild(hidden);
                    var kindTd = document.createElement('td');
                    kindTd.textContent = item.childKindLabel || '';
                    var reasonTd = document.createElement('td');
                    reasonTd.className = 'small text-muted';
                    reasonTd.textContent = item.reason || '';
                    var selTd = document.createElement('td');
                    var sel = document.createElement('select');
                    sel.className = 'form-select form-select-sm js-kind-change-new-parent';
                    sel.name = 'ChildMoves[' + index + '].NewParentDepartmentId';
                    sel.required = true;
                    var placeholder = addOption(sel, '', '-- Select new parent --');
                    placeholder.disabled = false;
                    var ids = [];
                    (item.candidates || []).forEach(function (c) {
                        addOption(sel, String(c.id), c.label);
                        ids.push(String(c.id));
                    });
                    if (!ids.length) {
                        sel.disabled = true;
                        placeholder.textContent = '-- No valid parent in this organisation --';
                    }
                    selTd.appendChild(sel);
                    tr.appendChild(nameTd);
                    tr.appendChild(kindTd);
                    tr.appendChild(reasonTd);
                    tr.appendChild(selTd);
                    childBody.appendChild(tr);
                    common = common === null ? ids : common.filter(function (id) { return ids.indexOf(id) >= 0; });
                });

                applyAllSelect.innerHTML = '';
                addOption(applyAllSelect, '', '-- Choose --');
                var firstSel = childBody.querySelector('select.js-kind-change-new-parent');
                (common || []).forEach(function (id) {
                    var src = firstSel ? firstSel.querySelector('option[value="' + id + '"]') : null;
                    addOption(applyAllSelect, id, src ? src.textContent : id);
                });
                applyAllRow.style.display = (items.length > 1 && common && common.length) ? '' : 'none';
                childError.classList.add('d-none');
                childPanel.classList.remove('d-none');
            }

            function refreshChildImpact() {
                if (!childPanel) { return; }
                if (!hierarchyChanged()) { clearChildPanel(); return; }
                var seq = ++impactSeq;
                var url = childPanel.getAttribute('data-impact-url')
                    + (childPanel.getAttribute('data-impact-url').indexOf('?') >= 0 ? '&' : '?')
                    + 'kind=' + encodeURIComponent(kindSelect.value)
                    + '&parentId=' + encodeURIComponent(postedParentValue());
                var xhr = new XMLHttpRequest();
                xhr.open('GET', url, true);
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState !== 4 || seq !== impactSeq) { return; }
                    if (xhr.status === 200) {
                        try { renderChildPanel(JSON.parse(xhr.responseText)); } catch (e) { clearChildPanel(); }
                    }
                };
                xhr.send();
            }

            if (applyAllBtn) {
                applyAllBtn.addEventListener('click', function () {
                    var value = applyAllSelect.value;
                    if (!value) { return; }
                    Array.prototype.forEach.call(childBody.querySelectorAll('select.js-kind-change-new-parent'), function (sel) {
                        if (sel.querySelector('option[value="' + value + '"]')) { sel.value = value; }
                    });
                });
            }

            if (kindSelect) { kindSelect.addEventListener('change', refreshChildImpact); }
            ['room-parent-select', 'sub-parent-select', 'class-parent-select'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) { el.addEventListener('change', function () { setTimeout(refreshChildImpact, 0); }); }
            });
            var editForm = kindSelect ? kindSelect.form : null;
            if (editForm) {
                editForm.addEventListener('submit', function (ev) {
                    if (!childPanel || childPanel.classList.contains('d-none')) { return; }
                    var missing = Array.prototype.filter.call(
                        childBody.querySelectorAll('select.js-kind-change-new-parent'),
                        function (sel) { return !sel.value; });
                    if (missing.length) {
                        ev.preventDefault();
                        childError.textContent = 'Choose a new parent for every listed child unit before saving.';
                        childError.classList.remove('d-none');
                        childPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }
            refreshChildImpact();

            // --- Inherit source picker: only valid for the saved parent; disable when Kind/Parent changes ---
            var inheritGroup = document.getElementById('requisition-inherit-source-group');
            var inheritSelect = document.getElementById('requisition-inherit-source');
            var inheritStale = document.getElementById('requisition-inherit-source-stale');
            function syncInheritSource() {
                if (!inheritGroup || !inheritSelect) { return; }
                var customRadio = document.getElementById('requisition-approval-custom');
                var isCustom = customRadio && customRadio.checked;
                var stale = hierarchyChanged();
                inheritGroup.style.display = isCustom ? 'none' : '';
                inheritSelect.disabled = isCustom || stale;
                if (inheritStale) { inheritStale.classList.toggle('d-none', !stale || isCustom); }
            }
            Array.prototype.forEach.call(document.querySelectorAll('input[name="RequisitionApprovalMode"]'), function (r) {
                r.addEventListener('change', syncInheritSource);
            });
            if (kindSelect) { kindSelect.addEventListener('change', syncInheritSource); }
            ['room-parent-select', 'sub-parent-select', 'class-parent-select'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) { el.addEventListener('change', function () { setTimeout(syncInheritSource, 0); }); }
            });
            if (editForm) { editForm.addEventListener('submit', syncInheritSource); }
            syncInheritSource();

            if (window.AmRoomCustomApprovalStages) {
                window.AmRoomCustomApprovalStages.init();
            }
            if (window.AmRoomParentOtherModal) {
                window.AmRoomParentOtherModal.init({
                    otherValue: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(roomOtherValue))
                });
            }
        })();
    </script>
}
