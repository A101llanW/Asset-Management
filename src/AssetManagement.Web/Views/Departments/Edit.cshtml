@model AssetManagement.Application.ViewModels.DepartmentVm
@using System.Linq
@using System.Web.Mvc
@using AssetManagement.Application.Helpers
@using AssetManagement.Application.ViewModels
@using AssetManagement.Domain.Enums
@{
    var isRoom = Model.DepartmentKind == DepartmentKind.Room;
    var isSubDepartment = Model.DepartmentKind == DepartmentKind.SubDepartment;
    var isTopLevelAdmin = Model.DepartmentKind == DepartmentKind.Administrative && !Model.ParentDepartmentId.HasValue;
    var editPageTitle = DepartmentLabelHelper.GetEditActionLabel(Model.DepartmentKind, isTopLevelAdmin);
    ViewBag.Title = editPageTitle;
    var editSubmitLabel = isRoom ? "Update room" : isSubDepartment ? "Update sub-department" : "Update Department";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Details", new { id = Model.Id });
    var roomCandidates = ViewBag.RoomParentCandidates as IList<DepartmentVm> ?? new List<DepartmentVm>();
    var roomOtherGroups = ViewBag.RoomOtherParentGroups as IList<RoomOtherParentGroupVm> ?? new List<RoomOtherParentGroupVm>();
    var roomOtherValue = ViewBag.RoomParentOtherValue as string ?? DepartmentLabelHelper.RoomParentOtherOptionValue;
    var subParentSelectList = ViewBag.SubDepartmentParentSelectList as SelectList;
    var candidateIds = roomCandidates.Select(x => x.Id).ToList();
    string roomParentSelectValue = string.Empty;
    if (Model.ParentDepartmentId.HasValue && candidateIds.Contains(Model.ParentDepartmentId.Value))
    {
        roomParentSelectValue = Model.ParentDepartmentId.Value.ToString();
    }
    else if (Model.ParentDepartmentId.HasValue)
    {
        roomParentSelectValue = roomOtherValue;
    }
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = editPageTitle,
    Subtitle = isRoom
        ? "Update room details, parent department, and requisition approval used for this room."
        : "Update the department details used across users, assignments, and reporting.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Departments", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = Model.Name, Url = Url.Action("Details", new { id = Model.Id, returnUrl = Url.Action("Index") }) },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = editPageTitle }
    }
})
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="mb-3">
        @Html.LabelFor(m => m.Name, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Code, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
    </div>
    if (isRoom)
    {
        @Html.HiddenFor(m => m.ParentDepartmentId, new { id = "room-parent-id-hidden" })
        <div class="mb-3">
            <label class="form-label" for="room-parent-select">Parent department</label>
            <select class="form-select" id="room-parent-select" name="roomParentSelector">
                <option value="" @(roomParentSelectValue == string.Empty ? "selected=\"selected\"" : null)>Independent room (no parent)</option>
                @foreach (var candidate in roomCandidates)
                {
                    <option value="@candidate.Id" @(roomParentSelectValue == candidate.Id.ToString() ? "selected=\"selected\"" : null)>
                        @DepartmentLabelHelper.FormatCodeName(candidate.Code, candidate.Name)
                    </option>
                }
                <option value="@roomOtherValue" @(roomParentSelectValue == roomOtherValue ? "selected=\"selected\"" : null)>Other administrative department or sub-department...</option>
            </select>
            <div class="form-text">Rooms may sit under a core administrative department, a sub-department, or remain independent. A room cannot be parented by another room, grade, or class.</div>
        </div>
    }
    else if (isSubDepartment)
    {
        <div class="mb-3">
            <label class="form-label">Parent department</label>
            @Html.DropDownListFor(
                m => m.ParentDepartmentId,
                subParentSelectList,
                "-- Select administrative parent --",
                new { @class = "form-select" })
            <div class="form-text">Sub-departments must belong to a top-level administrative department.</div>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">Department kind</label>
        @Html.DropDownListFor(
            m => m.DepartmentKind,
            Enum.GetValues(typeof(DepartmentKind))
                .Cast<DepartmentKind>()
                .Select(value => new SelectListItem
                {
                    Value = ((int)value).ToString(),
                    Text = DepartmentOrgHierarchyDisplay.FormatDepartmentKind(value)
                }),
            new { @class = "form-select" })
    </div>
    <div class="form-check mb-3">
        @Html.CheckBoxFor(m => m.IsRequisitionTarget, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.IsRequisitionTarget, new { @class = "form-check-label" })
    </div>
    <div class="form-check mb-3">
        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
    </div>
    if (isRoom)
    {
        @Html.Partial("_RoomRequisitionApproval", Model)
    }
    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = editSubmitLabel,
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}
@section modals
{
    if (isRoom)
    {
        @Html.Partial("_RoomParentOtherModal", roomOtherGroups)
    }
}
@section scripts
{
    if (isRoom)
    {
        <script src="@Url.Content("~/Scripts/app/room-parent-other-modal.js")"></script>
        <script>
            (function () {
                if (window.AmRoomParentOtherModal) {
                    window.AmRoomParentOtherModal.init({
                        otherValue: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(roomOtherValue))
                    });
                }
            })();
        </script>
    }
}
