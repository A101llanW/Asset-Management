@model AssetManagement.Web.ViewModels.AssetTagSettingsVm
@{
    ViewBag.Title = "Asset tag prefix";
}

@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Asset tag prefix",
    Subtitle = "Choose how new asset tags start. Existing tags stay as they are unless you rename them with the tool below; new assets use the prefix.",
    BackUrl = Url.Action("Index", "Settings"),
    BackLabel = "Back to Settings"
})

<p><a href="@Url.Action("AssetTagRename", "Settings")" class="btn btn-sm btn-outline-secondary">Rename existing tags to this format</a></p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card mb-3" id="levelPreviewCard">
    <div class="card-header">Three-level prefix preview (department room, department, sub-department)</div>
    <div class="card-body">
        @using (Html.BeginForm("AssetTags", "Settings", FormMethod.Get, new { id = "levelPreviewForm", @class = "row g-2 align-items-end" }))
        {
            <input type="hidden" name="levelPreview" value="true" />
            <div class="col-md-8">
                <label class="form-label" for="levelScopeId">Department, sub-department or room</label>
                <select class="form-select" id="levelScopeId" name="levelScopeId">
                    <option value="">Whole organisation</option>
                    @foreach (var row in Model.Rows)
                    {
                        <option value="@row.DepartmentId" @(Model.LevelScopeId == row.DepartmentId ? "selected" : null)>@row.Label@(row.IsRoom ? " [room]" : "")</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-primary w-100" id="levelPreviewBtn">Preview next tag</button>
            </div>
            @Html.Partial("_AssetTagLevelPreview", Model.Level, new ViewDataDictionary { { "part", "boxes" } })
        }
        <div class="mt-3">
            @Html.Partial("_AssetTagLevelPreview", Model.Level, new ViewDataDictionary { { "part", "columns" } })
        </div>
        <p class="text-muted small mb-0">Preview only: this does not save anything. To rename existing tags in this shape, use the rename tool with the same boxes and ticks.</p>
    </div>
</div>
@using (Html.BeginForm("AssetTags", "Settings", FormMethod.Post, new { id = "assetTagForm" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="card mb-3" id="sectionPrefixCard">
        <div class="card-header">Section prefixes (Prep / Senior school)</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="PrepPrefix">Prep prefix (optional)</label>
                    @Html.TextBoxFor(m => m.PrepPrefix, new { @class = "form-control text-uppercase", maxlength = "20", placeholder = "e.g. PP" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="SeniorPrefix">Senior school prefix (optional)</label>
                    @Html.TextBoxFor(m => m.SeniorPrefix, new { @class = "form-control text-uppercase", maxlength = "20", placeholder = "blank = as today" })
                </div>
                <div class="col-md-4">
                    <div class="form-text">With a Prep prefix of PP, a new asset in the Prep room Gala is tagged PP-GALA-001, so Prep tags never mix with Senior tags such as G2-G2A-001. A prefix set on a department, sub-department or room (the table below) still wins; a section prefix wins over the tenant-wide prefix. Blank = nothing changes. Existing tags are never changed here.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">Tenant default</div>
        <div class="card-body">
            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.Enabled, new { @class = "form-check-input", id = "tagEnabled" })
                <label class="form-check-label" for="tagEnabled">Generate structured tags (PREFIX-001, PREFIX-002, ...). Untick to keep the old random 10-character tags.</label>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="TenantPrefix">Tenant-wide prefix (optional)</label>
                    @Html.TextBoxFor(m => m.TenantPrefix, new { @class = "form-control text-uppercase", maxlength = "20", placeholder = "blank = DEPT-ROOM" })
                    <div class="form-text">Letters, digits and hyphens, up to 20. Leave blank to derive it from the department code plus the room code, e.g. SCI-LAB1-001.</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="previewDepartment">Preview the next tag for</label>
                    <div class="input-group">
                        <select id="previewDepartment" class="form-select">
                            <option value="">(no department)</option>
                            @foreach (var row in Model.Rows)
                            {
                                <option value="@row.DepartmentId">@row.Label@(row.IsRoom ? " [room]" : "")</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-primary" id="previewButton">Preview</button>
                    </div>
                    <div class="form-text" id="previewResult">Preview uses the saved settings and does not reserve a number.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Overrides (most specific wins: room, then nearest sub-department, then department, then the tenant default)</div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr><th>Department / room</th><th>Kind</th><th style="width:220px">Override prefix</th><th>Effective prefix (saved)</th><th>From</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Rows.Count; i++)
                    {
                        <tr>
                            <td style="padding-left:@(8 + Model.Rows[i].Depth * 18)px">
                                @Html.HiddenFor(m => m.Rows[i].DepartmentId)
                                @Model.Rows[i].Label
                            </td>
                            <td>@Model.Rows[i].KindLabel</td>
                            <td>@Html.TextBoxFor(m => m.Rows[i].Override, new { @class = "form-control form-control-sm text-uppercase", maxlength = "20", placeholder = "inherit" })</td>
                            <td><code>@Model.Rows[i].EffectivePrefix-###</code></td>
                            <td class="small text-muted">@Model.Rows[i].EffectiveSource</td>
                        </tr>
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted">No departments yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
}

@section scripts {
    <script>
        (function () {
            var button = document.getElementById('previewButton');
            var select = document.getElementById('previewDepartment');
            var result = document.getElementById('previewResult');
            button.addEventListener('click', function () {
                var url = '@Url.Action("AssetTagPreview", "Settings")' + (select.value ? '?departmentId=' + encodeURIComponent(select.value) : '');
                result.textContent = 'Loading...';
                fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.ok) { result.textContent = data.message || 'Preview failed.'; return; }
                        result.textContent = 'Next tag: ' + data.nextTag + ' (' + data.source + (data.sourceDepartment ? ': ' + data.sourceDepartment : '') + ')';
                    })
                    .catch(function () { result.textContent = 'Preview failed.'; });
            });
        })();
    </script>
}