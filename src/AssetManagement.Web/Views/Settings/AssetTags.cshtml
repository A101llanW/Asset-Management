@model AssetManagement.Web.ViewModels.AssetTagSettingsVm
@{
    ViewBag.Title = "Asset tag prefix";
    var triStates = new[] { new { V = "", T = "inherit" }, new { V = "true", T = "yes" }, new { V = "false", T = "no" } };
}

@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Asset tag prefix",
    Subtitle = "Choose how new asset tags start. Existing tags stay as they are unless you rename them with the tool below; new assets use the prefix.",
    BackUrl = Url.Action("Index", "Settings"),
    BackLabel = "Back to Settings"
})

<p><a href="@Url.Action("AssetTagRename", "Settings")" class="btn btn-sm btn-outline-secondary">Rename existing tags to this format</a></p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card mb-3" id="levelPreviewCard">
    <div class="card-header">Three-level prefix preview (department room, department, sub-department)</div>
    <div class="card-body">
        @using (Html.BeginForm("AssetTags", "Settings", FormMethod.Get, new { id = "levelPreviewForm", @class = "row g-2 align-items-end" }))
        {
            <input type="hidden" name="levelPreview" value="true" />
            <div class="col-md-8">
                <label class="form-label" for="levelScopeId">Department, sub-department or room</label>
                <select class="form-select" id="levelScopeId" name="levelScopeId">
                    <option value="">Whole organisation</option>
                    @foreach (var row in Model.Rows)
                    {
                        <option value="@row.DepartmentId" @(Model.LevelScopeId == row.DepartmentId ? "selected" : null)>@row.Label@(row.IsRoom ? " [room]" : "")</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-primary w-100" id="levelPreviewBtn">Preview next tag</button>
            </div>
            @Html.Partial("_AssetTagLevelPreview", Model.Level, new ViewDataDictionary { { "part", "boxes" } })
        }
        <div class="mt-3">
            @Html.Partial("_AssetTagLevelPreview", Model.Level, new ViewDataDictionary { { "part", "columns" } })
        </div>
        <p class="text-muted small mb-0">Preview only: this does not save anything. To rename existing tags in this shape, use the rename tool with the same boxes and ticks.</p>
    </div>
</div>
@using (Html.BeginForm("AssetTags", "Settings", FormMethod.Post, new { id = "assetTagForm" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="card mb-3" id="sectionPrefixCard">
        <div class="card-header">Section prefixes (Prep / Senior school)</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="PrepPrefix">Prep prefix (optional)</label>
                    @Html.TextBoxFor(m => m.PrepPrefix, new { @class = "form-control text-uppercase", maxlength = "20", placeholder = "e.g. PP" })
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="SeniorPrefix">Senior school prefix (optional)</label>
                    @Html.TextBoxFor(m => m.SeniorPrefix, new { @class = "form-control text-uppercase", maxlength = "20", placeholder = "blank = as today" })
                </div>
                <div class="col-md-4">
                    <div class="form-text">With a Prep prefix of PP, a new asset in the Prep room Gala is tagged PP-GALA-001, so Prep tags never mix with Senior tags such as G2-G2A-001. A prefix set on a department, sub-department or room (the table below) still wins; a section prefix wins over the tenant-wide prefix. Blank = nothing changes. Existing tags are never changed here.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">Tenant default</div>
        <div class="card-body">
            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.Enabled, new { @class = "form-check-input", id = "tagEnabled" })
                <label class="form-check-label" for="tagEnabled">Generate structured tags (PREFIX-001, PREFIX-002, ...) from the tenant-wide prefix or the segment switches below.</label>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="TenantPrefix">Tenant-wide prefix (optional)</label>
                    @Html.TextBoxFor(m => m.TenantPrefix, new { @class = "form-control text-uppercase", maxlength = "20", placeholder = "blank = DEPT-ROOM" })
                    <div class="form-text">Letters, digits and hyphens, up to 20. Leave blank to derive it from the department code plus the room code, e.g. SCI-LAB1-001.</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="previewDepartment">Preview the next tag for</label>
                    <div class="input-group">
                        <select id="previewDepartment" class="form-select">
                            <option value="">(no department)</option>
                            @foreach (var row in Model.Rows)
                            {
                                <option value="@row.DepartmentId">@row.Label@(row.IsRoom ? " [room]" : "")</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-primary" id="previewButton">Preview</button>
                    </div>
                    <div class="form-text" id="previewResult">Preview uses the saved settings and does not reserve a number.</div>
                </div>
            </div>
            <div class="mt-3">
                <div class="form-label mb-1">Segments used in derived tags (defaults; any department, sub-department or room below can change them for itself and everything under it)</div>
                <div class="form-check form-check-inline">
                    @Html.CheckBoxFor(m => m.UseDepartmentSegment, new { @class = "form-check-input js-tag-input", id = "useDeptSeg" })
                    <label class="form-check-label" for="useDeptSeg">Department code</label>
                </div>
                <div class="form-check form-check-inline">
                    @Html.CheckBoxFor(m => m.UseSubDepartmentSegment, new { @class = "form-check-input js-tag-input", id = "useSubSeg" })
                    <label class="form-check-label" for="useSubSeg">Sub-department code</label>
                </div>
                <div class="form-check form-check-inline">
                    @Html.CheckBoxFor(m => m.UseRoomSegment, new { @class = "form-check-input js-tag-input", id = "useRoomSeg" })
                    <label class="form-check-label" for="useRoomSeg">Room code</label>
                </div>
                <div class="form-text">Used only when no override box applies (an override is the whole prefix) and the tenant-wide prefix is blank. If every segment is off, the department code is used.</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Overrides (most specific wins: room, then nearest sub-department, then department, then the tenant default). Segment switches: "inherit" follows the parent, then the tenant default. Select a row to fill the boxes below it with their current effective prefixes.</div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr><th>Department / room</th><th>Kind</th><th style="width:200px">Override prefix</th><th title="Use the department code">Dept</th><th title="Use the sub-department code">Sub-dept</th><th title="Use the room code">Room</th><th>Effective prefix</th><th>From</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Rows.Count; i++)
                    {
                        <tr class="js-tag-row" data-id="@Model.Rows[i].DepartmentId" data-parent="@Model.Rows[i].ParentDepartmentId">
                            <td style="padding-left:@(8 + Model.Rows[i].Depth * 18)px">
                                @Html.HiddenFor(m => m.Rows[i].DepartmentId)
                                <a href="#" class="js-tag-select" title="Select: fill the boxes below with their effective prefixes">@Model.Rows[i].Label</a>
                            </td>
                            <td>@Model.Rows[i].KindLabel</td>
                            <td>@Html.TextBoxFor(m => m.Rows[i].Override, new { @class = "form-control form-control-sm text-uppercase js-tag-input js-tag-override", maxlength = "20", placeholder = Model.Rows[i].EffectivePrefix ?? "inherit" })</td>
                            @foreach (var seg in new[] { "UseDepartment", "UseSubDepartment", "UseRoom" })
                            {
                                var current = seg == "UseDepartment" ? Model.Rows[i].UseDepartment : seg == "UseSubDepartment" ? Model.Rows[i].UseSubDepartment : Model.Rows[i].UseRoom;
                                <td>
                                    <select name="Rows[@i].@seg" class="form-select form-select-sm js-tag-input" style="width:auto">
                                        @foreach (var t in triStates)
                                        {
                                            <option value="@t.V" @(string.Equals(current ?? "", t.V, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@t.T</option>
                                        }
                                    </select>
                                </td>
                            }
                            <td><code class="js-tag-effective">@Model.Rows[i].EffectivePrefix</code>-XXXXXX</td>
                            <td class="small text-muted js-tag-source">@Model.Rows[i].EffectiveSource</td>
                        </tr>
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="8" class="text-muted">No departments yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
}

@section scripts {
    <script>
        (function () {
            var button = document.getElementById('previewButton');
            var select = document.getElementById('previewDepartment');
            var result = document.getElementById('previewResult');
            button.addEventListener('click', function () {
                var url = '@Url.Action("AssetTagPreview", "Settings")' + (select.value ? '?departmentId=' + encodeURIComponent(select.value) : '');
                result.textContent = 'Loading...';
                fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.ok) { result.textContent = data.message || 'Preview failed.'; return; }
                        result.textContent = 'Next tag: ' + data.nextTag + ' (' + data.source + (data.sourceDepartment ? ': ' + data.sourceDepartment : '') + ')';
                    })
                    .catch(function () { result.textContent = 'Preview failed.'; });
            });

            // rel1018b: live effective prefixes for the unsaved form, and auto-fill of the boxes below a selected node.
            var form = document.getElementById('assetTagForm');
            var effectiveUrl = '@Url.Action("AssetTagEffective", "Settings")';
            var rows = Array.prototype.slice.call(document.querySelectorAll('.js-tag-row'));
            var byId = {};
            rows.forEach(function (r) { byId[r.getAttribute('data-id')] = r; });
            function descendants(id) {
                var out = [], stack = [id];
                while (stack.length) {
                    var cur = stack.pop();
                    rows.forEach(function (r) { if (r.getAttribute('data-parent') === cur) { out.push(r); stack.push(r.getAttribute('data-id')); } });
                }
                return out;
            }
            var pending = null, selectedId = null;
            function refresh() {
                return fetch(effectiveUrl, { method: 'POST', body: new FormData(form), credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.ok) { return; }
                        data.rows.forEach(function (x) {
                            var row = byId[String(x.id)];
                            if (!row) { return; }
                            row.querySelector('.js-tag-effective').textContent = x.prefix;
                            row.querySelector('.js-tag-source').textContent = x.source;
                            row.querySelector('.js-tag-override').placeholder = x.prefix;
                        });
                        if (selectedId) { fillBelow(selectedId); }
                    });
            }
            function fillBelow(id) {
                rows.forEach(function (r) { r.classList.remove('table-active'); });
                byId[id].classList.add('table-active');
                descendants(id).forEach(function (r) {
                    r.classList.add('table-active');
                    var box = r.querySelector('.js-tag-override');
                    // Shown as the box's grey value; it stays "inherit" (not saved as an override) unless you type in the box.
                    box.placeholder = r.querySelector('.js-tag-effective').textContent;
                });
            }
            form.addEventListener('change', function (e) {
                if (!e.target.classList.contains('js-tag-input')) { return; }
                clearTimeout(pending);
                pending = setTimeout(refresh, 250);
            });
            document.querySelectorAll('.js-tag-select').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    selectedId = a.closest('tr').getAttribute('data-id');
                    refresh();
                });
            });
        })();
    </script>
}