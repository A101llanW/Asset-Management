@model AssetManagement.Application.ViewModels.SettingsVm
@using System.Linq
@using System.Web.Mvc
@{
    ViewBag.Title = "Settings";
}

@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "System Settings",
    Subtitle = "Operational defaults, finance currency, and the approval matrix for requisitions, transfers, and disposals.",
    BackUrl = Url.Action("Index", "Dashboard"),
    BackLabel = "Back to Dashboard"
})

@using (Html.BeginForm("Index", "Settings", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="am-stagger">
    <div class="card card-kpi mb-3">
        <div class="card-header">Attachments</div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(m => m.AttachmentRootPath, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.AttachmentRootPath, new { @class = "form-control", placeholder = "~/App_Data/Attachments" })
            </div>
        </div>
    </div>

    <div class="card card-kpi mb-3">
        <div class="card-header">Notification Thresholds</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    @Html.LabelFor(m => m.WarrantyThresholdDays, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.WarrantyThresholdDays, new { @class = "form-control", type = "number", min = "0" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.InsuranceThresholdDays, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.InsuranceThresholdDays, new { @class = "form-control", type = "number", min = "0" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.MaintenanceThresholdDays, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.MaintenanceThresholdDays, new { @class = "form-control", type = "number", min = "0" })
                </div>
            </div>
        </div>
    </div>

    <div class="card card-kpi mb-3">
        <div class="card-header">Finance Defaults</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    @Html.LabelFor(m => m.DefaultCurrency, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.DefaultCurrency, new { @class = "form-control text-uppercase", maxlength = "10" })
                </div>
            </div>
            <p class="text-muted small mb-0 mt-3">Useful life defaults are configured per asset category and asset type by company administrators.</p>
        </div>
    </div>

    <div class="card card-kpi mb-3">
        <div class="card-header">Label printer (Zebra ZD421)</div>
        <div class="card-body">
            <p class="text-muted small">Configure the Zebra ZD4A042-30EM00EZ (ZD421, 203 dpi) for asset QR labels. Requires Zebra Browser Print on each print workstation.</p>
            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.LabelPrinter.Enabled, new { @class = "form-check-input", id = "labelPrinterEnabled" })
                @Html.LabelFor(m => m.LabelPrinter.Enabled, new { @class = "form-check-label", @for = "labelPrinterEnabled" })
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    @Html.LabelFor(m => m.LabelPrinter.Model, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.LabelPrinter.Model, new { @class = "form-control", @readonly = "readonly" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.LabelPrinter.Mode, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.LabelPrinter.Mode, new SelectList(new[]
                    {
                        new { Value = AssetManagement.Application.Helpers.LabelPrinterSettingsHelper.ModeZebraBrowserPrint, Text = "Zebra Browser Print" },
                        new { Value = AssetManagement.Application.Helpers.LabelPrinterSettingsHelper.ModeBrowser, Text = "Browser print only" }
                    }, "Value", "Text", Model.LabelPrinter.Mode), new { @class = "form-select" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.LabelPrinter.DeviceName, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.LabelPrinter.DeviceName, new { @class = "form-control", placeholder = "Optional Windows queue name" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.LabelPrinter.WidthMm, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.LabelPrinter.WidthMm, new { @class = "form-control", type = "number", min = "15", max = "104" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.LabelPrinter.HeightMm, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.LabelPrinter.HeightMm, new { @class = "form-control", type = "number", min = "6", max = "279" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.LabelPrinter.QrMagnification, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.LabelPrinter.QrMagnification, new { @class = "form-control", type = "number", min = "0.5", max = "10", step = "0.5" })
                    <div class="form-text">0.5 is the smallest printable size on Zebra printers.</div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <a href="@Url.Action("LabelDesigner", "Settings")" class="btn btn-outline-primary w-100">Design label layout</a>
                </div>
            </div>
            <p class="small mb-0 mt-2"><a href="@Url.Action("AssetTags", "Settings")">Asset tag prefix</a>: choose how new asset tags start (tenant default and department / sub-department / room overrides). <a href="@Url.Action("AssetTagRename", "Settings")">Rename existing tags</a> to the prefix format (old tags keep working; undo per batch).</p>
            <p class="text-muted small mb-0 mt-2">Use the label designer to choose fields, drag them into position, and preview how Zebra labels will print.</p>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.LabelPrinter.LayoutPreset, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.LabelPrinter.LayoutPreset, new SelectList(new[]
                    {
                        new { Value = AssetManagement.Application.Helpers.LabelPrinterSettingsHelper.LayoutCustom, Text = "Custom (label designer)" },
                        new { Value = AssetManagement.Application.Helpers.LabelPrinterSettingsHelper.LayoutQrWithMeta, Text = "QR + metadata" },
                        new { Value = AssetManagement.Application.Helpers.LabelPrinterSettingsHelper.LayoutQrCompact, Text = "QR compact" },
                        new { Value = AssetManagement.Application.Helpers.LabelPrinterSettingsHelper.LayoutQrOnly, Text = "QR only" }
                    }, "Value", "Text", Model.LabelPrinter.LayoutPreset), new { @class = "form-select" })
                </div>
            </div>
            <div class="alert alert-light border mt-3 mb-0 small">
                <strong>Workstation setup checklist</strong>
                <ol class="mb-0 mt-2 ps-3">
                    <li>Install the ZDesigner driver for ZD421 (203 dpi, thermal transfer).</li>
                    <li>Connect the ZD4A042-30EM00EZ via USB or Bluetooth and load matching label stock.</li>
                    <li>Install and start <a href="https://www.zebra.com/us/en/support-downloads/software/printer-software/browser-print.html" target="_blank" rel="noopener">Zebra Browser Print</a> on the print PC.</li>
                    <li>Calibrate media in the driver; match label width/height above to your stock.</li>
                    <li>Set the platform <strong>External base URL</strong> so QR codes scan from phones outside your LAN.</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="card card-kpi mb-3" id="settings-email-card">
        <div class="card-header">Email (SMTP)</div>
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <div>Outgoing email for this company: <strong>@(ViewBag.SmtpRouteSummary ?? "Platform default")</strong></div>
                <div class="small text-muted">Use your own mail server for sign-in codes, invitations, password resets and alerts, or keep the platform default.</div>
            </div>
            <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Email", "Settings")">Email settings</a>
        </div>
    </div>

    <div class="card card-kpi mb-3">
        <div class="card-header">Approval Matrix</div>
        <div class="card-body">
            @Html.Partial("_RequisitionWorkflowGuide")
            <p class="text-muted mb-3">Enable approval per process and assign an approver <strong>role</strong> for each stage (up to @AssetManagement.Application.ViewModels.ApprovalWorkflowSettingsHelper.MaxApprovalStages). Any active user with that role can act on pending items. Stage roles need matching permissions (for example <code>Purchases.Approve</code> for requisition approval). Changes apply to <strong>new</strong> requests only.</p>
            @Html.Partial("_ApprovalProcessMatrix", Model.ApprovalProcesses)
        </div>
    </div>
    @{
        var requisitionPolicies = ViewBag.RequisitionPolicies as AssetManagement.Application.ViewModels.RequisitionPolicySettingsVm;
        var catalogFlows = ViewBag.CatalogRequisitionFlows as System.Collections.Generic.IList<AssetManagement.Application.ViewModels.CatalogRequisitionFlowListItemVm>;
    }
    @if (requisitionPolicies != null)
    {
        <div class="card card-kpi mb-3" id="requisition-policies-card">
            <div class="card-header">Requisition classification &amp; approval paths</div>
            <div class="card-body">
                <p class="text-muted mb-3">Requisition lines can be classified with your existing asset categories, types and sub-types. A category, type or sub-type can carry its own approval path (set it on that item's Edit page under Asset Categories); otherwise the line follows the target department's flow.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="RequisitionPolicies_ClassificationMode">Line classification</label>
                        <select class="form-select" id="RequisitionPolicies_ClassificationMode" name="RequisitionPolicies.ClassificationMode">
                            <option value="Optional" @(requisitionPolicies.ClassificationMode == AssetManagement.Domain.Enums.RequisitionClassificationMode.Optional ? "selected=\"selected\"" : null)>Optional (description-only lines allowed)</option>
                            <option value="RequiredPerLine" @(requisitionPolicies.ClassificationMode == AssetManagement.Domain.Enums.RequisitionClassificationMode.RequiredPerLine ? "selected=\"selected\"" : null)>Required on every line (type or sub-type)</option>
                            <option value="RequiredHeader" @(requisitionPolicies.ClassificationMode == AssetManagement.Domain.Enums.RequisitionClassificationMode.RequiredHeader ? "selected=\"selected\"" : null)>Required once per requisition (applies to lines without their own pick)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="RequisitionPolicies_MixedFlowPolicy">Lines with different approval paths</label>
                        <select class="form-select" id="RequisitionPolicies_MixedFlowPolicy" name="RequisitionPolicies.MixedFlowPolicy">
                            <option value="AutoSplit" @(requisitionPolicies.MixedFlowPolicy == AssetManagement.Domain.Enums.RequisitionMixedFlowPolicy.AutoSplit ? "selected=\"selected\"" : null)>Split into one requisition per approval path (linked batch)</option>
                            <option value="Block" @(requisitionPolicies.MixedFlowPolicy == AssetManagement.Domain.Enums.RequisitionMixedFlowPolicy.Block ? "selected=\"selected\"" : null)>Block: the requester must submit them separately</option>
                        </select>
                    </div>
                </div>
                @if (!requisitionPolicies.IsStored)
                {
                    <div class="form-text">Defaults in use (Optional, Split). They are stored when you save this page.</div>
                }
                @if (catalogFlows != null && catalogFlows.Count > 0)
                {
                    <h6 class="mt-3 mb-2">Approval paths set on categories / types / sub-types</h6>
                    <ul class="list-unstyled small mb-0">
                        @foreach (var flowItem in catalogFlows)
                        {
                            var controllerName = flowItem.Scope == AssetManagement.Domain.Enums.CatalogFlowScope.Category ? "AssetCategories"
                                : flowItem.Scope == AssetManagement.Domain.Enums.CatalogFlowScope.Type ? "AssetTypes" : "AssetSubTypes";
                            <li>
                                <a href="@Url.Action("Edit", controllerName, new { id = flowItem.ScopedEntityId })">@flowItem.PathLabel</a>
                                <span class="text-muted">&mdash; @(flowItem.FlowMode == AssetManagement.Domain.Enums.RequisitionFlowMode.AutoApprove ? "Auto-approve" : flowItem.StageRoleIds.Count + " stage(s)")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
    </div>

    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = "Save Settings",
        BackUrl = Url.Action("Index", "Dashboard"),
        BackLabel = "Back to Dashboard"
    })
}
