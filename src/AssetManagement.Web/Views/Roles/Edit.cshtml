@using AssetManagement.Web.Helpers
@model AssetManagement.Application.ViewModels.RoleCreateEditVm
@{
    ViewBag.Title = "Edit Role";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Details", new { id = Model.Id });
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Edit Role",
    Subtitle = "Update module permissions so users can submit or approve requisitions and asset requests as intended.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Roles", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = Model.Name, Url = Url.Action("Details", new { id = Model.Id, returnUrl = Url.Action("Index") }) },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Edit Role" }
    }
})
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check">
                @if (Model.IsSystemRole)
                {
                    @Html.HiddenFor(m => m.IsActive)
                    <input type="checkbox" class="form-check-input" id="IsActiveDisplay" checked="@Model.IsActive" disabled="disabled" />
                    <label class="form-check-label" for="IsActiveDisplay">Active</label>
                    <div class="form-text">System roles cannot be deactivated.</div>
                }
                else
                {
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                    <div class="form-text">Users in an inactive role cannot sign in.</div>
                }
            </div>
        </div>
    </div>

    @if (ViewBag.RoleDepartmentAvailable is bool && (bool)ViewBag.RoleDepartmentAvailable && !Model.IsSystemRole)
    {
        <div class="row g-3 mt-0 mb-3">
            <div class="col-md-6">
                @Html.LabelFor(m => m.DepartmentId, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.DepartmentId, (IEnumerable<SelectListItem>)ViewBag.RoleDepartments, "All departments (organization-wide)", new { @class = "form-select" })
                <div class="form-text">Organization-wide roles are offered for every department on Invite user; a department role is offered only when that department is chosen.</div>
                @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger small" })
            </div>
        </div>
    }

    @Html.Partial("_RolePermissionMatrix", Model)

    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = "Update Role",
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}
