@using AssetManagement.Web.Helpers
@using System.Linq
@model AssetManagement.Application.ViewModels.RoleCreateEditVm
@{
    ViewBag.Title = "Create Role";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var roleTemplates = (Model.RoleTemplates ?? Enumerable.Empty<AssetManagement.Application.ViewModels.RoleTemplateVm>()).ToList();
    var copySourceRoles = (Model.CopySourceRoles ?? Enumerable.Empty<AssetManagement.Application.ViewModels.RolePermissionCopyVm>()).ToList();
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Create Role",
    Subtitle = "Combine module permissions into a reusable role. Roles appear as approval stage choices under Settings &rarr; Approval Matrix.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Roles", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Create Role" }
    }
})
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="card card-kpi mb-3">
        <div class="card-body">
            <h6 class="mb-3">How should permissions start?</h6>
            <div class="vstack gap-2">
                <div class="form-check">
                    <input class="form-check-input js-permission-start-mode" type="radio" name="permissionStartMode" id="permissionStartBlank" value="blank" checked="checked" />
                    <label class="form-check-label" for="permissionStartBlank">
                        <strong>Start from scratch</strong>
                        <span class="d-block small text-muted">Begin with an empty permission matrix and select each permission manually.</span>
                    </label>
                </div>
                @if (copySourceRoles.Any())
                {
                    <div class="form-check">
                        <input class="form-check-input js-permission-start-mode" type="radio" name="permissionStartMode" id="permissionStartRole" value="role" />
                        <label class="form-check-label" for="permissionStartRole">
                            <strong>Copy from an existing role</strong>
                            <span class="d-block small text-muted">Pre-fill the matrix from a role already in your organization, then adjust as needed.</span>
                        </label>
                    </div>
                    <div id="roleCopyPanel" class="ms-4 mt-1" hidden="hidden">
                        <label class="form-label" for="roleCopyPicker">Existing role</label>
                        <select id="roleCopyPicker" class="form-select" data-role-url="@Url.Action("RolePermissions", "Roles")">
                            <option value="">— Select a role —</option>
                            @foreach (var role in copySourceRoles)
                            {
                                <option value="@role.Id">@role.Name (@role.PermissionCount permissions)</option>
                            }
                        </select>
                    </div>
                }
                @if (roleTemplates.Any())
                {
                    <div class="form-check">
                        <input class="form-check-input js-permission-start-mode" type="radio" name="permissionStartMode" id="permissionStartTemplate" value="template" />
                        <label class="form-check-label" for="permissionStartTemplate">
                            <strong>Copy from a saved template</strong>
                            <span class="d-block small text-muted">Use a reusable permission set saved from a previous role.</span>
                        </label>
                    </div>
                    <div id="roleTemplatePanel" class="ms-4 mt-1" hidden="hidden">
                        <label class="form-label" for="roleTemplatePicker">Saved template</label>
                        <select id="roleTemplatePicker" class="form-select" data-template-url="@Url.Action("TemplatePermissions", "Roles")">
                            <option value="">— Select a template —</option>
                            @foreach (var template in roleTemplates)
                            {
                                <option value="@template.Id">@template.Name (@template.PermissionCount permissions)</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="form-text mt-3">You can still change individual permissions in the matrix below before saving the new role.</div>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
            </div>
        </div>
    </div>

    @Html.Partial("_RolePermissionMatrix", Model)

    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = "Create Role",
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}

@section Scripts {
    <script src="@Url.Content("~/Scripts/app/permissions.js")"></script>
    <script src="@Url.Content("~/Scripts/app/role-templates.js")"></script>
}
