@model AssetManagement.Web.ViewModels.AssetScanLookupPageVm
@using AssetManagement.Application.Helpers
@using System.Collections.Generic
@using System.Web.Mvc

@if (Model.CanBatchPrintLabels)
{
    var printLog = Model.PrintLog;
    var initialBatchJson = Model.InitialPrintBatch == null ? null
        : Newtonsoft.Json.JsonConvert.SerializeObject(AssetManagement.Web.Controllers.AssetLabelsController.ToJson(Model.InitialPrintBatch, true));
    <div class="card card-kpi border-0 shadow-sm am-scan-batch-print" data-am-scan-batch-panel
         data-print-log-record-url="@(printLog == null ? null : printLog.RecordPrintUrl)"
         data-print-log-create-batch-url="@(printLog == null ? null : printLog.CreateBatchUrl)"
         data-print-log-complete-batch-url="@(printLog == null ? null : printLog.CompleteBatchUrl)"
         data-am-print-initial-batch="@initialBatchJson"
         data-print-candidates-url="@Model.PrintCandidatesUrl"
         data-label-print-config-url-template="@Model.LabelPrintConfigUrl"
         data-label-zpl-url-template="@Model.LabelZplUrlTemplate"
         data-am-scan-batch-autoload="@(Model.InitialPurchaseId.HasValue ? "true" : "false")"
         data-am-scan-batch-classification="@(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ClassificationCatalog ?? new AssetManagement.Web.Helpers.ClassificationCatalog()))">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h5 class="mb-0">Bulk label print</h5>
                <p class="text-muted small mb-0 mt-1">Filter by purchase order, department, status or search, sort by entry date, assignment date or recent activity, then select assets by registration day and queue or print their labels.</p>
            </div>
            <span class="badge bg-primary am-scan-batch-queue-count" data-am-scan-batch-count>0 queued</span>
        </div>
        <div class="card-body">
            <span class="d-none" data-am-print-log-token="true">@Html.AntiForgeryToken()</span>
            @if (Model.InitialPrintBatch != null)
            {
                <div class="alert alert-info py-2 small mb-3" role="status" data-am-print-initial-batch-notice>
                    Batch <strong>#@Model.InitialPrintBatch.Id</strong> (@Model.InitialPrintBatch.GroupLabel) from the Asset register is in the print queue:
                    @Model.InitialPrintBatch.Items.Count label(s). Check the code type and template, then select <strong>Print queue to Zebra</strong>.
                </div>
            }
            else if (Model.InitialPrintBatchMissing)
            {
                <div class="alert alert-warning py-2 small mb-3" role="status">
                    That print batch was not found, was cleared, or has no active assets left. Nothing was queued.
                </div>
            }
            @if (Model.InitialPurchaseId.HasValue)
            {
                <div class="alert alert-info py-2 small mb-3" role="status" data-am-scan-batch-po-notice>
                    Showing every asset received on <strong>@Model.InitialPurchaseLabel</strong>, assigned or not. Change the purchase order filter to see other assets.
                </div>
            }
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="amScanBatchPurchase">Purchase order</label>
                    <select class="form-select form-select-sm" id="amScanBatchPurchase" data-am-scan-batch-po>
                        @foreach (var option in Model.PurchaseOptions ?? new List<SelectListItem>())
                        {
                            <option value="@option.Value" @(option.Selected ? "selected" : null)>@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="amScanBatchDepartment">Department</label>
                    <select class="form-select form-select-sm" id="amScanBatchDepartment" data-am-scan-batch-dept>
                        @foreach (var option in Model.DepartmentOptions ?? new List<SelectListItem>())
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="amScanBatchStatus">Status</label>
                    <select class="form-select form-select-sm" id="amScanBatchStatus" data-am-scan-batch-status>
                        @foreach (var option in Model.StatusOptions ?? new List<SelectListItem>())
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="amScanBatchSearch">Search</label>
                    <input type="text" class="form-control form-control-sm" id="amScanBatchSearch" data-am-scan-batch-search
                           placeholder="Tag, name, serial..." autocomplete="off" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-outline-primary w-100" data-am-scan-batch-load>Load assets</button>
                </div>
            </div>

            <div class="row g-3 align-items-end mb-3" data-am-scan-batch-class-filters>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="amScanBatchCategory">Category</label>
                    <select class="form-select form-select-sm" id="amScanBatchCategory" data-am-scan-batch-category>
                        <option value="">All categories</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="amScanBatchType">Type</label>
                    <select class="form-select form-select-sm" id="amScanBatchType" data-am-scan-batch-type>
                        <option value="">All types</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="amScanBatchSubType">Sub-type</label>
                    <select class="form-select form-select-sm" id="amScanBatchSubType" data-am-scan-batch-subtype>
                        <option value="">All sub-types</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox" id="amScanBatchIncludeSub" data-am-scan-batch-include-sub checked />
                        <label class="form-check-label small" for="amScanBatchIncludeSub">Include sub-departments, classes and rooms under the chosen department</label>
                    </div>
                </div>
            </div>

            <div class="row g-3 align-items-end mb-3" data-am-scan-batch-date-filters>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="amScanBatchSort">Sort by</label>
                    <select class="form-select form-select-sm" id="amScanBatchSort" data-am-scan-batch-sort>
                        <option value="created|desc" selected>Date of entry (newest first)</option>
                        <option value="created|asc">Date of entry (oldest first)</option>
                        <option value="activity|desc">Recent activity (newest first)</option>
                        <option value="activity|asc">Recent activity (oldest first)</option>
                        <option value="assigned|desc">Assignment date (newest first)</option>
                        <option value="assigned|asc">Assignment date (oldest first)</option>
                        <option value="tag|asc">Asset tag (A-Z)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="amScanBatchDateField">Date range on</label>
                    <select class="form-select form-select-sm" id="amScanBatchDateField" data-am-scan-batch-date-field>
                        <option value="created">Date of entry</option>
                        <option value="assigned">Assignment date</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="amScanBatchFrom">From</label>
                    <input type="date" class="form-control form-control-sm" id="amScanBatchFrom" data-am-scan-batch-from />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="amScanBatchTo">To</label>
                    <input type="date" class="form-control form-control-sm" id="amScanBatchTo" data-am-scan-batch-to />
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1" for="amScanBatchTake" title="Most recent N (max 100)">Max</label>
                    <input type="number" class="form-control form-control-sm" id="amScanBatchTake" data-am-scan-batch-take min="1" max="100" value="@(Model.InitialPurchaseId.HasValue ? 100 : 50)" />
                </div>
                <div class="col-md-2 d-flex flex-wrap gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-scan-batch-preset="today">Today</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-scan-batch-preset="7">7 days</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-scan-batch-preset="30">30 days</button>
                    <button type="button" class="btn btn-sm btn-link p-0" data-am-scan-batch-preset="clear">Clear dates</button>
                </div>
            </div>

            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="amScanBatchCodeType">Code type</label>
                    <select class="form-select form-select-sm" id="amScanBatchCodeType" data-am-scan-batch-code-type>
                        <option value="@LabelPrinterSettingsHelper.CodeTypeQr">QR code</option>
                        <option value="@LabelPrinterSettingsHelper.CodeTypeBarcode">Barcode</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="amScanBatchTemplate" title="Saved in Settings > Label designer">Label template</label>
                    <select class="form-select form-select-sm" id="amScanBatchTemplate" data-am-scan-batch-template>
                        @if (Model.LabelTemplateOptions == null || Model.LabelTemplateOptions.Count == 0)
                        {
                            <option value="" selected>@AssetManagement.Web.Helpers.LabelPrintSupport.ActiveLayoutText</option>
                        }
                        else
                        {
                            foreach (var option in Model.LabelTemplateOptions)
                            {
                                <option value="@option.Value" @(option.Selected ? "selected" : null)>@option.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-7 d-flex flex-wrap gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-scan-batch-select-all disabled>Select all loaded</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-scan-batch-add-all disabled>Add all loaded to queue</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-am-scan-batch-add-selected disabled>Queue selected</button>
                    <button type="button" class="btn btn-sm btn-primary" data-am-scan-batch-print-selected-qr disabled title="Adds the selected assets to the queue and prints the queue as QR labels">Print selected QR codes</button>
                    <button type="button" class="btn btn-sm btn-success" data-am-scan-batch-run-print disabled>Print queue to Zebra</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-am-scan-batch-clear disabled>Clear queue</button>
                </div>
            </div>

            @Html.Partial("~/Views/Assets/_AssetLabelPrinterStatus.cshtml")

            <div class="am-scan-batch-progress d-none mb-3" data-am-scan-batch-progress role="status" aria-live="polite">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 small mb-1">
                    <span data-am-scan-batch-progress-text>Printing...</span>
                    <span data-am-scan-batch-progress-count>0 / 0</span>
                </div>
                <div class="progress mb-2" style="height:6px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" data-am-scan-batch-progress-bar style="width:0%;"></div>
                </div>
                <div class="d-flex flex-wrap gap-2" data-am-scan-batch-print-controls>
                    <button type="button" class="btn btn-sm btn-outline-warning d-none" data-am-scan-batch-pause>Pause</button>
                    <button type="button" class="btn btn-sm btn-outline-primary d-none" data-am-scan-batch-resume>Resume</button>
                    <button type="button" class="btn btn-sm btn-outline-danger d-none" data-am-scan-batch-stop>Stop</button>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-7">
                    <div class="am-scan-batch-candidates" data-am-scan-batch-candidates>
                        <p class="text-muted small mb-0">Use the filters above and select Load assets.</p>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="am-scan-batch-queue-panel border rounded p-3 bg-light">
                        <h6 class="mb-2">Print queue</h6>
                        <ul class="list-unstyled mb-0 am-scan-batch-queue-list" data-am-scan-batch-queue>
                            <li class="text-muted small" data-am-scan-batch-queue-empty>No labels queued yet.</li>
                        </ul>
                    </div>
                </div>
            </div>

            @if (printLog != null)
            {
                @* rel1022a: print batch log. Collapsed (and not loaded) until the user opens it. *@
                <div class="am-print-batch-log border rounded mt-3" data-am-print-batch-log
                     data-batches-url="@printLog.BatchesUrl"
                     data-batch-items-url="@printLog.BatchItemsUrl"
                     data-clear-batch-url="@printLog.ClearBatchUrl">
                    <button type="button" class="btn btn-link btn-sm text-decoration-none w-100 text-start px-3 py-2 collapsed"
                            data-bs-toggle="collapse" data-bs-target="#amPrintBatchLogBody" aria-expanded="false" aria-controls="amPrintBatchLogBody">
                        <strong>Print batch log</strong>
                        <span class="text-muted small ms-1">Groups sent to printing: reprint a group or clear its entry</span>
                    </button>
                    <div class="collapse" id="amPrintBatchLogBody" data-am-print-batch-log-body>
                        <div class="px-3 pb-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <div class="form-check small mb-0">
                                    <input class="form-check-input" type="checkbox" id="amPrintBatchLogShowCleared" data-am-print-batch-log-show-cleared />
                                    <label class="form-check-label" for="amPrintBatchLogShowCleared">Show cleared entries</label>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-am-print-batch-log-refresh>Refresh</button>
                            </div>
                            <div class="small" data-am-print-batch-log-status role="status" aria-live="polite"></div>
                            <div data-am-print-batch-log-list>
                                <p class="text-muted small mb-0">Open this panel to load the batch log.</p>
                            </div>
                            <p class="text-muted small mt-2 mb-0">Clearing hides the entry only. Every printed label stays on its asset's audit trail. Times in @KenyaTimeHelper.DisplayAbbreviation.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
