@using System.Globalization
@model AssetManagement.Application.ViewModels.AssetSubTypeEditVm
@{
    ViewBag.Title = "Edit Asset Sub-Type";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Details", "AssetTypes", new { id = Model.AssetTypeId });
    var organizationCurrency = ViewBag.OrganizationCurrency as string ?? "KES";
    var defaultCostDisplay = Model.DefaultAcquisitionCost.HasValue
        ? Model.DefaultAcquisitionCost.Value.ToString("N2", CultureInfo.GetCultureInfo("en-KE"))
        : string.Empty;
    var subTypeAssetCount = ViewBag.SubTypeAssetCount as int? ?? 0;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = Model.Name,
    Subtitle = "Update the exact item definition used for stock grouping.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Asset Types", Url = Url.Action("Index", "AssetTypes") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = ViewBag.AssetTypeName as string, Url = Url.Action("Details", "AssetTypes", new { id = Model.AssetTypeId }) },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = Model.Name }
    }
})
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.AssetTypeId)
    @Html.HiddenFor(m => m.PreviousDefaultAcquisitionCost)
    @Html.HiddenFor(m => m.AcquisitionCostApplyScope)
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="card card-kpi mb-3">
        <div class="card-header">Stock</div>
        <div class="card-body">
            <p class="mb-0">Current stock: <strong>@ViewBag.StockCount</strong></p>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-12">
            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.Brand, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Brand, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Brand, "", new { @class = "text-danger" })
            <div class="form-text">Optional manufacturer name.</div>
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.ItemModel, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.ItemModel, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ItemModel, "", new { @class = "text-danger" })
            <div class="form-text">Optional model or variant code.</div>
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.Sku, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Sku, new { @class = "form-control" })
        </div>
        <div class="col-md-12">
            @Html.LabelFor(m => m.Specifications, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Specifications, new { @class = "form-control", rows = "3" })
        </div>
        <div class="col-md-4">
            <label class="form-label" for="DefaultAcquisitionCost">Default acquisition cost (@organizationCurrency)</label>
            <input type="text"
                   class="form-control"
                   id="DefaultAcquisitionCost"
                   name="DefaultAcquisitionCost"
                   value="@defaultCostDisplay"
                   data-monetary-input="true"
                   inputmode="decimal"
                   placeholder="Optional" />
            @Html.ValidationMessageFor(m => m.DefaultAcquisitionCost, "", new { @class = "text-danger" })
            <div class="form-text">Suggested price for new assets of this sub-type. Existing assets are unchanged unless you choose to apply it on save.</div>
        </div>
        <div class="col-md-12">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
            </div>
        </div>
    </div>
    @Html.Partial("_FormActions", new AssetManagement.Web.ViewModels.FormActionsViewModel
    {
        SubmitLabel = "Save Sub-Type",
        BackUrl = returnUrl,
        BackLabel = "Back"
    })
}

<div class="modal fade" id="amSubTypeDefaultCostModal" tabindex="-1" aria-labelledby="amSubTypeDefaultCostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="amSubTypeDefaultCostModalLabel">Apply default price</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">You changed the default acquisition cost for this sub-type. Choose whether to update existing assets too.</p>
                <div class="vstack gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="amSubTypeDefaultCostScope" id="amSubTypeDefaultCostIndividual" value="individual" checked="checked" />
                        <label class="form-check-label" for="amSubTypeDefaultCostIndividual">
                            <strong>Default only</strong>
                            <span class="d-block text-muted small">Save the sub-type default. Do not change asset prices.</span>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="amSubTypeDefaultCostScope" id="amSubTypeDefaultCostSubType" value="subtype" />
                        <label class="form-check-label" for="amSubTypeDefaultCostSubType">
                            <strong>Default and all assets</strong>
                            <span class="d-block text-muted small"><span id="amSubTypeDefaultCostAssetCount"></span></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="amSubTypeDefaultCostConfirmBtn">Save</button>
            </div>
        </div>
    </div>
</div>
<script>
    window.amSubTypeDefaultCostConfig = { assetCount: @subTypeAssetCount };
</script>
<script src="@Url.Content("~/Scripts/app/asset-monetary-input.js")"></script>
<script src="@Url.Content("~/Scripts/app/asset-subtype-default-cost.js")"></script>
