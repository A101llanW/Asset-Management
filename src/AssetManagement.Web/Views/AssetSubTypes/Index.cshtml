@model IList<AssetManagement.Application.ViewModels.AssetSubTypeIndexItemVm>
@using System.Collections.Generic
@using System.Linq
@{
    ViewBag.Title = "Asset Sub-Types";
    var assetTypes = ViewBag.AssetTypes as SelectList;
    var search = ViewBag.Search as string;
    var activeOnly = ViewBag.ActiveOnly as bool? ?? true;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Asset Sub-Types",
    Subtitle = "Browse exact item variants (brand/model) under each asset type. Edit from this list or create under a chosen type.",
    PrimaryActionUrl = Url.Action("Create"),
    PrimaryActionLabel = "Create Sub-Type"
})
<form class="am-list-toolbar" method="get">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" class="form-control" name="search" placeholder="Search name, brand, model, or SKU" value="@search" />
        </div>
        <div class="col-md-3">
            @Html.DropDownList("assetTypeId", assetTypes, "All asset types", new { @class = "form-select" })
        </div>
        <div class="col-md-3">
            <select class="form-select" name="activeOnly">
                @if (activeOnly)
                {
                    <option value="true" selected="selected">Active only</option>
                    <option value="false">Include inactive</option>
                }
                else
                {
                    <option value="true">Active only</option>
                    <option value="false" selected="selected">Include inactive</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
        </div>
    </div>
</form>
@if (Model == null || !Model.Any())
{
    <div class="card card-kpi">
        <div class="card-body am-empty-state">
            <h5>No asset sub-types yet</h5>
            <p class="text-muted mb-3">Create a sub-type under an asset type so assets can pick an exact brand/model variant.</p>
            <a class="btn btn-primary" href="@Url.Action("Create")">Create Sub-Type</a>
        </div>
    </div>
}
else
{
    <div class="card card-kpi">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sub-type</th>
                        <th>Brand / Model</th>
                        <th>Asset type</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Brand) && string.IsNullOrWhiteSpace(item.Model) ? "—" : ((item.Brand ?? "") + " " + (item.Model ?? "")).Trim())</td>
                            <td>@(item.AssetTypeName ?? ("#" + item.AssetTypeId))</td>
                            <td>@(item.AssetCategoryName ?? "—")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.Id })">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
