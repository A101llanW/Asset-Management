@model AssetManagement.Application.ViewModels.PurchaseRecordVm
@using System
@using System.Linq
@using AssetManagement.Web.Helpers
@{
    ViewBag.Title = "Purchase Details";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var receiveDetail = ViewBag.ReceiveDetail as AssetManagement.Application.ViewModels.PurchaseReceiveDetailVm;
    var orderStatus = ViewBag.OrderStatus as AssetManagement.Application.ViewModels.PurchaseOrderStatusVm;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = string.IsNullOrWhiteSpace(Model.PurchaseOrderNumber) ? "Purchase Record" : "PO " + Model.PurchaseOrderNumber,
    Subtitle = "Purchase summary and supplier-linked procurement details.",
    BackUrl = returnUrl,
    BackLabel = "Back",
    Breadcrumbs = new[]
    {
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = "Purchases", Url = Url.Action("Index") },
        new AssetManagement.Web.ViewModels.BreadcrumbItemViewModel { Label = string.IsNullOrWhiteSpace(Model.PurchaseOrderNumber) ? "Purchase Record" : "PO " + Model.PurchaseOrderNumber }
    }
})

@{
    var tempCreatedIds = (TempData["CreatedAssetIds"] as string ?? "")
        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => x.Length > 0)
        .ToList();
    var persistentIds = (ViewBag.AssignableAssetIds as System.Collections.Generic.IList<int>)
        ?? new System.Collections.Generic.List<int>();
    var assignIds = tempCreatedIds.Count > 0
        ? tempCreatedIds
        : persistentIds.Select(x => x.ToString()).ToList();
    var showFreshReceiveBanner = tempCreatedIds.Count > 0;
    var receivedAssetCount = ViewBag.ReceivedAssetCount is int ? (int)ViewBag.ReceivedAssetCount : 0;
    // rel1014a: opens Bulk Label Print filtered (?purchaseId=) to ALL assets received on this purchase, assigned ones included.
    var canSendToBulkPrint = (receivedAssetCount > 0 || tempCreatedIds.Count > 0) && Html.HasPermission("Assets.View");
    var bulkPrintUrl = canSendToBulkPrint ? Url.Action("BulkPrint", "AssetLabels", new { purchaseId = Model.Id }) : null;
}
@if (assignIds.Count > 0)
{
    <div class="alert @(showFreshReceiveBanner ? "alert-success" : "alert-info") mt-3" role="alert">
        <div class="fw-semibold mb-2">@(showFreshReceiveBanner ? "New assets ready for labeling" : "Received units ready to assign")</div>
        @if (showFreshReceiveBanner)
        {
            <p class="mb-2 small">QR codes on printed labels link to each asset&rsquo;s registry record (tag and serial).</p>
        }
        else
        {
            <p class="mb-2 small">In-store unassigned assets from this purchase can be assigned now (same grid as Assets Index).</p>
        }
        @if (Html.HasPermission("Assets.Assign") || canSendToBulkPrint)
        {
            <div class="mb-3 d-flex flex-wrap gap-2">
                @if (Html.HasPermission("Assets.Assign"))
                {
                    <a class="btn btn-primary btn-sm am-click-spark" href="@Url.Action("BatchCreate", "Assignments", new { assetIds = string.Join(",", assignIds), returnUrl = Request.RawUrl })">Assign these units</a>
                }
                @if (canSendToBulkPrint)
                {
                    <a class="btn btn-outline-primary btn-sm" href="@bulkPrintUrl" data-am-send-to-bulk-print title="Open Bulk Label Print with every asset received on this purchase (assigned ones included)">Send to Bulk Label Print</a>
                }
            </div>
        }
        <ul class="mb-0">
            @foreach (var idText in assignIds)
            {
                int assetId;
                if (int.TryParse(idText.Trim(), out assetId))
                {
                    <li>
                        <a href="@Url.Action("Details", "Assets", new { id = assetId })">View asset</a>
                        &middot;
                        <a href="@Url.Action("PrintLabel", "Assets", new { id = assetId })" target="_blank" rel="noopener">Print label</a>
                    </li>
                }
            }
        </ul>
    </div>
}
else if (canSendToBulkPrint)
{
    <div class="alert alert-light border mt-3 d-flex flex-wrap align-items-center justify-content-between gap-2" role="status">
        <div class="small"><span class="fw-semibold">Received units</span> &middot; @receivedAssetCount asset(s) received on this purchase. All are assigned or out of store.</div>
        <a class="btn btn-outline-primary btn-sm" href="@bulkPrintUrl" data-am-send-to-bulk-print title="Open Bulk Label Print with every asset received on this purchase (assigned ones included)">Send to Bulk Label Print</a>
    </div>
}

<div class="card card-kpi">
    <div class="card-header">Purchase Summary</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-muted small">Supplier</div>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.SupplierName) ? "Not set" : Model.SupplierName)</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Invoice Number</div>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.InvoiceNumber) ? "Not set" : Model.InvoiceNumber)</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Purchase Date</div>
                <div class="fw-semibold">@Model.PurchaseDate.ToString("yyyy-MM-dd")</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Quantity</div>
                <div class="fw-semibold">@Model.Quantity</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Unit Cost</div>
                <div class="fw-semibold">@Html.FormatCurrency(Model.UnitCost)</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Total Cost</div>
                <div class="fw-semibold">@Html.FormatCurrency(Model.TotalCost)</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Currency</div>
                <div class="fw-semibold">@Model.Currency</div>
            </div>
            <div class="col-md-6 mt-2" id="po-requisition-link">
                <div class="text-muted small">Linked requisition</div>
                @if (Model.PurchaseRequestId.HasValue)
                {
                    <a href="@Url.Action("Details", "PurchaseRequests", new { id = Model.PurchaseRequestId.Value, returnUrl = Request.RawUrl })">@(string.IsNullOrWhiteSpace(Model.PurchaseRequestNumber) ? ("Request #" + Model.PurchaseRequestId) : Model.PurchaseRequestNumber)</a>
                }
                else
                {
                    <span class="text-muted" id="po-not-linked">Not linked</span> <span class="small text-muted">(legacy purchase record)</span>
                }
            </div>
            @if (orderStatus != null)
            {
                <div class="col-md-6 mt-2">
                    <div class="text-muted small">Receipt status</div>
                    <span class="badge bg-light text-dark border" id="po-receipt-status">@orderStatus.Status</span>
                </div>
            }
        </div>
    </div>
</div>

@if (orderStatus != null && orderStatus.Lines.Count > 0)
{
    <div class="card card-kpi mt-3" id="po-lines-card">
        <div class="card-header">Order lines@(orderStatus.IsLegacy ? " (legacy purchase record: one line)" : "")</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>#</th><th>Item</th><th>Classification</th><th class="text-end">Ordered</th><th class="text-end">Received</th><th class="text-end">Outstanding</th><th class="text-end">Unit cost</th></tr></thead>
                <tbody>
                @foreach (var line in orderStatus.Lines)
                {
                    <tr>
                        <td>@line.LineNumber</td>
                        <td>@line.Description</td>
                        <td class="small">
                            @if (line.HasClassification)
                            {
                                @(string.Join(" > ", new[] { line.AssetCategoryName, line.AssetTypeName, line.AssetSubTypeName }.Where(x => !string.IsNullOrWhiteSpace(x))))
                            }
                            else
                            {
                                <span class="text-muted">Chosen when receiving</span>
                            }
                        </td>
                        <td class="text-end">@line.Ordered</td>
                        <td class="text-end">@line.Received</td>
                        <td class="text-end fw-semibold">@line.Outstanding</td>
                        <td class="text-end">@Html.FormatCurrency(line.UnitCost)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (receiveDetail != null)
{
    <div class="card card-kpi mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Receiving</span>
            @if (Html.HasPermission("Assets.Receive") && receiveDetail.RemainingQuantity > 0)
            {
                <a class="btn btn-sm btn-primary" href="@Url.Action("Receive", new { id = Model.Id, assetId = receiveDetail.SuggestedAssetId, returnUrl = Request.RawUrl })">Receive Asset</a>
            }
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="text-muted small">Received</div>
                    <div class="fw-semibold">@receiveDetail.QuantityReceived / @receiveDetail.PurchaseQuantity</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Remaining</div>
                    <div class="fw-semibold">@receiveDetail.RemainingQuantity</div>
                </div>
            </div>
            @if (receiveDetail.Receivings != null && receiveDetail.Receivings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Asset</th>
                                <th>Received</th>
                                <th>Qty</th>
                                <th>Condition</th>
                                <th>Received By</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in receiveDetail.Receivings)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Details", "Assets", new { id = line.AssetId, returnUrl = Request.RawUrl })">@line.AssetTag</a>
                                    <div class="text-muted small">@line.AssetName</div>
                                </td>
                                <td>@line.ReceivedDate.ToString("yyyy-MM-dd")</td>
                                <td>@line.QuantityReceived</td>
                                <td>@(string.IsNullOrWhiteSpace(line.ConditionOnReceipt) ? DisplayText.Empty : line.ConditionOnReceipt)</td>
                                <td>@(string.IsNullOrWhiteSpace(line.ReceivedById) ? DisplayText.Empty : line.ReceivedById)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No receiving lines recorded yet.</p>
            }
        </div>
    </div>
}
