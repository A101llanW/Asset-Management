@model AssetManagement.Application.ViewModels.ReceiveOrderVm
@using System.Linq
@using AssetManagement.Domain.Enums
@using AssetManagement.Application.ViewModels
@{
    ViewBag.Title = "Receive Goods";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Details", new { id = Model.PurchaseRecordId });
    var departmentTree = ViewBag.DepartmentTree as SelectList;
    var departmentItems = departmentTree == null ? new System.Collections.Generic.List<SelectListItem>() : departmentTree.Cast<SelectListItem>().ToList();
    var typeOptions = ViewBag.LineTypeOptions as System.Collections.Generic.IList<AssetClassOptionVm> ?? new System.Collections.Generic.List<AssetClassOptionVm>();
    var subTypeOptions = ViewBag.LineSubTypeOptions as System.Collections.Generic.IList<AssetClassOptionVm> ?? new System.Collections.Generic.List<AssetClassOptionVm>();
    var conditionNames = System.Enum.GetNames(typeof(AssetCondition));
    var poLabel = string.IsNullOrWhiteSpace(Model.PurchaseOrderNumber) ? ("#" + Model.PurchaseRecordId) : Model.PurchaseOrderNumber;
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Receive Goods - PO " + poLabel,
    Subtitle = "Ordered " + Model.Ordered + " \u00B7 received " + Model.Received + " \u00B7 outstanding " + Model.Outstanding + " \u00B7 " + Model.Status,
    BackUrl = returnUrl,
    BackLabel = "Back to Purchase"
})

<div class="card card-kpi mb-3">
    <div class="card-body row g-3 small">
        <div class="col-md-3"><div class="text-muted">Supplier</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.SupplierName) ? "Not set" : Model.SupplierName)</div></div>
        <div class="col-md-3">
            <div class="text-muted">Requisition</div>
            @if (Model.PurchaseRequestId.HasValue)
            {
                <a class="fw-semibold" href="@Url.Action("Details", "PurchaseRequests", new { id = Model.PurchaseRequestId.Value, returnUrl = Request.RawUrl })">@(string.IsNullOrWhiteSpace(Model.PurchaseRequestNumber) ? ("#" + Model.PurchaseRequestId) : Model.PurchaseRequestNumber)</a>
            }
            else
            {
                <span class="text-muted">Not linked (legacy purchase record)</span>
            }
        </div>
        <div class="col-md-3"><div class="text-muted">Requisition destination</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.RequisitionDepartmentName) ? "None" : Model.RequisitionDepartmentName)</div></div>
        <div class="col-md-3"><div class="text-muted">Status</div><span class="badge bg-light text-dark border" id="receive-po-status">@Model.Status</span></div>
    </div>
</div>

@using (Html.BeginForm("Receive", "Purchases", FormMethod.Post, new { id = "receive-order-form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PurchaseRecordId)
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", id = "receive-errors" })
    if (Model.IsRequisitionOverOrdered)
    {
        <div class="alert alert-warning" id="receive-over-ordered">
            <strong>Over-ordered requisition.</strong>
            @(string.IsNullOrWhiteSpace(Model.PurchaseRequestNumber) ? ("#" + Model.PurchaseRequestId) : Model.PurchaseRequestNumber)
            requested @Model.RequisitionQuantity but @Model.RequisitionOrderedQuantity are on order
            (@(Model.RequisitionOrderedQuantity - Model.RequisitionQuantity) more than requested). Check with purchasing before receiving the extra units.
        </div>
    }

    for (var i = 0; i < Model.Lines.Count; i++)
    {
        var line = Model.Lines[i];
        var isDepartment = string.Equals(line.DestinationKind, ReceiveOrderLineVm.DestinationDepartment, System.StringComparison.OrdinalIgnoreCase);
        var enterTags = string.Equals(line.TagMode, ReceiveOrderLineVm.TagModeEnter, System.StringComparison.OrdinalIgnoreCase);
        <div class="card card-kpi mb-3 am-receive-line" data-am-line-index="@i" data-am-outstanding="@line.Outstanding">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><strong>#@line.LineNumber</strong> @line.Description</span>
                <span class="small">Ordered <strong>@line.Ordered</strong> &middot; received <strong>@line.Received</strong> &middot; outstanding <strong class="am-outstanding">@line.Outstanding</strong></span>
            </div>
            <div class="card-body">
                <input type="hidden" name="Lines[@i].PurchaseOrderLineId" value="@line.PurchaseOrderLineId" />
                <input type="hidden" name="Lines[@i].LineNumber" value="@line.LineNumber" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label mb-1" for="receive-item-name-@i">Asset name <span class="text-danger" title="Required">*</span></label>
                        <input type="text" class="form-control am-receive-item-name" id="receive-item-name-@i" name="Lines[@i].ItemName"
                               value="@line.ItemName" required="required" maxlength="@AssetManagement.Application.Helpers.AssetNameRules.MaxLength" />
                        <div class="form-text">Every unit received on this line becomes a new asset with this name (from the requisition; edit if needed).</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label mb-1">Category / type / sub-type <span class="text-danger" title="Required">*</span></label>
                        @if (!line.NeedsClassification)
                        {
                            <div class="form-control-plaintext py-0 fw-medium am-classification-readonly">
                                @(string.Join(" > ", new[] { line.AssetCategoryName, line.AssetTypeName, line.AssetSubTypeName }.Where(x => !string.IsNullOrWhiteSpace(x))))
                                @if (line.TypeHasNoSubTypes)
                                {
                                    <span class="text-danger small d-block am-subtype-none-defined">This asset type has no sub-types yet. Add one under Asset Categories before receiving: every received asset needs a sub-type.</span>
                                }
                                <span class="text-muted small d-block">From: @(line.ClassificationSourceLabel ?? "purchase order")</span>
                            </div>
                            if (line.NeedsSubType)
                            {
                                <label class="form-label mt-2 mb-1" for="receive-subtype-@i">Sub-type <span class="text-danger" title="Required">*</span></label>
                                <select class="form-select am-po-subtype am-required-subtype" id="receive-subtype-@i" name="Lines[@i].OverrideAssetSubTypeId" data-am-type-id="@line.AssetTypeId" data-am-subtype-required="true" required="required" aria-label="Sub-type (required)">
                                    <option value="">-- Sub-type (required) --</option>
                                    @foreach (var st in subTypeOptions.Where(s => line.AssetTypeId.HasValue && s.ParentId == line.AssetTypeId.Value))
                                    {
                                        if (line.OverrideAssetSubTypeId == st.Id)
                                        {
                                            <option value="@st.Id" data-type-id="@st.ParentId" selected="selected">@st.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@st.Id" data-type-id="@st.ParentId">@st.Name</option>
                                        }
                                    }
                                </select>
                                <div class="invalid-feedback">Choose a sub-type: it is required to receive goods.</div>
                                <div class="form-text">The source sets the type only; choose the sub-type. Add missing sub-types under Asset Categories first.</div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 mb-2 small">No classification on the purchase order line, the requisition or the supplier catalog. Choose it here (override).</div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <select class="form-select am-po-type" name="Lines[@i].OverrideAssetTypeId">
                                        <option value="">-- Asset type --</option>
                                        @foreach (var grp in typeOptions.GroupBy(t => t.GroupName ?? "Other"))
                                        {
                                            <optgroup label="@grp.Key">
                                                @foreach (var t in grp)
                                                {
                                                    if (line.OverrideAssetTypeId == t.Id)
                                                    {
                                                        <option value="@t.Id" selected="selected">@t.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@t.Id">@t.Name</option>
                                                    }
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select class="form-select am-po-subtype" name="Lines[@i].OverrideAssetSubTypeId" required="required" data-am-subtype-required="true" aria-label="Sub-type (required)">
                                        <option value="">-- Sub-type (required) --</option>
                                        @foreach (var st in subTypeOptions)
                                        {
                                            if (line.OverrideAssetSubTypeId == st.Id)
                                            {
                                                <option value="@st.Id" data-type-id="@st.ParentId" selected="selected">@st.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@st.Id" data-type-id="@st.ParentId">@st.Name</option>
                                            }
                                        }
                                    </select>
                                    <div class="invalid-feedback">Choose a sub-type: it is required to receive goods.</div>
                                    <div class="form-text am-subtype-none d-none">This asset type has no sub-types defined; it will be received without one.</div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Qty received</label>
                        <input type="number" class="form-control am-receive-qty" name="Lines[@i].QuantityReceived" min="0" max="@line.Outstanding" step="1" value="@line.QuantityReceived" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Condition</label>
                        <select class="form-select" name="Lines[@i].Condition">
                            @foreach (var name in conditionNames)
                            {
                                var text = name.Replace("RepairNeeded", "Repair Needed").Replace("BeyondRepair", "Beyond Repair");
                                if (string.Equals(line.Condition, name, System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@name" selected="selected">@text</option>
                                }
                                else
                                {
                                    <option value="@name">@text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label">Destination</label>
                        <div class="input-group">
                            <select class="form-select am-dest-kind" name="Lines[@i].DestinationKind" style="max-width:220px">
                                <option value="@ReceiveOrderLineVm.DestinationStore" @(isDepartment ? "" : "selected")>Store (company custody)</option>
                                <option value="@ReceiveOrderLineVm.DestinationDepartment" @(isDepartment ? "selected" : "")>Department / room</option>
                            </select>
                            <select class="form-select am-dest-department" name="Lines[@i].DestinationDepartmentId" @(isDepartment ? "" : "disabled")>
                                <option value="">-- Department / room --</option>
                                @foreach (var item in departmentItems)
                                {
                                    if (line.DestinationDepartmentId.HasValue && item.Value == line.DestinationDepartmentId.Value.ToString())
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-text">Units are created In Store with no custodian. Assign them to people afterwards from the purchase details.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Serial numbers <span class="text-muted small">(optional; paste one per line)</span></label>
                        <textarea class="form-control font-monospace am-serials" name="Lines[@i].SerialNumbersText" rows="3" placeholder="One serial per unit">@line.SerialNumbersText</textarea>
                        <div class="form-text am-serial-count"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Asset tags</label>
                        <select class="form-select mb-2 am-tag-mode" name="Lines[@i].TagMode">
                            <option value="@ReceiveOrderLineVm.TagModeGenerate" @(enterTags ? "" : "selected")>Generate tags (standard tag numbers)</option>
                            <option value="@ReceiveOrderLineVm.TagModeEnter" @(enterTags ? "selected" : "")>Enter / paste tags</option>
                        </select>
                        <textarea class="form-control font-monospace am-tags" name="Lines[@i].AssetTagsText" rows="3" placeholder="One tag per unit" @(enterTags ? "" : "disabled")>@line.AssetTagsText</textarea>
                        <div class="form-text am-tag-count"></div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card card-kpi mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3">
                <label class="form-label">Received date</label>
                @Html.TextBoxFor(m => m.ReceivedDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-9">
                <label class="form-label">Notes (delivery note, GRN number, ...)</label>
                @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "2" })
            </div>
        </div>
    </div>
    <div class="mb-4">
        <button type="submit" class="btn btn-primary" id="receive-submit-btn">Receive &amp; create assets</button>
        <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
        <span class="small text-muted ms-2">Partial receipts are fine; you cannot receive more than is outstanding.</span>
    </div>
}

@section scripts {
    <script src="@Url.Content("~/Scripts/app/receive-order.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/app/receive-order.js")).Ticks"></script>
}
