@model AssetManagement.Application.ViewModels.AssetReceiveVm
@using AssetManagement.Domain.Enums
@{
    ViewBag.Title = "Receive Asset";
    var detail = ViewBag.ReceiveDetail as AssetManagement.Application.ViewModels.PurchaseReceiveDetailVm;
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Details", new { id = Model.PurchaseRecordId });
    var requiresSubType = detail != null && detail.RequiresSubTypeAssignment;
    var requiresTypeSelection = detail != null && detail.RequiresTypeSelection;
    var requiresCatalogConfirm = detail != null && detail.RequiresCatalogMatchConfirmation;
    var requisitionDepartmentName = detail != null ? detail.RequisitionDepartmentName : null;
    var hasRequisitionDepartment = detail != null && detail.RequisitionDepartmentId.HasValue && detail.RequisitionDepartmentId.Value > 0;
    var catalogConfirmBase = AssetManagement.Web.Helpers.TenantUrlHelper.TenantRouteUrl(
        Url, "Receive", "Purchases", new { id = Model.PurchaseRecordId });
    var catalogConfirmUrl = catalogConfirmBase
        + "?catalogConfirmed=true"
        + (string.IsNullOrEmpty(returnUrl) ? "" : "&returnUrl=" + Uri.EscapeDataString(returnUrl));
    var conditionOptions = ViewBag.ConditionOptions as SelectList;
    if (conditionOptions == null)
    {
        var conditionItems = Enum.GetNames(typeof(AssetCondition))
            .Select(name => new System.Web.Mvc.SelectListItem
            {
                Value = name,
                Text = name.Replace("RepairNeeded", "Repair Needed").Replace("BeyondRepair", "Beyond Repair")
            })
            .ToList();
        conditionOptions = new System.Web.Mvc.SelectList(conditionItems, "Value", "Text", Model.ConditionOnReceipt);
    }
}
@Html.Partial("_PageHeader", new AssetManagement.Web.ViewModels.PageHeaderViewModel
{
    Title = "Receive Asset",
    Subtitle = detail != null ? ("PO " + (detail.PurchaseOrderNumber ?? detail.PurchaseRecordId.ToString()) + " - " + detail.RemainingQuantity + " unit(s) remaining") : "Create new assets and link them to this purchase.",
    BackUrl = returnUrl,
    BackLabel = "Back to Purchase"
})
<div class="card card-kpi mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Receive", "Purchases", FormMethod.Post, new { id = "receive-form", data_am_receive_mode = "true" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.PurchaseRecordId)
            @* When type context is resolved, keep subtype as hidden; when unresolved, the selector binds AssetTypeId/AssetSubTypeId. *@
            if (!requiresTypeSelection)
            {
                @Html.HiddenFor(m => m.AssetSubTypeId)
            }
            @Html.HiddenFor(m => m.CatalogMatchConfirmed)
            <input type="hidden" id="ReceiveAssetTypeId" value="@(detail != null && detail.ContextAssetTypeId.HasValue ? detail.ContextAssetTypeId.Value.ToString() : "")" />
            <input type="hidden" id="ReceiveBrand" value="@(detail != null ? detail.ContextBrand : "")" />
            <input type="hidden" id="ReceiveModel" value="@(detail != null ? detail.ContextModel : "")" />
            <div class="row g-3">
                @{
                    var assetTypeOptions = ViewBag.AssetTypeOptions as System.Collections.Generic.IEnumerable<AssetManagement.Web.ViewModels.AssetTypeLookupVm>
                        ?? System.Linq.Enumerable.Empty<AssetManagement.Web.ViewModels.AssetTypeLookupVm>();
                }
                @if (requiresTypeSelection)
                {
                    <div class="col-md-12" id="receive-type-selector">
                        <div class="alert alert-warning py-2">
                            This purchase has no linked requisition/catalog type. Select classification before receive â€” create-without-type is not allowed here.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="AssetTypeId">Asset type</label>
                                <select class="form-select" id="AssetTypeId" name="AssetTypeId">
                                    <option value="">-- Select asset type --</option>
                                    @foreach (var grp in assetTypeOptions.GroupBy(t => t.AssetCategoryId))
                                    {
                                        <optgroup label="Category #@grp.Key">
                                        @foreach (var t in grp.OrderBy(x => x.Name))
                                        {
                                            if (Model.AssetTypeId == t.Id)
                                            {
                                                <option value="@t.Id" selected="selected">@t.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@t.Id">@t.Name</option>
                                            }
                                        }
                                        </optgroup>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.AssetTypeId, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="AssetSubTypeId">Asset sub-type (optional)</label>
                                @Html.TextBoxFor(m => m.AssetSubTypeId, new { @class = "form-control", placeholder = "Sub-type id (optional)" })
                                <div class="form-text">Optional. You can refine sub-type on the asset after create once type is set.</div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @Html.HiddenFor(m => m.AssetTypeId)
                    <div class="col-md-12">
                        <label class="form-label">Asset sub-type</label>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div id="receive-subtype-display" class="form-control-plaintext @(string.IsNullOrWhiteSpace(detail != null ? detail.AssetSubTypeName : null) ? "text-muted" : "fw-medium")">
                                @if (detail != null && !string.IsNullOrWhiteSpace(detail.AssetSubTypeName))
                                {
                                    @detail.AssetSubTypeName
                                }
                                else if (requiresSubType)
                                {
                                    <text>Not assigned â€” classify after create on the asset</text>
                                }
                                else
                                {
                                    <text>Not assigned</text>
                                }
                            </div>
                        </div>
                    </div>
                }
                @* Custody Assign is post-receive only (Purchases Details "Assign these units"). Receive always keeps units In Store / company custody. *@
                <input type="hidden" name="ReceivePlacementChoice" value="CompanyCustody" />
                <div class="col-md-12">
                    <div class="form-text">
                        Received items are recorded under <strong>company custody</strong> (In Store, no custodian).
                        After create, you can optionally assign from Purchase Details, or keep them in store.
                        @if (hasRequisitionDepartment)
                        {
                            <span>Intended requisition destination: <strong>@requisitionDepartmentName</strong> (assign later if needed).</span>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Received Date</label>
                    @Html.TextBoxFor(m => m.ReceivedDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">Quantity Received</label>
                    @Html.TextBoxFor(m => m.QuantityReceived, new { @class = "form-control", type = "number", min = "1", max = detail != null ? detail.RemainingQuantity.ToString() : "1", id = "receive-quantity-input" })
                    @Html.ValidationMessageFor(m => m.QuantityReceived, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label class="form-label">Condition on Receipt</label>
                    @Html.DropDownListFor(
                        m => m.ConditionOnReceipt,
                        conditionOptions,
                        "-- Select condition --",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.ConditionOnReceipt, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-12">
                    <label class="form-label">New assets</label>
                    <p class="form-text mb-2">
                        Each unit received creates a new asset with an auto-generated tag and QR code.
                        Serial numbers are optional.
                        @if (detail != null && !string.IsNullOrWhiteSpace(detail.SuggestedAssetName))
                        {
                            <span>Name: <strong>@detail.SuggestedAssetName</strong>.</span>
                        }
                        @if (detail != null && !string.IsNullOrWhiteSpace(detail.AssetSubTypeName))
                        {
                            <span>Sub-type: <strong>@detail.AssetSubTypeName</strong>.</span>
                        }
                    </p>
                    <button type="button" class="btn btn-outline-primary" id="receive-open-serial-wizard">Enter serial numbers (optional)</button>
                    <div id="receive-serial-status" class="small mt-2"><span class="text-muted">Serial numbers are optional. Submit without them to create assets with tags only.</span></div>
                    <div id="receive-serial-hidden-fields"></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Notes</label>
                    @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "2" })
                </div>
            </div>
            @Html.ValidationSummary(true, "", new { @class = "text-danger mt-2" })
            <div class="mt-3">
                <button type="submit" class="btn btn-primary" id="receive-submit-btn">Create assets &amp; record receiving</button>
                <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
            </div>
        }
    </div>
</div>
@Html.Partial("_ReceiveSerialWizardModal")
@if (requiresCatalogConfirm)
{
    <div class="modal fade" id="catalogMatchConfirmModal" tabindex="-1" aria-hidden="true"
         data-am-confirm-url="@catalogConfirmUrl" data-am-auto-show="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm catalog match</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">This purchase looks like it matches an existing asset from the supplier catalog:</p>
                    <p class="mb-1"><strong>Asset:</strong> @detail.CatalogMatchLabel</p>
                    @if (!string.IsNullOrWhiteSpace(detail.CatalogMatchItemName))
                    {
                        <p class="mb-1"><strong>Catalog item:</strong> @detail.CatalogMatchItemName</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(detail.ItemDescription))
                    {
                        <p class="mb-0 text-muted">Requisition item: @detail.ItemDescription</p>
                    }
                    <p class="mt-3 mb-0">Do you want to use this match?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="catalog-match-decline">No, classify after create</button>
                    <button type="button" class="btn btn-primary" id="catalog-match-confirm">Yes, use this match</button>
                </div>
            </div>
        </div>
    </div>
}
<script src="@Url.Content("~/Scripts/app/receive-catalog-match.js")"></script>
<script src="@Url.Content("~/Scripts/app/receive-serial-wizard.js")"></script>
