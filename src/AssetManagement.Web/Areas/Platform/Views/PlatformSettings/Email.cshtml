@model AssetManagement.Web.ViewModels.PlatformEmailSettingsViewModel
@{
    ViewBag.Title = "Platform Email Settings";
    Layout = "~/Areas/Platform/Views/Shared/_PlatformLayout.cshtml";
}
<h3>Platform Email Settings</h3>
<p class="text-muted">Configure SMTP for MFA codes and password reset emails. Values here override Web.config when set.</p>

@if (Model.ConfigurationIsBlocking)
{
    <div class="alert alert-danger" role="alert">
        <strong>Action required:</strong> @Model.ConfigurationSummary
    </div>
}
else if (!Model.ConfigurationIsReady)
{
    <div class="alert alert-warning" role="alert">
        <strong>Not ready:</strong> @Model.ConfigurationSummary
    </div>
}
else
{
    <div class="alert alert-success" role="alert">
        @Model.ConfigurationSummary
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@using (Html.BeginForm("Email", "PlatformSettings", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row g-3">
        <div class="col-md-6">
            @Html.LabelFor(m => m.SmtpHost, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.SmtpHost, new { @class = "form-control" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.SmtpPort, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.SmtpPort, new { @class = "form-control", type = "number" })
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.SmtpEnableSsl, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.SmtpEnableSsl, new { @class = "form-check-label" })
            </div>
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.SmtpUser, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.SmtpUser, new { @class = "form-control" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.SmtpPassword, new { @class = "form-label" })
            @Html.PasswordFor(m => m.SmtpPassword, new { @class = "form-control", placeholder = "Leave blank to keep existing password" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.FromEmail, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.FromEmail, new { @class = "form-control" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.FromName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.FromName, new { @class = "form-control" })
        </div>
        <div class="col-md-12">
            @Html.LabelFor(m => m.ExternalBaseUrl, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.ExternalBaseUrl, new { @class = "form-control", placeholder = "https://assets.example.com" })
            <div class="form-text">Used to build password reset links in outbound email.</div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save settings</button>
    </div>
}

@using (Html.BeginForm("SendTestEmail", "PlatformSettings", FormMethod.Post, new { @class = "mt-4" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.SmtpHost)
    @Html.HiddenFor(m => m.SmtpPort)
    @Html.HiddenFor(m => m.SmtpUser)
    @Html.HiddenFor(m => m.SmtpEnableSsl)
    @Html.HiddenFor(m => m.FromEmail)
    @Html.HiddenFor(m => m.FromName)
    @Html.HiddenFor(m => m.ExternalBaseUrl)

    <h4 class="h6 mt-4">Send test email</h4>
    <p class="text-muted small">Uses saved settings. Save changes first, then send a test message.</p>
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            @Html.LabelFor(m => m.TestRecipientEmail, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.TestRecipientEmail, new { @class = "form-control", type = "email", placeholder = "admin@example.com" })
        </div>
        <div class="col-md-6">
            <button type="submit" class="btn btn-outline-secondary">Send test email</button>
        </div>
    </div>
}

<div class="alert alert-secondary mt-4 mb-0">
    <strong>Web.config fallback keys:</strong> SmtpHost, SmtpPort, SmtpUser, SmtpPassword, SmtpEnableSsl, FromEmail, FromName, ExternalBaseUrl
    <div class="mt-2 small">When <code>MfaAllowAnyCode=false</code> (Release/production), MFA and password reset are blocked until SMTP host and From email are configured. Startup logs a warning if settings are missing.</div>
</div>
