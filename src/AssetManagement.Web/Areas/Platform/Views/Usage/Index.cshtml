@model AssetManagement.Application.ViewModels.Platform.PlatformUsagePageVm
@using AssetManagement.Application.Helpers
@using AssetManagement.Web.Helpers
@{
    ViewBag.Title = "Usage";
    Layout = "~/Areas/Platform/Views/Shared/_PlatformLayout.cshtml";
    var eatLabel = KenyaTimeHelper.DisplayAbbreviation;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Platform Usage</h1>
        <p class="text-muted mb-0">
            Per-company activity and approximate storage share (shared SQL Express database).
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="text-muted small">
            @(Model.ServedFromCache ? "Cached" : "Fresh")
            &middot; @Model.QueryElapsedMs.ToString("0") ms
            &middot; @Html.FormatAuditTimestamp(Model.GeneratedAtUtc) @eatLabel
        </span>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "PlatformUsage", new { area = "Platform", refresh = true })">Refresh</a>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-kpi border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Database data file</div>
                <div class="fs-4 fw-semibold">@Model.DataFileMb.ToString("0.0") MB</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-kpi border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Database log file</div>
                <div class="fs-4 fw-semibold">@Model.LogFileMb.ToString("0.0") MB</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-kpi border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Companies</div>
                <div class="fs-4 fw-semibold">@(Model.Rows == null ? 0 : Model.Rows.Count)</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Company</th>
                        <th>Slug</th>
                        <th>Active</th>
                        <th class="text-end">Assets (active / total)</th>
                        <th class="text-end">Users (active / total)</th>
                        <th class="text-end">Logins 24h</th>
                        <th class="text-end">Logins 7d</th>
                        <th class="text-end">Logins 30d</th>
                        <th>Last activity (@eatLabel)</th>
                        <th class="text-end">Est. storage (MB)</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Rows != null)
                {
                    foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td><code>@row.Slug</code></td>
                            <td>@(row.IsActive ? "Yes" : "No")</td>
                            <td class="text-end">@row.AssetsActive / @row.AssetsTotal</td>
                            <td class="text-end">@row.UsersActive / @row.UsersTotal</td>
                            <td class="text-end">@row.LoginsLast24h</td>
                            <td class="text-end">@row.LoginsLast7d</td>
                            <td class="text-end">@row.LoginsLast30d</td>
                            <td>
                                @if (row.LastActivityUtc.HasValue)
                                {
                                    @Html.FormatAuditTimestamp(row.LastActivityUtc.Value)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">@row.EstimatedStorageMb.ToString("0.00")</td>
                        </tr>
                    }
                }
                </tbody>
                @if (Model.Totals != null)
                {
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td colspan="3">@Model.Totals.Name</td>
                            <td class="text-end">@Model.Totals.AssetsActive / @Model.Totals.AssetsTotal</td>
                            <td class="text-end">@Model.Totals.UsersActive / @Model.Totals.UsersTotal</td>
                            <td class="text-end">@Model.Totals.LoginsLast24h</td>
                            <td class="text-end">@Model.Totals.LoginsLast7d</td>
                            <td class="text-end">@Model.Totals.LoginsLast30d</td>
                            <td>
                                @if (Model.Totals.LastActivityUtc.HasValue)
                                {
                                    @Html.FormatAuditTimestamp(Model.Totals.LastActivityUtc.Value)
                                }
                            </td>
                            <td class="text-end">@Model.Totals.EstimatedStorageMb.ToString("0.00")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<p class="text-muted small mt-3 mb-1">
    Login counts use AuditLog action <code>@Model.LoginActionCounted</code> only, for rows with an organization, in the last 30 days (24h / 7d windows are subsets).
</p>
<p class="text-muted small mb-1">@Model.LoginActionsExcludedNote</p>
<p class="text-muted small mb-0">
    Estimated storage allocates the data-file size by each company&rsquo;s share of row counts across Asset, AuditLog, Users, Department, AssetAssignment, PurchaseRequest, LoginAttempts, and Notification. It is an estimate on one shared database. Results are cached for 5 minutes; Refresh bypasses the cache.
</p>