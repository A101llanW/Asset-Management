@page "{id:int}"
@model SmallShop.Web.Pages.Goods.AdjustModel
@{
    ViewData["Title"] = "Adjust stock";
    var good = Model.Good!;
}

<h1>Adjust @good.Name</h1>
<p class="help">On hand now: @ShopFormat.Qty(good.QuantityOnHand) @ShopLabels.Unit(good.Unit). A count, damage, or theft needs a reason. Opening stock sets the count.</p>

<form method="post" class="shop-form">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Kind" class="form-label">Kind</label>
        <select asp-for="Kind" class="form-select">
            <option value="Opening">Opening stock</option>
            <option value="Count">Count</option>
            <option value="Damage">Damage</option>
            <option value="Theft">Theft</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Quantity</label>
        <input asp-for="Quantity" class="form-control" step="0.001" min="0" />
        <div class="form-text">For a count or opening stock, this is the new quantity on hand. For damage or theft, this is how much left the shelf.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Reason" class="form-label">Reason</label>
        <input asp-for="Reason" class="form-control" maxlength="400" />
    </div>
    <button type="submit" class="btn btn-primary">Save adjustment</button>
    <a class="btn btn-link" asp-page="Details" asp-route-id="@good.Id">Cancel</a>
</form>
