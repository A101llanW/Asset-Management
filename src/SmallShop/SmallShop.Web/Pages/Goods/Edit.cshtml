@page "{id:int}"
@model SmallShop.Web.Pages.Goods.EditModel
@{
    ViewData["Title"] = "Edit good";
}

<h1>Edit @Model.Input.Name</h1>
<p class="help">Cost can also change when you receive a delivery and choose to update it.</p>

<form method="post" class="shop-form">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Unit" class="form-label">Unit</label>
        <select asp-for="Input.Unit" class="form-select">
            <option value="Piece">piece</option>
            <option value="Kg">kg</option>
            <option value="Litre">litre</option>
        </select>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.Cost" class="form-label">Cost</label>
            <input asp-for="Input.Cost" class="form-control" step="0.01" min="0" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.SellingPrice" class="form-label">Selling price</label>
            <input asp-for="Input.SellingPrice" class="form-control" step="0.01" min="0" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.LowStockThreshold" class="form-label">Low-stock level</label>
        <input asp-for="Input.LowStockThreshold" class="form-control" step="0.001" min="0" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-page="Details" asp-route-id="@Model.Input.Id">Cancel</a>
</form>
